# Cópialo como «.env» (en la misma carpeta) y cambia los dos valores.

# El usuario para entrar.
ARCHISIM_USUARIO=antonio

# La contraseña, cifrada (nunca la contraseña tal cual). Para obtenerla,
# en el NAS (Terminal o SSH):
#
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'tu-contraseña'
#
# y pega aquí lo que sale, entre comillas simples (empieza por $2a$).
ARCHISIM_CLAVE_CIFRADA='$2a$14$cambia.esto.por.lo.que.da.caddy.hash.password........'
