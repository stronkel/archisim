family "Ventana corredera"
  category window
  host wall
  version 2
  description "Ventana o balconera corredera de dos hojas, con marco"

include "piezas"

type_params
  section "Dimensiones"
    width  length = 1.80 range 0.10..20.00 label "Hueco de obra: ancho"
    height length = 1.30 range 0.10..20.00 label "Hueco de obra: alto"
  section "Marco"
    frame_width length = 0.06 range 0.001..2.00 label "Marco: anchura vista"
    frame_depth length = 0.07 range 0.001..2.00 label "Marco: fondo"
  section "Materiales"
    frame_material material = "Aluminio lacado" label "Marco"
    panel_material material = "Vidrio doble" label "Vidrio"

require 2 * frame_width < width and 2 * frame_width < height else "El marco no deja hueco para el vidrio"
require 3 * frame_width < width else "El marco y el montante no dejan hueco para el vidrio"

body
  use window_frame(width, height, frame_width, frame_depth, frame_material)
  use glazing(width, height, frame_width, frame_depth, 2, frame_material, panel_material)

# Marco cortado y las dos hojas en carriles distintos, solapadas en el
# centro. La hoja del carril exterior queda en la misma mitad del hueco sea
# cual sea el lado de apertura (en una corredera no cambia nada).
plan 1:50
  if sill_height > 0
    use sill_plan(width, frame_depth, wall_ext, wall_int)
  use frame_cut_plan(-width / 2, width / 2, frame_depth)
  let c0 = -width / 2 + frame_width
  let c1 = width / 2 - frame_width
  let es = if wall_ext > 0 then 1 else -1
  let q = frame_depth / 4
  let lap = frame_width / 2
  let k = if opens_to == "exterior" then -1 else 1
  polygon (k * c0, 0) (k * lap, 0) (k * lap, es * q) (k * c0, es * q) pen thin filled
  polygon (-k * lap, -es * q) (k * c1, -es * q) (k * c1, 0) (-k * lap, 0) pen thin filled

plan 1:100
  use frame_cut_plan(-width / 2, width / 2, frame_depth)
  line (-width / 2 + frame_width, 0) to (width / 2 - frame_width, 0) pen thin

outputs
  opening_width = width
  opening_height = height
  frame_width = frame_width
  frame_depth = frame_depth
  frame_material = frame_material
  panel_material = panel_material
  operation = "sliding"

ifc
  panel_count = 2
  panel_1 = "SLIDINGHORIZONTAL"
  panel_2 = "SLIDINGHORIZONTAL"
