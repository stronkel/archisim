family "Ventana practicable"
  category window
  host wall
  version 9
  description "Ventana de 1 a 4 hojas con montantes; cada hoja fija, practicable, oscilobatiente, abatible, proyectante, basculante o pivotante; con persiana enrollable y capialzado, tarja fija, premarco y vierteaguas si se quieren"

include "piezas"

type_params
  section "Dimensiones"
    width  length = 1.20 range 0.10..20.00 label "Hueco de obra: ancho"
    height length = 1.20 range 0.10..20.00 label "Hueco de obra: alto"
  section "Hojas"
    leaves integer = 2 range 1..4 label "Nº de hojas"
    leaf_1 choice("fija", "practicable", "oscilobatiente", "abatible", "proyectante", "basculante", "pivotante") = "practicable" label "Hoja 1"
    leaf_2 choice("fija", "practicable", "oscilobatiente", "abatible", "proyectante", "basculante", "pivotante") = "practicable" visible_if leaves >= 2 label "Hoja 2"
    leaf_3 choice("fija", "practicable", "oscilobatiente", "abatible", "proyectante", "basculante", "pivotante") = "practicable" visible_if leaves >= 3 label "Hoja 3"
    leaf_4 choice("fija", "practicable", "oscilobatiente", "abatible", "proyectante", "basculante", "pivotante") = "practicable" visible_if leaves >= 4 label "Hoja 4"
  section "Marco"
    frame_width length = 0.06 range 0.001..2.00 label "Marco: anchura vista"
    frame_depth length = 0.07 range 0.001..2.00 label "Marco: fondo"
  section "Persiana"
    shutter bool = no label "Persiana enrollable con capialzado"
    box_height length = 0.25 range 0.10..0.60 visible_if shutter label "Capialzado: alto"
    shutter_down integer = 0 range 0..100 visible_if shutter label "Persiana: bajada (%)"
  section "Tarja"
    transom bool = no label "Tarja fija sobre las hojas"
    transom_height length = 0.40 range 0.10..2.00 visible_if transom label "Tarja: alto"
  section "Premarco y vierteaguas"
    subframe bool = no label "Premarco"
    subframe_width length = 0.03 range 0.005..0.20 visible_if subframe label "Premarco: anchura"
    sill bool = no label "Vierteaguas"
    sill_depth length = 0.20 range 0.02..1.00 visible_if sill label "Vierteaguas: vuelo desde el marco"
  section "Materiales"
    frame_material material = "Aluminio lacado" label "Marco"
    panel_material material = "Vidrio doble" label "Vidrio"
    subframe_material material = "Acero galvanizado" visible_if subframe label "Premarco"
    sill_material material = "Piedra natural" visible_if sill label "Vierteaguas"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Contemporáneo" label "Modelo 3D"
    hardware_material material = "Acero inoxidable" label "Herrajes"
  section "A tu gusto"
    window_profile choice("Como la colección", "Aluminio recto", "Aluminio redondeado", "PVC", "Madera", "Madera con moldura", "Acero fino") = "Como la colección" label "Perfil"
    glazing_bars choice("Como la colección", "Sin cuarterones", "Cuadrícula", "Cuadrícula fina", "Horizontales", "Verticales", "Solo arriba") = "Como la colección" label "Cuarterones"
    window_handle choice("Como la colección", "Manilla moderna", "Manilla de latón", "Cremona vista", "Falleba de forja", "Sin manilla") = "Como la colección" label "Manilla"
  section "Por fuera"
    outside_shutters choice("Sin contraventanas", "Mallorquinas", "De tablas", "De cuarterones") = "Sin contraventanas" label "Contraventanas"
    shutters_open bool = yes visible_if outside_shutters != "Sin contraventanas" label "Contraventanas abiertas"
    shutters_material material = "Madera de pino" visible_if outside_shutters != "Sin contraventanas" label "Contraventanas: material"
    grille choice("Sin reja", "Barrotes", "Barrotes y pletinas", "Cuadrícula", "Forja con volutas") = "Sin reja" label "Reja"
    grille_box bool = no visible_if grille != "Sin reja" label "Reja de cajón"
    grille_depth length = 0.18 range 0.08..0.60 visible_if grille != "Sin reja" and grille_box label "Reja: vuelo"
    grille_material material = "Hierro forjado" visible_if grille != "Sin reja" label "Reja: material"
  section "Representación"
    swing_in_plan bool = no label "Giro de las hojas en planta"
    swing_line linestyle = "dashed" visible_if swing_in_plan label "Giro en planta: tipo de línea"
    opening_lines_in_views bool = no label "Líneas de apertura en alzados y secciones del modelo"
    opening_lines linestyle = "dashed" label "Líneas de apertura: tipo de línea"

instance_params
  section "Esquina"
    corner choice("no", "izquierda", "derecha") = "no" label "Ventana en esquina (lado sin jamba)"

# Con premarco, la ventana va dentro de él.
let s = if subframe then subframe_width else 0
let w = width - 2 * s
# En esquina, sin jamba de ese lado: el vidrio llega hasta el encuentro con
# la ventana del otro muro.
let fl = if corner == "izquierda" then 0 else frame_width
let fr = if corner == "derecha" then 0 else frame_width
let gc0 = -w / 2 + fl
let gc1 = w / 2 - fr
let gclear = (gc1 - gc0 - (leaves - 1) * frame_width) / leaves

require 2 * frame_width < w and 2 * frame_width < height - 2 * s else "El marco no deja hueco para el vidrio"
require (leaves + 1) * frame_width < w else "El marco y los montantes no dejan hueco para el vidrio"
require not shutter or box_height + 2 * frame_width < height - 2 * s else "El capialzado no deja sitio a la ventana"

# Las hojas de la mitad izquierda giran en su jamba izquierda y las de la
# derecha en la derecha (se encuentran en el centro); una hoja sola, o la
# del centro si son tres, gira según la mano de cada ventana colocada.
# Para el IFC (que es del tipo) se toma la izquierda.
let side_1 = "LEFT"
let side_2 = if leaves >= 3 then "LEFT" else "RIGHT"
let side_3 = "RIGHT"
let side_4 = "RIGHT"

# Con persiana, el capialzado ocupa lo alto del hueco, sobre la ventana.
let window_height = if shutter then height - box_height else height
# La ventana, de «z0» a «z1»; las hojas, hasta «zl» (con tarja, debajo de
# ella).
let z0 = s
let z1 = if shutter then window_height else height - s
let zl = if transom then z1 - transom_height else z1

require not transom or zl - z0 > 2 * frame_width + 0.20 else "La tarja no deja sitio a las hojas"

body
  if subframe
    use subframe(width, height, s, frame_depth, subframe_material, 1)
  # En 3D, el marco, los montantes y las hojas los hace ArchiSim con el
  # perfil y los herrajes de la colección (generator props:window).
  if not detailed
    if fl > 0
      use block(-w / 2, gc0, frame_depth, z0, z1, frame_material)
    if fr > 0
      use block(gc1, w / 2, frame_depth, z0, z1, frame_material)
    use block(gc0, gc1, frame_depth, z0, z0 + frame_width, frame_material)
    use block(gc0, gc1, frame_depth, z1 - frame_width, z1, frame_material)
    repeat i in 0..leaves
      let a = gc0 + i * (gclear + frame_width)
      if i > 0
        use block(a - frame_width, a, frame_depth, z0 + frame_width, zl - frame_width, frame_material)
      use block(a, a + gclear, min(0.024, frame_depth), z0 + frame_width, zl - frame_width, panel_material)
  if transom
    use transom(-w / 2 + frame_width, w / 2 - frame_width, zl, z1 - frame_width, frame_width, frame_depth, frame_material, panel_material)
  if shutter
    use block(-width / 2, width / 2, frame_depth, window_height, height, frame_material)
  if sill
    # «y» apunta al lado al que abren las hojas; fuera es +y si abren hacia fuera.
    let out = if opens_to == "exterior" then 1 else -1
    use window_sill(width, frame_depth, sill_depth, out, sill_material)

# Marco cortado, línea del vidrio, montantes y el giro de cada hoja que se
# abre hacia el lado (practicable u oscilobatiente). Las fijas, abatibles,
# proyectantes y basculantes no giran en planta: se verán en alzado. La
# persiana, por fuera del marco, en discontinua (está enrollada arriba).
plan 1:50
  if sill_height > 0
    use sill_plan(width, frame_depth, wall_ext, wall_int)
  let ew = if wall_ext > 0 then 1 else -1
  if grille != "Sin reja"
    let gx = width / 2 + 0.06
    if grille_box
      line (-gx, wall_ext) to (-gx, wall_ext + ew * grille_depth) pen thin
      line (-gx, wall_ext + ew * grille_depth) to (gx, wall_ext + ew * grille_depth) pen thin
      line (gx, wall_ext + ew * grille_depth) to (gx, wall_ext) pen thin
    else
      line (-gx, wall_ext + ew * 0.03) to (gx, wall_ext + ew * 0.03) pen thin
  if outside_shutters != "Sin contraventanas"
    let sy = wall_ext + ew * 0.02
    if shutters_open
      line (-width, sy) to (-width / 2, sy) pen thin
      line (width / 2, sy) to (width, sy) pen thin
    else
      line (-width / 2, sy) to (width / 2, sy) pen thin
  if shutter
    let es = if wall_ext > 0 then 1 else -1
    line (-width / 2, es * (frame_depth / 2 + 0.02)) to (width / 2, es * (frame_depth / 2 + 0.02)) pen thin dashed
  if subframe
    use frame_cut_plan(-width / 2, -w / 2, frame_depth)
    use frame_cut_plan(w / 2, width / 2, frame_depth)
  use frame_cut_plan(-w / 2, w / 2, frame_depth)
  let f = frame_width
  let c0 = gc0
  let c1 = gc1
  let clear = gclear
  line (c0, 0) to (c1, 0) pen thin
  repeat i in 1..leaves
    let m = c0 + i * (clear + f) - f / 2
    line (m, -frame_depth / 2) to (m, frame_depth / 2) pen frame
  repeat i in 0..leaves
    let op = if i == 0 then leaf_1 else if i == 1 then leaf_2 else if i == 2 then leaf_3 else leaf_4
    if swing_in_plan and (op == "practicable" or op == "oscilobatiente")
      let a = if i == 0 then c0 else c0 + i * (clear + f) - f / 2
      let b = if i == leaves - 1 then c1 else c0 + (i + 1) * (clear + f) - f / 2
      let left = if 2 * i + 1 == leaves then hand == "left" else 2 * i + 1 < leaves
      if left
        use window_leaf_plan(a, 1, b - a, frame_depth, swing_line)
      else
        use window_leaf_plan(b, -1, b - a, frame_depth, swing_line)
    if swing_in_plan and op == "pivotante"
      let a = if i == 0 then c0 else c0 + i * (clear + f) - f / 2
      let b = if i == leaves - 1 then c1 else c0 + (i + 1) * (clear + f) - f / 2
      use pivot_leaf_plan(a, b, frame_depth, swing_line)

# A 1:20, como a 1:50 con el perfil de cada hoja y el doble vidrio.
plan 1:20
  if sill_height > 0
    use sill_plan(width, frame_depth, wall_ext, wall_int)
  let ew = if wall_ext > 0 then 1 else -1
  if grille != "Sin reja"
    let gx = width / 2 + 0.06
    if grille_box
      line (-gx, wall_ext) to (-gx, wall_ext + ew * grille_depth) pen thin
      line (-gx, wall_ext + ew * grille_depth) to (gx, wall_ext + ew * grille_depth) pen thin
      line (gx, wall_ext + ew * grille_depth) to (gx, wall_ext) pen thin
    else
      line (-gx, wall_ext + ew * 0.03) to (gx, wall_ext + ew * 0.03) pen thin
  if outside_shutters != "Sin contraventanas"
    let sy = wall_ext + ew * 0.02
    if shutters_open
      line (-width, sy) to (-width / 2, sy) pen thin
      line (width / 2, sy) to (width, sy) pen thin
    else
      line (-width / 2, sy) to (width / 2, sy) pen thin
  if shutter
    let es = if wall_ext > 0 then 1 else -1
    line (-width / 2, es * (frame_depth / 2 + 0.02)) to (width / 2, es * (frame_depth / 2 + 0.02)) pen thin dashed
  if subframe
    use frame_cut_plan(-width / 2, -w / 2, frame_depth)
    use frame_cut_plan(w / 2, width / 2, frame_depth)
  let f = frame_width
  let c0 = gc0
  let c1 = gc1
  if fl > 0
    use frame_cut_plan(-w / 2, c0, frame_depth)
  if fr > 0
    use frame_cut_plan(c1, w / 2, frame_depth)
  let clear = gclear
  repeat i in 1..leaves
    let m = c0 + i * (clear + f) - f
    use frame_cut_plan(m, m + f, frame_depth)
  repeat i in 0..leaves
    let a = c0 + i * (clear + f)
    use sash_detail(a, a + clear, frame_depth)
    use glass_detail(a + 0.01, a + clear - 0.01)
  repeat i in 0..leaves
    let op = if i == 0 then leaf_1 else if i == 1 then leaf_2 else if i == 2 then leaf_3 else leaf_4
    let a = if i == 0 then c0 else c0 + i * (clear + f) - f / 2
    let b = if i == leaves - 1 then c1 else c0 + (i + 1) * (clear + f) - f / 2
    if swing_in_plan and (op == "practicable" or op == "oscilobatiente")
      let left = if 2 * i + 1 == leaves then hand == "left" else 2 * i + 1 < leaves
      if left
        use window_leaf_plan(a, 1, b - a, frame_depth, swing_line)
      else
        use window_leaf_plan(b, -1, b - a, frame_depth, swing_line)
    if swing_in_plan and op == "pivotante"
      use pivot_leaf_plan(a, b, frame_depth, swing_line)

# En alzado, las líneas de apertura de cada hoja, con el lado de sus
# bisagras como en planta.
elevation
  let f = frame_width
  let c0 = gc0
  let clear = gclear
  repeat i in 0..leaves
    let op = if i == 0 then leaf_1 else if i == 1 then leaf_2 else if i == 2 then leaf_3 else leaf_4
    let a = c0 + i * (clear + f)
    let left = if 2 * i + 1 == leaves then hand == "left" else 2 * i + 1 < leaves
    use leaf_elevation(op, a, a + clear, z0 + f, zl - f, left, opening_lines)

# A 1:100, el marco y el vidrio.
plan 1:100
  if shutter
    let es = if wall_ext > 0 then 1 else -1
    line (-width / 2, es * (frame_depth / 2 + 0.03)) to (width / 2, es * (frame_depth / 2 + 0.03)) pen thin dashed
  use frame_cut_plan(-width / 2, width / 2, frame_depth)
  line (-width / 2 + frame_width, 0) to (width / 2 - frame_width, 0) pen thin

outputs
  generator = "props:window"
  w_fw = frame_width
  w_gc0 = gc0
  w_gc1 = gc1
  w_w = w
  w_z0 = z0
  w_z1 = z1
  w_zl = zl
  w_left = if fl > 0 then 1 else 0
  w_right = if fr > 0 then 1 else 0
  w_outside = if opens_to == "exterior" then 1 else -1
  w_hand_left = if hand == "left" then 1 else 0
  w_width = width
  w_height = height
  w_top = window_height
  opening_width = width
  opening_height = height
  frame_width = frame_width + s
  frame_depth = frame_depth
  frame_material = frame_material
  panel_material = panel_material
  operation = if leaves == 1 and leaf_1 == "fija" then "fixed" else if leaves == 1 then "single_casement" else "double_casement"

ifc
  panel_count = leaves
  panel_1 = if leaf_1 == "fija" then "FIXEDCASEMENT" else if leaf_1 == "practicable" then "SIDEHUNG" + side_1 + "HAND" else if leaf_1 == "oscilobatiente" then "TILTANDTURN" + side_1 + "HAND" else if leaf_1 == "abatible" then "BOTTOMHUNG" else if leaf_1 == "proyectante" then "TOPHUNG" else if leaf_1 == "pivotante" then "PIVOTVERTICAL" else "PIVOTHORIZONTAL"
  panel_2 = if leaf_2 == "fija" then "FIXEDCASEMENT" else if leaf_2 == "practicable" then "SIDEHUNG" + side_2 + "HAND" else if leaf_2 == "oscilobatiente" then "TILTANDTURN" + side_2 + "HAND" else if leaf_2 == "abatible" then "BOTTOMHUNG" else if leaf_2 == "proyectante" then "TOPHUNG" else if leaf_2 == "pivotante" then "PIVOTVERTICAL" else "PIVOTHORIZONTAL"
  panel_3 = if leaf_3 == "fija" then "FIXEDCASEMENT" else if leaf_3 == "practicable" then "SIDEHUNG" + side_3 + "HAND" else if leaf_3 == "oscilobatiente" then "TILTANDTURN" + side_3 + "HAND" else if leaf_3 == "abatible" then "BOTTOMHUNG" else if leaf_3 == "proyectante" then "TOPHUNG" else if leaf_3 == "pivotante" then "PIVOTVERTICAL" else "PIVOTHORIZONTAL"
  panel_4 = if leaf_4 == "fija" then "FIXEDCASEMENT" else if leaf_4 == "practicable" then "SIDEHUNG" + side_4 + "HAND" else if leaf_4 == "oscilobatiente" then "TILTANDTURN" + side_4 + "HAND" else if leaf_4 == "abatible" then "BOTTOMHUNG" else if leaf_4 == "proyectante" then "TOPHUNG" else if leaf_4 == "pivotante" then "PIVOTVERTICAL" else "PIVOTHORIZONTAL"
