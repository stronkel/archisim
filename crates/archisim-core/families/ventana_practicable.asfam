family "Ventana practicable"
  category window
  host wall
  version 2
  description "Ventana de 1 a 4 hojas con montantes; cada hoja fija, practicable, oscilobatiente, abatible, proyectante o basculante"

include "piezas"

type_params
  section "Dimensiones"
    width  length = 1.20 range 0.10..20.00 label "Hueco de obra: ancho"
    height length = 1.20 range 0.10..20.00 label "Hueco de obra: alto"
  section "Hojas"
    leaves integer = 2 range 1..4 label "Nº de hojas"
    leaf_1 choice("fija", "practicable", "oscilobatiente", "abatible", "proyectante", "basculante") = "practicable" label "Hoja 1"
    leaf_2 choice("fija", "practicable", "oscilobatiente", "abatible", "proyectante", "basculante") = "practicable" visible_if leaves >= 2 label "Hoja 2"
    leaf_3 choice("fija", "practicable", "oscilobatiente", "abatible", "proyectante", "basculante") = "practicable" visible_if leaves >= 3 label "Hoja 3"
    leaf_4 choice("fija", "practicable", "oscilobatiente", "abatible", "proyectante", "basculante") = "practicable" visible_if leaves >= 4 label "Hoja 4"
  section "Marco"
    frame_width length = 0.06 range 0.001..2.00 label "Marco: anchura vista"
    frame_depth length = 0.07 range 0.001..2.00 label "Marco: fondo"
  section "Materiales"
    frame_material material = "Aluminio lacado" label "Marco"
    panel_material material = "Vidrio doble" label "Vidrio"

require 2 * frame_width < width and 2 * frame_width < height else "El marco no deja hueco para el vidrio"
require (leaves + 1) * frame_width < width else "El marco y los montantes no dejan hueco para el vidrio"

# Las hojas de la mitad izquierda giran en su jamba izquierda y las de la
# derecha en la derecha (se encuentran en el centro); una hoja sola, o la
# del centro si son tres, gira según la mano de cada ventana colocada.
# Para el IFC (que es del tipo) se toma la izquierda.
let side_1 = "LEFT"
let side_2 = if leaves >= 3 then "LEFT" else "RIGHT"
let side_3 = "RIGHT"
let side_4 = "RIGHT"

body
  use window_frame(width, height, frame_width, frame_depth, frame_material)
  use glazing(width, height, frame_width, frame_depth, leaves, frame_material, panel_material)

# Marco cortado, línea del vidrio, montantes y el giro de cada hoja que se
# abre hacia el lado (practicable u oscilobatiente). Las fijas, abatibles,
# proyectantes y basculantes no giran en planta: se verán en alzado.
plan 1:50
  if sill_height > 0
    use sill_plan(width, frame_depth, wall_ext, wall_int)
  use frame_cut_plan(-width / 2, width / 2, frame_depth)
  let f = frame_width
  let c0 = -width / 2 + f
  let c1 = width / 2 - f
  let clear = (width - 2 * f - (leaves - 1) * f) / leaves
  line (c0, 0) to (c1, 0) pen thin
  repeat i in 1..leaves
    let m = c0 + i * (clear + f) - f / 2
    line (m, -frame_depth / 2) to (m, frame_depth / 2) pen frame
  repeat i in 0..leaves
    let op = if i == 0 then leaf_1 else if i == 1 then leaf_2 else if i == 2 then leaf_3 else leaf_4
    if op == "practicable" or op == "oscilobatiente"
      let a = if i == 0 then c0 else c0 + i * (clear + f) - f / 2
      let b = if i == leaves - 1 then c1 else c0 + (i + 1) * (clear + f) - f / 2
      let left = if 2 * i + 1 == leaves then hand == "left" else 2 * i + 1 < leaves
      if left
        use window_leaf_plan(a, 1, b - a, frame_depth)
      else
        use window_leaf_plan(b, -1, b - a, frame_depth)

# A 1:100, el marco y el vidrio.
plan 1:100
  use frame_cut_plan(-width / 2, width / 2, frame_depth)
  line (-width / 2 + frame_width, 0) to (width / 2 - frame_width, 0) pen thin

outputs
  opening_width = width
  opening_height = height
  frame_width = frame_width
  frame_depth = frame_depth
  frame_material = frame_material
  panel_material = panel_material
  operation = if leaves == 1 and leaf_1 == "fija" then "fixed" else if leaves == 1 then "single_casement" else "double_casement"

ifc
  panel_count = leaves
  panel_1 = if leaf_1 == "fija" then "FIXEDCASEMENT" else if leaf_1 == "practicable" then "SIDEHUNG" + side_1 + "HAND" else if leaf_1 == "oscilobatiente" then "TILTANDTURN" + side_1 + "HAND" else if leaf_1 == "abatible" then "BOTTOMHUNG" else if leaf_1 == "proyectante" then "TOPHUNG" else "PIVOTHORIZONTAL"
  panel_2 = if leaf_2 == "fija" then "FIXEDCASEMENT" else if leaf_2 == "practicable" then "SIDEHUNG" + side_2 + "HAND" else if leaf_2 == "oscilobatiente" then "TILTANDTURN" + side_2 + "HAND" else if leaf_2 == "abatible" then "BOTTOMHUNG" else if leaf_2 == "proyectante" then "TOPHUNG" else "PIVOTHORIZONTAL"
  panel_3 = if leaf_3 == "fija" then "FIXEDCASEMENT" else if leaf_3 == "practicable" then "SIDEHUNG" + side_3 + "HAND" else if leaf_3 == "oscilobatiente" then "TILTANDTURN" + side_3 + "HAND" else if leaf_3 == "abatible" then "BOTTOMHUNG" else if leaf_3 == "proyectante" then "TOPHUNG" else "PIVOTHORIZONTAL"
  panel_4 = if leaf_4 == "fija" then "FIXEDCASEMENT" else if leaf_4 == "practicable" then "SIDEHUNG" + side_4 + "HAND" else if leaf_4 == "oscilobatiente" then "TILTANDTURN" + side_4 + "HAND" else if leaf_4 == "abatible" then "BOTTOMHUNG" else if leaf_4 == "proyectante" then "TOPHUNG" else "PIVOTHORIZONTAL"
