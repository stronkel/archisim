# Piezas comunes de puertas y ventanas de ArchiSim.
#
# Ejes de las familias alojadas en muro (metros):
#   x  a lo largo del muro, desde el centro del hueco de obra;
#   y  a través del muro, desde el plano medio del marco, positivo hacia el
#      lado al que abren las hojas;
#   z  hacia arriba, desde el antepecho (el suelo, en las puertas).

# Pieza prismática centrada en el plano medio del marco, de fondo «depth».
component block(xa, xb, depth, za, zb, mat)
  box (xa, -depth / 2, za) to (xb, depth / 2, zb) material mat

# Cerco de puerta: dos jambas y el cabecero, abierto en el suelo.
component door_lining(w, h, f, d, mat)
  use block(-w / 2, -w / 2 + f, d, 0, h, mat)
  use block(w / 2 - f, w / 2, d, 0, h, mat)
  use block(-w / 2 + f, w / 2 - f, d, h - f, h, mat)

# Hoja ciega de puerta, de «xa» a «xb», del suelo al cabecero; 4 cm de
# grueso como mucho (no más que el cerco).
component door_leaf(xa, xb, h, f, d, mat)
  use block(xa, xb, min(0.04, d), 0, h - f, mat)

# Marco de ventana: dos jambas, travesaño inferior y superior.
component window_frame(w, h, f, d, mat)
  use block(-w / 2, -w / 2 + f, d, 0, h, mat)
  use block(w / 2 - f, w / 2, d, 0, h, mat)
  use block(-w / 2 + f, w / 2 - f, d, 0, f, mat)
  use block(-w / 2 + f, w / 2 - f, d, h - f, h, mat)

# «n» paños de vidrio iguales dentro del marco, separados por montantes del
# ancho del marco; vidrio de 24 mm como mucho (no más que el marco).
component glazing(w, h, f, d, n, frame_mat, glass_mat)
  let clear = (w - 2 * f - (n - 1) * f) / n
  repeat i in 0..n
    let a = -w / 2 + f + i * (clear + f)
    if i > 0
      use block(a - f, a, d, f, h - f, frame_mat)
    use block(a, a + clear, min(0.024, d), f, h - f, glass_mat)

# Marco de ventana de «z0» a «z1» (con premarco, z0 es su ancho).
component window_frame_z(w, z0, z1, f, d, mat)
  use block(-w / 2, -w / 2 + f, d, z0, z1, mat)
  use block(w / 2 - f, w / 2, d, z0, z1, mat)
  use block(-w / 2 + f, w / 2 - f, d, z0, z0 + f, mat)
  use block(-w / 2 + f, w / 2 - f, d, z1 - f, z1, mat)

# «n» paños de vidrio de «z0» a «z1» (sin contar el marco), con montantes.
component glazing_z(w, z0, z1, f, d, n, frame_mat, glass_mat)
  let clear = (w - 2 * f - (n - 1) * f) / n
  repeat i in 0..n
    let a = -w / 2 + f + i * (clear + f)
    if i > 0
      use block(a - f, a, d, z0, z1, frame_mat)
    use block(a, a + clear, min(0.024, d), z0, z1, glass_mat)

# Premarco en el borde del hueco de obra: jambas y cabecero, y el travesaño
# inferior si «bottom» es 1 (ventanas).
component subframe(w, h, s, d, mat, bottom)
  use block(-w / 2, -w / 2 + s, d, 0, h, mat)
  use block(w / 2 - s, w / 2, d, 0, h, mat)
  use block(-w / 2 + s, w / 2 - s, d, h - s, h, mat)
  if bottom > 0
    use block(-w / 2 + s, w / 2 - s, d, 0, s, mat)

# Tarja: travesaño a «zb» y vidrio fijo encima, hasta «zt» (dentro del
# marco o cerco), entre «xa» y «xb».
component transom(xa, xb, zb, zt, f, d, frame_mat, glass_mat)
  use block(xa, xb, d, zb - f, zb, frame_mat)
  use block(xa, xb, min(0.024, d), zb, zt, glass_mat)

# Vierteaguas bajo la ventana, por fuera: del marco hacia el exterior
# («es», 1 o -1, el sentido de «y» hacia fuera), «depth» de vuelo y 3 cm de
# grueso, 2 cm más ancho que el hueco a cada lado.
component window_sill(w, d, depth, es, mat)
  let y0 = es * d / 2
  let y1 = es * (d / 2 + depth)
  box (-w / 2 - 0.02, min(y0, y1), -0.03) to (w / 2 + 0.02, max(y0, y1), 0) material mat

# ---- Planta ---------------------------------------------------------------
# En planta, «y» es el eje a través del muro hacia el lado al que abren las
# hojas; wall_ext y wall_int (los pone el programa) son las caras del muro,
# medidas desde el plano medio del marco.

# Jamba o marco cortado: rectángulo del fondo del marco, que tapa el muro.
component frame_cut_plan(xa, xb, d)
  polygon (xa, -d / 2) (xb, -d / 2) (xb, d / 2) (xa, d / 2) pen frame filled

# Hoja de puerta abierta a 90° (con su grueso) y su giro. «hx» es la
# bisagra; «dir», 1 si la hoja cierra hacia +x y -1 si hacia -x; «st», el
# tipo de línea del giro.
component door_leaf_plan(hx, dir, lw, d, st)
  let lt = min(0.04, lw / 4)
  polygon (hx, d / 2) (hx, d / 2 + lw) (hx + dir * lt, d / 2 + lw) (hx + dir * lt, d / 2) pen frame filled
  arc center (hx, d / 2) from (hx, d / 2 + lw) to (hx + dir * lw, d / 2) pen thin style st

# Hoja de puerta a 1:100: una línea y el giro.
component door_leaf_plan_simple(hx, dir, lw, d, st)
  line (hx, d / 2) to (hx, d / 2 + lw) pen frame
  arc center (hx, d / 2) from (hx, d / 2 + lw) to (hx + dir * lw, d / 2) pen thin style st

# Hoja de ventana abierta a 90° (línea fina) y su giro, con el tipo de
# línea «st».
component window_leaf_plan(hx, dir, lw, d, st)
  line (hx, d / 2) to (hx, d / 2 + lw) pen thin style st
  arc center (hx, d / 2) from (hx, d / 2 + lw) to (hx + dir * lw, d / 2) pen thin style st

# Vierteaguas por fuera, del marco hasta 3 cm más allá de la fachada (solo
# sobresale de las jambas fuera del muro), y canto del alféizar por dentro.
component sill_plan(w, d, wall_e, wall_i)
  let es = if wall_e > 0 then 1 else -1
  let fe = es * d / 2
  let out = wall_e + es * 0.03
  polygon (-w / 2, fe) (w / 2, fe) (w / 2, wall_e) (w / 2 + 0.02, wall_e) (w / 2 + 0.02, out) (-w / 2 - 0.02, out) (-w / 2 - 0.02, wall_e) (-w / 2, wall_e) pen thin filled
  line (-w / 2, wall_i) to (w / 2, wall_i) pen thin

# ---- Planta a 1:20 ----------------------------------------------------------

# Jamba de puerta a 1:20 con su galce: el cerco cortado de «xa» a «xb» y,
# en el canto del lado de la hoja («side», 1 si la hoja queda hacia +x y
# -1 si hacia -x), el rebaje donde cierra la hoja de grueso «lt».
component door_jamb_detail(xa, xb, d, side, lt)
  let r = min(0.012, (xb - xa) / 3)
  let e = if side > 0 then xb else xa
  let i = e - side * r
  let yt = d / 2 - min(lt, d / 2)
  if side > 0
    polygon (xa, -d / 2) (xb, -d / 2) (xb, yt) (i, yt) (i, d / 2) (xa, d / 2) pen frame filled
  else
    polygon (xb, -d / 2) (xa, -d / 2) (xa, yt) (i, yt) (i, d / 2) (xb, d / 2) pen frame filled

# Doble vidrio a 1:20: dos líneas finas del grueso de una cámara.
component glass_detail(xa, xb)
  line (xa, -0.008) to (xb, -0.008) pen thin
  line (xa, 0.008) to (xb, 0.008) pen thin

# Hoja de ventana cerrada a 1:20: el perfil de la hoja alrededor del vidrio.
component sash_detail(xa, xb, d)
  let t = min(0.025, d / 3)
  polygon (xa, -t) (xb, -t) (xb, t) (xa, t) pen thin

# ---- Alzado -------------------------------------------------------------------
# En alzado la primera coordenada es «x» y la segunda «z», visto desde el
# lado al que abren las hojas. Líneas de apertura: el vértice señala el
# lado de las bisagras (o el eje), como se dibuja en los alzados.

# Hoja que gira sobre un lado vertical («hx», el de las bisagras; «ox», el
# de la manilla), de «z0» a «z1».
component side_hung_lines(hx, ox, z0, z1, st)
  line (ox, z0) to (hx, (z0 + z1) / 2) pen thin style st
  line (ox, z1) to (hx, (z0 + z1) / 2) pen thin style st

# Hoja que gira sobre un lado horizontal («zh», el de las bisagras; «zo»,
# el otro), de «xa» a «xb»: abatible (bisagras abajo) o proyectante (arriba).
component hung_lines(xa, xb, zh, zo, st)
  line (xa, zo) to ((xa + xb) / 2, zh) pen thin style st
  line (xb, zo) to ((xa + xb) / 2, zh) pen thin style st

# Hoja pivotante (eje vertical, «vertical» 1) o basculante (eje horizontal):
# un rombo hacia los extremos del eje y el eje en trazo y punto.
component pivot_lines(xa, xb, z0, z1, vertical, st)
  let xm = (xa + xb) / 2
  let zm = (z0 + z1) / 2
  line (xa, zm) to (xm, z1) pen thin style st
  line (xm, z1) to (xb, zm) pen thin style st
  line (xb, zm) to (xm, z0) pen thin style st
  line (xm, z0) to (xa, zm) pen thin style st
  if vertical > 0
    line (xm, z0) to (xm, z1) pen thin dashdot
  else
    line (xa, zm) to (xb, zm) pen thin dashdot

# Flecha horizontal de «xa» a «xb» a la altura «z» (correderas).
component arrow_lines(xa, xb, z)
  let s = if xb > xa then 1 else -1
  line (xa, z) to (xb, z) pen thin
  line (xb, z) to (xb - s * 0.06, z + 0.03) pen thin
  line (xb, z) to (xb - s * 0.06, z - 0.03) pen thin

# Líneas de apertura de una hoja de ventana según su funcionamiento («op»,
# las opciones de la ventana practicable) y el lado de sus bisagras
# («left», si van a la izquierda).
component leaf_elevation(op, xa, xb, z0, z1, left, st)
  let hx = if left then xa else xb
  let ox = if left then xb else xa
  if op == "practicable"
    use side_hung_lines(hx, ox, z0, z1, st)
  else if op == "oscilobatiente"
    use side_hung_lines(hx, ox, z0, z1, st)
    use hung_lines(xa, xb, z0, z1, st)
  else if op == "abatible"
    use hung_lines(xa, xb, z0, z1, st)
  else if op == "proyectante"
    use hung_lines(xa, xb, z1, z0, st)
  else if op == "basculante"
    use pivot_lines(xa, xb, z0, z1, 0, st)
  else if op == "pivotante"
    use pivot_lines(xa, xb, z0, z1, 1, st)

# Hoja pivotante (eje vertical en su centro) abierta a 90° en planta: la
# hoja atraviesa el marco, mitad a cada lado, con sus dos giros.
component pivot_leaf_plan(xa, xb, d, st)
  let m = (xa + xb) / 2
  let r = (xb - xa) / 2
  line (m, -r) to (m, r) pen thin style st
  arc center (m, 0) from (m, r) to (xb, 0) pen thin style st
  arc center (m, 0) from (m, -r) to (xa, 0) pen thin style st

# Flecha vertical en alzado, de «z0» a «z1» a la altura «x» (puertas de
# garaje y guillotinas: hacia donde se mueve la hoja).
component arrow_v_lines(x, z0, z1)
  let s = if z1 > z0 then 1 else -1
  line (x, z0) to (x, z1) pen thin
  line (x, z1) to (x - 0.04, z1 - s * 0.07) pen thin
  line (x, z1) to (x + 0.04, z1 - s * 0.07) pen thin
