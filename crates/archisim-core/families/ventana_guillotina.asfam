family "Ventana de guillotina"
  category window
  host wall
  version 6
  description "Ventana de dos hojas que deslizan en vertical, una delante de la otra: se mueve la de abajo o las dos"

include "piezas"

type_params
  section "Dimensiones"
    width  length = 1.00 range 0.30..3.00 label "Hueco de obra: ancho"
    height length = 1.50 range 0.50..3.50 label "Hueco de obra: alto"
  section "Hojas"
    moving choice("la de abajo", "las dos") = "la de abajo" label "Hojas que se mueven"
    meeting number = 0.50 range 0.30..0.70 label "Encuentro de las hojas (fracción del alto)"
  section "Marco"
    frame_width length = 0.06 range 0.001..0.30 label "Marco: anchura vista"
    frame_depth length = 0.10 range 0.04..0.40 label "Marco: fondo"
  section "Vierteaguas"
    sill bool = no label "Vierteaguas"
    sill_depth length = 0.20 range 0.02..1.00 visible_if sill label "Vierteaguas: vuelo desde el marco"
  section "Materiales"
    frame_material material = "Aluminio lacado" label "Marco y hojas"
    panel_material material = "Vidrio doble" label "Vidrio"
    sill_material material = "Piedra natural" visible_if sill label "Vierteaguas"
  section "Hueco de muro"
    frame_position choice("Centrado en el muro", "Por fuera", "Por dentro") = "Centrado en el muro" label "Posición del marco"
    frame_inset length = 0.00 range 0.00..0.60 visible_if frame_position != "Centrado en el muro" label "Marco: retranqueo desde la cara"
    nib length = 0.00 range 0.00..0.20 label "Mocheta: ancho (0, sin mocheta)"
    nib_material material = "Ladrillo visto" visible_if nib > 0 label "Mocheta"
    lintel choice("Sin dintel visto", "De hormigón", "De piedra", "De madera", "De acero", "Sardinel de ladrillo", "Arco rebajado de ladrillo") = "Sin dintel visto" label "Dintel visto"
    lintel_height length = 0.20 range 0.03..0.60 visible_if lintel != "Sin dintel visto" label "Dintel: alto"
    lintel_bearing length = 0.15 range 0.00..0.50 visible_if lintel != "Sin dintel visto" and lintel != "Arco rebajado de ladrillo" label "Dintel: entrega a cada lado"
    lintel_material material = "Hormigón armado" visible_if lintel != "Sin dintel visto" label "Dintel"
  section "Recercado"
    surround choice("Sin recercado", "Plano", "Moldurado", "Con clave") = "Sin recercado" label "Recercado por fuera"
    surround_width length = 0.15 range 0.04..0.60 visible_if surround != "Sin recercado" label "Recercado: ancho"
    surround_projection length = 0.03 range 0.005..0.20 visible_if surround != "Sin recercado" label "Recercado: vuelo"
    surround_material material = "Piedra caliza" visible_if surround != "Sin recercado" label "Recercado"
  section "Accesorios"
    head_drip bool = no label "Albardilla sobre el hueco"
    head_drip_material material = "Piedra caliza" visible_if head_drip label "Albardilla"
    inner_sill bool = no label "Alféizar por dentro"
    inner_sill_material material = "Madera de pino" visible_if inner_sill label "Alféizar"
    brise choice("Sin parasol", "Lamas horizontales", "Lamas verticales") = "Sin parasol" label "Parasol de lamas"
    brise_slat length = 0.10 range 0.02..0.40 visible_if brise != "Sin parasol" label "Parasol: ancho de lama"
    brise_gap length = 0.06 range 0.01..0.40 visible_if brise != "Sin parasol" label "Parasol: separación entre lamas"
    brise_offset length = 0.12 range 0.02..1.00 visible_if brise != "Sin parasol" label "Parasol: separación de la fachada"
    brise_material material = "Aluminio lacado" visible_if brise != "Sin parasol" label "Parasol"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Clásica" label "Modelo 3D"
    hardware_material material = "Latón" label "Herrajes"
  section "A tu gusto"
    window_profile choice("Como la colección", "Aluminio recto", "Aluminio redondeado", "PVC", "Madera", "Madera con moldura", "Acero fino") = "Como la colección" label "Perfil"
    glazing_bars choice("Como la colección", "Sin cuarterones", "Cuadrícula", "Cuadrícula fina", "Horizontales", "Verticales", "Solo arriba", "A medida") = "Como la colección" label "Cuarterones"
    bar_cols integer = 2 range 1..12 visible_if glazing_bars == "A medida" label "Cuarterones: vidrios a lo ancho"
    bar_rows integer = 3 range 1..12 visible_if glazing_bars == "A medida" label "Cuarterones: vidrios a lo alto"
  section "Por fuera"
    outside_shutters choice("Sin contraventanas", "Mallorquinas", "De tablas", "De cuarterones") = "Sin contraventanas" label "Contraventanas"
    shutters_open bool = yes visible_if outside_shutters != "Sin contraventanas" label "Contraventanas abiertas"
    shutters_material material = "Madera de pino" visible_if outside_shutters != "Sin contraventanas" label "Contraventanas: material"
    grille choice("Sin reja", "Barrotes", "Barrotes y pletinas", "Cuadrícula", "Forja con volutas") = "Sin reja" label "Reja"
    grille_box bool = no visible_if grille != "Sin reja" label "Reja de cajón"
    grille_depth length = 0.18 range 0.08..0.60 visible_if grille != "Sin reja" and grille_box label "Reja: vuelo"
    grille_material material = "Hierro forjado" visible_if grille != "Sin reja" label "Reja: material"
  section "Representación"
    opening_lines_in_views bool = no label "Flechas de apertura en alzados y secciones del modelo"
  section "Representación"
    plan_frame_fill choice("Blanco", "Color del material") = "Blanco" label "Marco cortado en planta"
  section "Clasificación"
    classification_system choice("GuBIMClass", "Uniclass 2015", "OmniClass") = "GuBIMClass" label "Sistema de clasificación"
    classification text = "" label "Código de clasificación"

instance_params
  section "Posición"
    sash_open integer = 0 range 0..100 label "Hoja de abajo subida en 3D (%)"

let f = frame_width
let c0 = -width / 2 + f
let c1 = width / 2 - f
let zm = height * meeting
# Las hojas, en dos planos: la de abajo hacia el lado al que abre, la de
# arriba hacia el otro.
let q = frame_depth / 4
let ts = min(0.02, frame_depth / 4)
let r = f * 0.8

require c1 - c0 > 2 * r + 0.10 else "El marco no deja hueco para las hojas"

component sash(xa, xb, za, zb, y, t, r, frame_mat, glass_mat)
  box (xa, y - t, za) to (xa + r, y + t, zb) material frame_mat
  box (xb - r, y - t, za) to (xb, y + t, zb) material frame_mat
  box (xa + r, y - t, za) to (xb - r, y + t, za + r) material frame_mat
  box (xa + r, y - t, zb - r) to (xb - r, y + t, zb) material frame_mat
  box (xa + r, y - t / 2, za + r) to (xb - r, y + t / 2, zb - r) material glass_mat

body
  # En 3D, el marco y las hojas los hace ArchiSim con el perfil y los
  # herrajes de la colección (generator props:sash_window).
  if not detailed
    use window_frame(width, height, f, frame_depth, frame_material)
    use sash(c0, c1, f, zm + r / 2, q, ts, r, frame_material, panel_material)
    use sash(c0, c1, zm - r / 2, height - f, -q, ts, r, frame_material, panel_material)
  if sill
    let out = if opens_to == "exterior" then 1 else -1
    use window_sill(width, frame_depth, sill_depth, out, sill_material)
  # Hueco de muro y accesorios (E6).
  use nib_pieces(width, height, frame_depth, wall_ext, nib, nib_material)
  if surround != "Sin recercado"
    use surround_pieces(width, height, wall_ext, surround, surround_width, surround_projection, surround_material, 1)
  let lk = if lintel == "Sin dintel visto" then 0 else if lintel == "De acero" then 2 else if lintel == "Sardinel de ladrillo" then 3 else if lintel == "Arco rebajado de ladrillo" then 4 else 1
  if lk > 0
    use lintel_pieces(width, height, wall_ext, wall_int, lk, lintel_height, if lk == 4 then 0 else lintel_bearing, lintel_material)
  if head_drip
    let zlt = if lk == 4 then width / 8 + lintel_height else if lk > 0 then lintel_height else 0
    let zs = if surround != "Sin recercado" then surround_width else 0
    use head_drip(width, height + max(zlt, zs), wall_ext, head_drip_material)
  if inner_sill
    use inner_sill(width, frame_depth, wall_int, inner_sill_material)
  if brise != "Sin parasol"
    use brise(width, height, wall_ext, if brise == "Lamas horizontales" then 1 else 2, brise_slat, brise_gap, brise_offset, brise_material)

plan 1:50
  use wall_hole_plan(width, frame_depth, wall_ext, nib, if surround != "Sin recercado" then surround_width else 0, surround_projection, if brise != "Sin parasol" then 1 else 0, brise_slat, brise_offset)
  if sill_height > 0
    use sill_plan(width, frame_depth, wall_ext, wall_int)
  let ew = if wall_ext > 0 then 1 else -1
  if grille != "Sin reja"
    let gx = width / 2 + 0.06
    if grille_box
      line (-gx, wall_ext) to (-gx, wall_ext + ew * grille_depth) pen thin
      line (-gx, wall_ext + ew * grille_depth) to (gx, wall_ext + ew * grille_depth) pen thin
      line (gx, wall_ext + ew * grille_depth) to (gx, wall_ext) pen thin
    else
      line (-gx, wall_ext + ew * 0.03) to (gx, wall_ext + ew * 0.03) pen thin
  if outside_shutters != "Sin contraventanas"
    let sy = wall_ext + ew * 0.02
    if shutters_open
      line (-width, sy) to (-width / 2, sy) pen thin
      line (width / 2, sy) to (width, sy) pen thin
    else
      line (-width / 2, sy) to (width / 2, sy) pen thin
  use frame_cut_plan_t(-width / 2, c0, frame_depth, plan_frame_fill == "Color del material", frame_material)
  use frame_cut_plan_t(c1, width / 2, frame_depth, plan_frame_fill == "Color del material", frame_material)
  polygon (c0, q - ts) (c1, q - ts) (c1, q + ts) (c0, q + ts) pen thin
  line (c0, -q) to (c1, -q) pen thin

plan 1:100
  use frame_cut_plan_t(-width / 2, width / 2, frame_depth, plan_frame_fill == "Color del material", frame_material)
  line (c0, 0) to (c1, 0) pen thin

# En alzado, el travesaño del encuentro y las flechas de lo que se mueve.
elevation
  line (c0, zm) to (c1, zm) pen thin
  use arrow_v_lines(0, f + (zm - f) * 0.25, f + (zm - f) * 0.75)
  if moving == "las dos"
    use arrow_v_lines(0, zm + (height - f - zm) * 0.75, zm + (height - f - zm) * 0.25)

outputs
  frame_align = if frame_position == "Por fuera" then "exterior" else if frame_position == "Por dentro" then "interior" else "centre"
  frame_inset = frame_inset
  generator = "props:sash_window"
  w_fw = f
  w_w = width
  w_z1 = height
  w_zm = zm
  w_outside = if opens_to == "exterior" then 1 else -1
  w_width = width
  w_height = height
  w_top = height
  opening_width = width
  opening_height = height
  frame_width = frame_width
  frame_depth = frame_depth
  frame_material = frame_material
  panel_material = panel_material
  operation = "sliding"

ifc
  partitioning = "DOUBLE_PANEL_HORIZONTAL"
  panel_count = 2
  panel_1 = "SLIDINGVERTICAL"
  panel_2 = if moving == "las dos" then "SLIDINGVERTICAL" else "FIXEDCASEMENT"
