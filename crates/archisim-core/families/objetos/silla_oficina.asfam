family "Silla de oficina"
  category furniture
  host none
  version 3
  description "Silla para el escritorio como la hace cada colección"
  folder "Despacho"

include "muebles"

type_params
  section "Dimensiones"
    width length = 0.62 range 0.45..0.80 label "Ancho"
    seat  length = 0.47 range 0.38..0.56 label "Altura del asiento"
  section "Materiales"
    frame   material = "Roble claro" label "Madera o estructura"
    cushion material = "Lino arena" label "Tapizado"
    metal   material = "Metal negro" label "Metal"
    dark    material = "Metal negro" label "Base y patas"
    accent  material = "Terciopelo mostaza" label "Carcasa de color"
    weave   material = "Enea" label "Asiento de enea o cuerda"
    mesh    material = "Lana carbón" label "Malla"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

body
  box (-width / 2, 0, 0) to (width / 2, width, seat + 0.4) material cushion

plan 1:50
  let r = width / 2
  repeat i in 0..5
    let a = 1.5708 + 6.283185307 * i / 5
    line (0, r) to (r * 0.95 * cos(a), r + r * 0.95 * sin(a)) pen thin
    use soft_oval_thin(r * 0.95 * cos(a), r + r * 0.95 * sin(a), 0.025, 0.025)
  use soft_box(-r * 0.75, r * 0.4, r * 0.75, r * 1.75, 0.08)
  use soft_pad(-r * 0.8, r * 0.2, r * 0.8, r * 0.45, 0.05)

outputs
  generator = "props:office_chair"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
