family "Mesa de centro"
  category furniture
  host none
  version 2
  description "Mesa baja de salón"
  folder "Mesas"

# Ejes de los objetos: origen en el centro del lado de atrás, x hacia la
# derecha, y hacia delante, z hacia arriba desde el suelo.

type_params
  section "Dimensiones"
    width  length = 1.10 range 0.40..2.00 label "Largo"
    depth  length = 0.60 range 0.30..1.20 label "Fondo"
    height length = 0.40 range 0.25..0.60 label "Altura"
  section "Materiales"
    top      material = "Roble claro" label "Tablero"
    frame    material = "Roble claro" label "Patas y estructura"
    metal    material = "Metal negro" label "Metal"
    stone    material = "Mármol" label "Piedra"
    ceramic  material = "Cerámica esmaltada" label "Cerámica"
    dark     material = "Negro mate" label "Detalles oscuros"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

body
  box (-width / 2, 0, height - 0.03) to (width / 2, depth, height) material top
  box (-width / 2 + 0.03, 0.03, 0) to (-width / 2 + 0.08, 0.08, height - 0.03) material top
  box (width / 2 - 0.08, 0.03, 0) to (width / 2 - 0.03, 0.08, height - 0.03) material top
  box (-width / 2 + 0.03, depth - 0.08, 0) to (-width / 2 + 0.08, depth - 0.03, height - 0.03) material top
  box (width / 2 - 0.08, depth - 0.08, 0) to (width / 2 - 0.03, depth - 0.03, height - 0.03) material top

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view
  polygon (-width / 2 + 0.05, 0.05) (width / 2 - 0.05, 0.05) (width / 2 - 0.05, depth - 0.05) (-width / 2 + 0.05, depth - 0.05) pen thin

plan 1:100
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view

outputs
  generator = "props:fine_coffee_table"
  ifc_class = "IfcFurniture"
  ifc_type = "TABLE"
