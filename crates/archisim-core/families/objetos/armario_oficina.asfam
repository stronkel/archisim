family "Armario de oficina"
  category furniture
  host none
  version 1
  description "Armario bajo de oficina con puertas y, encima, baldas con archivadores, como lo hace cada colección"
  folder "Oficina"

type_params
  section "Dimensiones"
    width  length = 1.60 range 0.80..4.00 label "Ancho"
    depth  length = 0.45 range 0.35..0.60 label "Fondo"
    height length = 1.20 range 0.75..2.20 label "Altura"
  section "Materiales"
    frame   material = "Roble claro" label "Mueble"
    front   material = "Roble claro" label "Puertas"
    metal   material = "Latón" label "Tiradores"
    dark    material = "Metal negro" label "Zócalo y acero"
    binder  material = "Archivador azul" label "Archivadores"
    binder2 material = "Archivador rojo" label "Otros archivadores"
    binder3 material = "Archivador blanco" label "Etiquetas y archivadores claros"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

body
  box (-width / 2, 0, 0) to (width / 2, depth, height) material frame

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view

outputs
  generator = "props:fine_office_storage"
  ifc_class = "IfcFurniture"
  ifc_type = "FILECABINET"
