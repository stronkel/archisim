family "Macetón"
  category street
  host none
  version 3
  description "Macetón como lo hace cada colección, con su planta"
  folder "Jardín y terraza"

include "muebles"

type_params
  section "Dimensiones"
    width  length = 0.60 range 0.25..1.40 label "Diámetro"
    height length = 1.40 range 0.30..2.80 label "Altura con la planta"
  section "Materiales"
    frame material = "Teca" label "Madera o estructura"
    metal material = "Metal negro" label "Metal"
    weave material = "Ratán" label "Cuerda o fibra"
    cushion material = "Tela de exterior" label "Cojines"
    pillow material = "Lino añil" label "Cojines sueltos"
    mat material = "Tela de exterior" label "Lona"
    accent material = "Lino añil" label "Rayas"
    top material = "Mármol" label "Tablero"
    masonry material = "Cal blanca" label "Obra"
    pot_mat material = "Terracota" label "Maceta"
    soil material = "Tierra" label "Tierra"
    stem material = "Corteza de pino" label "Tronco y tallos"
    leaves material = "Hoja verde" label "Hojas"
    flowers material = "Lavanda" label "Flores"
    leaves2 material = "Hoja verde tierna" label "Hojas claras"
    dark material = "Metal negro" label "Base y sombras"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

body
  box (-width / 2, 0, 0) to (width / 2, width, height * 0.4) material pot_mat

plan 1:50
  use soft_oval(0, width / 2, width / 2, width / 2)
  use soft_oval_thin(0, width / 2, width / 2 - 0.03, width / 2 - 0.03)
  let r = max(height * 0.3, width * 0.45)
  let n = 8
  let turn = 6.283185307 * rand(seed * 7)
  repeat i in 0..n
    let a = turn + 6.283185307 * (i + 0.3 * rand(seed * 13 + i)) / n
    let l = r * (0.7 + 0.3 * rand(seed * 17 + i))
    use leaf(0, width / 2, l, l * 0.2, a)
  repeat i in 0..4
    let a = turn + 0.35 + 6.283185307 * i / 4
    use leaf(0, width / 2, r * 0.55, r * 0.13, a)

outputs
  generator = "props:big_pot"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
