family "Frigorífico"
  category kitchen
  host none
  version 2
  description "Frigorífico de pie"
  folder "Electrodomésticos"

include "muebles"

type_params
  section "Dimensiones"
    width  length = 0.60 range 0.40..1.20 label "Ancho"
    depth  length = 0.65 range 0.50..0.90 label "Fondo"
    height length = 1.85 range 0.80..2.20 label "Altura"
  section "Materiales"
    mat material = "Acero S275" label "Acabado"
  section "Modelo 3D"
    model3d choice("Combi") = "Combi" label "Modelo 3D"
    metal material = "Cromado" label "Tiradores"

body
  box (-width / 2, 0, 0) to (width / 2, depth, height) material mat

plan 1:50
  use soft_box(-width / 2, 0, width / 2, depth, 0.03)
  line (-width / 2 + 0.01, depth - 0.05) to (width / 2 - 0.01, depth - 0.05) pen thin
  line (-width / 2 + 0.04, depth - 0.02) to (-width / 2 + 0.04, depth + 0.015) pen thin
  line (-width / 2 + 0.04, depth + 0.015) to (-width / 2 + 0.2, depth + 0.015) pen thin
  line (-width / 2 + 0.03, 0.04) to (width / 2 - 0.03, depth - 0.08) pen thin dashed

outputs
  generator = "props:fridge"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
