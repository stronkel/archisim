family "Bolardo"
  category street
  host none
  version 2
  description "Bolardo o pilona; el punto de inserción es su centro"
  folder "Mobiliario urbano"

type_params
  section "Dimensiones"
    width  length = 0.15 range 0.06..0.60 label "Diámetro"
    height length = 0.80 range 0.30..1.50 label "Altura"
  section "Materiales"
    mat material = "Metal lacado" label "Bolardo"
  section "Modelo 3D"
    model3d choice("Fundición", "Tubo de acero", "Hormigón") = "Fundición" label "Modelo 3D"
    band     material = "Cerámica blanca" label "Banda reflectante"
    concrete material = "Hormigón prefabricado" label "Hormigón"

body
  box (-width / 2, -width / 2, 0) to (width / 2, width / 2, height) material mat

plan 1:50
  let r = width / 2
  repeat i in 0..12
    let t0 = 6.283185307 * i / 12
    let t1 = 6.283185307 * (i + 1) / 12
    line (r * cos(t0), r * sin(t0)) to (r * cos(t1), r * sin(t1)) pen view

plan presentation
  cloud center (0, 0) radius width / 2 lobes 12 jitter 0 pen thin tint mat

outputs
  generator = "props:bollard"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
