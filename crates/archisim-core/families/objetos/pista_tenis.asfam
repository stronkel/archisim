family "Pista de tenis"
  category street
  host none
  version 1
  description "Pista de tenis reglamentaria con sus líneas, red y silla de árbitro sobre su zona de seguridad (36,57 × 18,29 m)"
  folder "Pistas deportivas"

type_params
  section "Materiales"
    court   material = "Pista azul" label "Pista"
    ground  material = "Pista verde" label "Zona de seguridad"
    line    material = "Línea blanca" label "Líneas y cinta"
    net     material = "Red negra" label "Red"
    dark    material = "Metal negro" label "Postes"
    frame   material = "Lacado blanco" label "Silla del árbitro"

body
  box (-18.285, 0, 0) to (18.285, 18.29, 2.3) material court

plan 1:50
  polygon (-18.285, 0) (18.285, 0) (18.285, 18.29) (-18.285, 18.29) pen thin
  polygon (-11.885, 3.66) (11.885, 3.66) (11.885, 14.63) (-11.885, 14.63) pen view
  line (0, 2.75) to (0, 15.54) pen view

outputs
  generator = "props:fine_tennis_court"
  ifc_class = "IfcBuildingElementProxy"
  ifc_type = "USERDEFINED"
