family "Taburete"
  category furniture
  host none
  version 3
  description "Taburete alto de cocina: de madera, tapizado con respaldo o de enea"
  folder "Taburetes"

include "muebles"

type_params
  section "Dimensiones"
    width  length = 0.38 range 0.28..0.55 label "Ancho del asiento"
    height length = 0.65 range 0.40..0.85 label "Altura del asiento"
  section "Materiales"
    frame    material = "Roble claro" label "Madera"
    mat      material = "Lino arena" label "Tapicería"
    weave    material = "Enea" label "Asiento de enea"
    metal    material = "Metal negro" label "Metal"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

body
  box (-width / 2, 0, 0) to (width / 2, width, height) material mat

plan 1:50
  if model3d == "Mediterráneo" or model3d == "Japandi"
    use soft_box(-width * 0.41, width * 0.09, width * 0.41, width * 0.91, width * 0.08)
    use soft_pad(-width * 0.33, width * 0.17, width * 0.33, width * 0.83, width * 0.06)
  else
    use soft_oval(0, width / 2, width / 2, width / 2)
    use soft_oval_thin(0, width / 2, width * 0.36, width * 0.36)

outputs
  generator = "props:fine_stool"
  ifc_class = "IfcFurniture"
  ifc_type = "CHAIR"
