family "Cómoda"
  category furniture
  host none
  version 3
  description "Cómoda como la hace cada colección: cajones en una o varias columnas"
  folder "Dormitorio"

type_params
  section "Dimensiones"
    width  length = 1.00 range 0.40..2.40 label "Ancho"
    depth  length = 0.50 range 0.30..0.70 label "Fondo"
    height length = 0.85 range 0.40..1.40 label "Altura"
  section "Frentes"
    drawers integer = 4 range 1..10 label "Cajones por columna"
    columns integer = 1 range 1..4 label "Columnas"
  section "Materiales"
    frame material = "Roble claro" label "Madera o estructura"
    front material = "Lacado blanco" label "Frentes"
    top material = "Roble claro" label "Encimera"
    stone material = "Mármol" label "Piedra"
    plinth material = "Roble claro" label "Zócalo"
    metal material = "Latón" label "Tiradores y metal"
    glass material = "Vidrio claro" label "Vidrio"
    weave material = "Enea" label "Rejilla o enea"
    dark material = "Fresno oscuro" label "Sombras y cuero"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

body
  box (-width / 2, 0, 0) to (width / 2, depth, height) material frame

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view
  line (-width / 2, depth - 0.02) to (width / 2, depth - 0.02) pen thin
  let cw = width / columns
  repeat i in 1..columns
    line (-width / 2 + i * cw, 0) to (-width / 2 + i * cw, depth) pen thin

plan 1:100
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view

outputs
  generator = "props:chest"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"

# Stretched, a column of drawers more when the drawers would be too wide.
stretch
  columns = if width / columns >= 0.4 and width / columns <= 1.1 then columns else max(1, round(width / 0.8))
