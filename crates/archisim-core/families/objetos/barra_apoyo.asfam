family "Barra de apoyo"
  category sanitary
  host none
  version 1
  description "Barra de apoyo fija o abatible para baños accesibles"
  folder "Accesorios de baño"

type_params
  section "Dimensiones"
    width     length = 0.70 range 0.30..1.20 label "Longitud"
    elevation length = 0.75 range 0.60..0.95 label "Altura desde el suelo"
  section "Modelo 3D"
    model3d choice("Fija", "Abatible") = "Fija" label "Modelo 3D"
    metal material = "Cromado" label "Metal"

body
  box (-width / 2, 0, elevation - 0.02) to (width / 2, 0.08, elevation + 0.02) material metal

plan 1:50
  line (-width / 2, 0.06) to (width / 2, 0.06) pen view
  line (-width / 2, 0) to (-width / 2, 0.06) pen thin
  line (width / 2, 0) to (width / 2, 0.06) pen thin

outputs
  generator = "props:grab_bar"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
