family "Puestos de trabajo"
  category furniture
  host none
  version 1
  description "Mesa bench de puestos enfrentados con mampara, monitor y teclado en cada puesto, como la hace cada colección"
  folder "Oficina"

type_params
  section "Dimensiones"
    width  length = 2.80 range 1.20..7.00 label "Largo"
    depth  length = 1.60 range 1.20..2.00 label "Fondo de las dos mesas"
    height length = 0.74 range 0.68..0.80 label "Altura"
    places integer = 2 range 1..5 label "Puestos por lado"
  section "Materiales"
    top     material = "Roble claro" label "Tablero"
    frame   material = "Roble claro" label "Patas y estructura"
    metal   material = "Latón" label "Metal"
    dark    material = "Metal negro" label "Acero negro y monitores"
    screen  material = "Fieltro gris" label "Mampara"
    weave   material = "Enea" label "Rejilla o lino"
    accent  material = "Cuero coñac" label "Color o piel"
    display material = "Pantalla de televisor" label "Pantallas"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

body
  box (-width / 2, 0, 0) to (width / 2, depth, height) material top

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view
  line (-width / 2, depth / 2) to (width / 2, depth / 2) pen thin

outputs
  generator = "props:fine_bench_desk"
  ifc_class = "IfcFurniture"
  ifc_type = "DESK"
