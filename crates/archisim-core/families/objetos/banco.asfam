family "Banco"
  category street
  host none
  version 2
  description "Banco de exterior con respaldo o sin él"
  folder "Mobiliario urbano"

type_params
  section "Dimensiones"
    width  length = 1.80 range 0.60..6.00 label "Largo"
    depth  length = 0.50 range 0.30..0.80 label "Fondo"
    seat   length = 0.45 range 0.30..0.60 label "Altura del asiento"
    back   bool = yes label "Respaldo"
    height length = 0.85 visible_if back range 0.60..1.20 label "Altura del respaldo"
  section "Materiales"
    mat material = "Madera de pino" label "Asiento"

require not back or height > seat + 0.1 else "El respaldo tiene que subir por encima del asiento"

body
  box (-width / 2 + 0.1, 0.05, 0) to (-width / 2 + 0.16, depth - 0.05, seat - 0.05) material mat
  box (width / 2 - 0.16, 0.05, 0) to (width / 2 - 0.1, depth - 0.05, seat - 0.05) material mat
  box (-width / 2, 0, seat - 0.05) to (width / 2, depth, seat) material mat
  if back
    box (-width / 2, 0, seat) to (width / 2, 0.05, height) material mat

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view
  if back
    line (-width / 2, 0.05) to (width / 2, 0.05) pen thin
  let n = max(2, round(width / 0.2))
  repeat i in 1..n
    line (-width / 2 + i * width / n, 0.08) to (-width / 2 + i * width / n, depth) pen thin

outputs
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
