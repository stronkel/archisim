family "Bicicleta"
  category vehicle
  host none
  version 1
  description "Bicicleta; el punto de inserción es el centro de la rueda trasera, mira hacia delante"
  folder "Bicicletas"

type_params
  section "Dimensiones"
    length length = 1.75 range 1.20..2.20 label "Largo"
    wheel  length = 0.68 range 0.40..0.75 label "Diámetro de rueda"
  section "Materiales"
    frame_mat material = "Carrocería" label "Cuadro"
    tyre      material = "Neumático" label "Ruedas"

body
  box (-0.02, 0, 0) to (0.02, wheel, wheel) material tyre
  box (-0.02, length - wheel, 0) to (0.02, length, wheel) material tyre
  box (-0.02, wheel / 2, wheel / 2) to (0.02, length - wheel / 2, wheel / 2 + 0.05) material frame_mat
  box (-0.02, wheel * 0.9, wheel / 2) to (0.02, wheel * 0.9 + 0.04, wheel + 0.25) material frame_mat
  box (-0.10, wheel * 0.75, wheel + 0.25) to (0.10, wheel * 1.05, wheel + 0.30) material frame_mat
  box (-0.02, length - wheel * 0.75, wheel / 2) to (0.02, length - wheel * 0.75 + 0.04, wheel + 0.35) material frame_mat
  box (-0.30, length - wheel * 0.80, wheel + 0.35) to (0.30, length - wheel * 0.70, wheel + 0.38) material frame_mat

plan 1:50
  polygon (-0.02, 0) (0.02, 0) (0.02, wheel) (-0.02, wheel) pen view
  polygon (-0.02, length - wheel) (0.02, length - wheel) (0.02, length) (-0.02, length) pen view
  line (0, wheel / 2) to (0, length - wheel / 2) pen view
  line (-0.30, length - wheel * 0.75) to (0.30, length - wheel * 0.75) pen view
  polygon (-0.10, wheel * 0.75) (0.10, wheel * 0.75) (0.10, wheel * 1.05) (-0.10, wheel * 1.05) pen thin

outputs
  ifc_class = "IfcBuildingElementProxy"
  ifc_type = "USERDEFINED"
