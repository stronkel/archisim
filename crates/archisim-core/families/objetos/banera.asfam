family "Bañera"
  category sanitary
  host none
  version 2
  description "Bañera como la hace cada colección: exenta, con patas, de obra o de madera"
  folder "Duchas y bañeras"

type_params
  section "Dimensiones"
    width  length = 1.70 range 1.20..2.00 label "Largo"
    depth  length = 0.70 range 0.60..0.90 label "Ancho"
    height length = 0.55 range 0.40..0.70 label "Altura"
  section "Materiales"
    mat material = "Porcelana" label "Porcelana"
    unit material = "Roble claro" label "Mueble u obra"
    top material = "Piedra caliza" label "Encimera o piedra"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"
    metal material = "Acero inoxidable" label "Grifería y metal"
    seat material = "Lacado blanco" label "Asiento"
    glass material = "Vidrio claro" label "Vidrio y espejo"
    frame material = "Roble claro" label "Marco"
    wood material = "Roble claro" label "Madera"
    towel material = "Toalla blanca" label "Toallas y cortina"
    dark material = "Cuero coñac" label "Sombras y cuero"
    light material = "Cristal esmerilado" label "Luz"

body
  box (-width / 2, 0, 0) to (width / 2, depth, height) material mat

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view
  polygon (-width / 2 + 0.08, 0.08) (width / 2 - 0.08, 0.08) (width / 2 - 0.08, depth - 0.08) (-width / 2 + 0.08, depth - 0.08) pen thin
  arc center (width / 2 - 0.2, depth / 2) from (width / 2 - 0.17, depth / 2) to (width / 2 - 0.2, depth / 2 + 0.03) pen thin
  arc center (width / 2 - 0.2, depth / 2) from (width / 2 - 0.2, depth / 2 + 0.03) to (width / 2 - 0.23, depth / 2) pen thin
  arc center (width / 2 - 0.2, depth / 2) from (width / 2 - 0.23, depth / 2) to (width / 2 - 0.2, depth / 2 - 0.03) pen thin
  arc center (width / 2 - 0.2, depth / 2) from (width / 2 - 0.2, depth / 2 - 0.03) to (width / 2 - 0.17, depth / 2) pen thin

outputs
  generator = "props:bath"
  ifc_class = "IfcSanitaryTerminal"
  ifc_type = "BATH"
