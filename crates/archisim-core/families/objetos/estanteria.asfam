family "Estantería"
  category furniture
  host none
  version 4
  description "Estantería de tablero con baldas fijas y trasera"
  folder "Estanterías"

type_params
  section "Dimensiones"
    width   length = 0.80 range 0.30..3.00 label "Ancho"
    depth   length = 0.30 range 0.20..0.60 label "Fondo"
    height  length = 1.80 range 0.40..2.60 label "Altura"
    shelves integer = 4 range 1..10 label "Baldas intermedias"
    board   length = 0.02 range 0.012..0.05 label "Grueso del tablero"
  section "Materiales"
    mat material = "Madera de pino" label "Tablero"
  section "Modelo 3D"
    model3d choice("Con libros", "Con objetos") = "Con libros" label "Modelo 3D"
    books material = "Libros" label "Libros"
    books2 material = "Libros claros" label "Libros claros"
    glaze   material = "Cerámica esmaltada" label "Jarrones"
    pot_mat material = "Terracota" label "Macetas"
    leaves  material = "Hoja verde" label "Plantas"
    weave   material = "Ratán" label "Cestas"

require width > 2 * board + 0.1 else "No queda hueco entre los costados"
require height > (shelves + 2) * board + 0.1 else "No caben tantas baldas"

body
  box (-width / 2, 0, 0) to (-width / 2 + board, depth, height) material mat
  box (width / 2 - board, 0, 0) to (width / 2, depth, height) material mat
  box (-width / 2 + board, 0, 0) to (width / 2 - board, 0.01, height) material mat
  let gap = (height - board) / (shelves + 1)
  repeat i in 0..shelves + 2
    box (-width / 2 + board, 0.01, i * gap) to (width / 2 - board, depth, i * gap + board) material mat

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view
  line (-width / 2 + board, 0) to (-width / 2 + board, depth) pen thin
  line (width / 2 - board, 0) to (width / 2 - board, depth) pen thin
  line (-width / 2 + board, 0.01) to (width / 2 - board, 0.01) pen thin
  line (-width / 2 + board, depth) to (width / 2 - board, 0.01) pen thin

outputs
  # Placed against another of its kind, in line: one, as wide as both.
  joins = "width"
  generator = "props:bookcase"
  ifc_class = "IfcFurniture"
  ifc_type = "SHELF"

# Stretched up, a shelf more when they would be too far apart.
stretch
  shelves = if height / (shelves + 1) >= 0.25 and height / (shelves + 1) <= 0.45 then shelves else round(height / 0.35) - 1
