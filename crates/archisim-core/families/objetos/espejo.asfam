family "Espejo"
  category sanitary
  host none
  version 1
  description "Espejo colgado en la pared, con marco, sin marco o redondo"
  folder "Accesorios de baño"

type_params
  section "Dimensiones"
    width     length = 0.80 range 0.30..3.00 label "Ancho"
    height    length = 1.00 range 0.30..2.20 label "Altura"
    elevation length = 1.00 range 0.00..2.00 label "Altura desde el suelo"
  section "Materiales"
    glass material = "Vidrio" label "Espejo"
  section "Modelo 3D"
    model3d choice("Con marco", "Sin marco", "Redondo") = "Con marco" label "Modelo 3D"
    frame material = "Metal lacado" label "Marco"

body
  box (-width / 2, 0, elevation) to (width / 2, 0.03, elevation + height) material glass

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, 0.03) (-width / 2, 0.03) pen view dashed

outputs
  generator = "props:mirror"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
