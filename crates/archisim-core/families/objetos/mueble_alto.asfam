family "Mueble alto de cocina"
  category kitchen
  host none
  version 6
  description "Muebles altos o baldas abiertas sobre la encimera, como los hace cada colección"
  folder "Cocina"

type_params
  section "Dimensiones"
    width     length = 1.20 range 0.30..8.00 label "Largo"
    depth     length = 0.35 range 0.25..0.45 label "Fondo"
    height    length = 0.70 range 0.30..1.00 label "Altura"
    elevation length = 1.45 range 1.10..2.00 label "Altura desde el suelo"
    doors     integer = 2 range 1..12 label "Puertas"
  section "Materiales"
    mat material = "Lacado blanco" label "Frentes"
    plinth material = "Roble claro" label "Zócalo"
    top material = "Roble claro" label "Encimera"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"
    metal material = "Acero inoxidable" label "Tiradores y grifería"
    sink material = "Acero inoxidable" label "Fregadero"
    dark material = "Cuero coñac" label "Sombras y cuero"
    black material = "Vitrocerámica" label "Placa y horno"
    ring material = "Cal blanca" label "Marcas de la placa"
    glass material = "Vidrio claro" label "Vidrio"
    wood material = "Roble claro" label "Madera (patas, baldas)"
    ceramic material = "Cerámica blanca" label "Tarros y jarras"
    hood material = "Lacado blanco" label "Campana"

body
  box (-width / 2, 0, elevation) to (width / 2, depth, elevation + height) material mat

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view dashed
  line (-width / 2, 0) to (width / 2, depth) pen thin dashed
  let dw = width / doors
  repeat i in 1..doors
    line (-width / 2 + i * dw, depth - 0.05) to (-width / 2 + i * dw, depth) pen thin dashed

outputs
  # Placed against another of its kind, in line: one, as wide as both.
  joins = "width"
  generator = "props:wall_cabinet"
  ifc_class = "IfcFurniture"
  ifc_type = "SHELF"

# Stretched, a door more when the doors would be too wide.
stretch
  doors = if width / doors >= 0.3 and width / doors <= 0.65 then doors else max(1, round(width / 0.5))
