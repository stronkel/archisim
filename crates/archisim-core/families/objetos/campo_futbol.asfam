family "Campo de fútbol"
  category street
  host none
  version 1
  description "Campo de fútbol de hierba segada a franjas, con sus líneas, áreas, porterías y banderines de córner: fútbol 11 (105 × 68 m) o fútbol 7 (65 × 45 m)"
  folder "Pistas deportivas"

type_params
  section "Juego"
    game choice("Fútbol 11", "Fútbol 7") = "Fútbol 11" label "Campo"
  section "Materiales"
    court   material = "Césped natural" label "Césped"
    court2  material = "Césped natural claro" label "Franjas"
    ground  material = "Césped natural" label "Zona de seguridad"
    line    material = "Línea blanca" label "Líneas"
    frame   material = "Lacado blanco" label "Porterías y banderines"
    net     material = "Red blanca" label "Redes"
    accent  material = "Pintura amarilla" label "Banderines"

body
  let hl = if game == "Fútbol 7" then 32.5 else 52.5
  let hw = if game == "Fútbol 7" then 22.5 else 34
  let run = if game == "Fútbol 7" then 3 else 4
  box (-hl - run, 0, 0) to (hl + run, 2 * (hw + run), 2.5) material court

plan 1:50
  let hl = if game == "Fútbol 7" then 32.5 else 52.5
  let hw = if game == "Fútbol 7" then 22.5 else 34
  let run = if game == "Fútbol 7" then 3 else 4
  polygon (-hl - run, 0) (hl + run, 0) (hl + run, 2 * (hw + run)) (-hl - run, 2 * (hw + run)) pen thin
  polygon (-hl, run) (hl, run) (hl, run + 2 * hw) (-hl, run + 2 * hw) pen view
  line (0, run) to (0, run + 2 * hw) pen view

outputs
  generator = "props:fine_football_field"
  ifc_class = "IfcBuildingElementProxy"
  ifc_type = "USERDEFINED"
