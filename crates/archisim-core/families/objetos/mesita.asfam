family "Mesita de noche"
  category furniture
  host none
  version 1
  description "Mesita de noche con dos cajones y una lámpara"
  folder "Dormitorio"

type_params
  section "Dimensiones"
    width  length = 0.45 range 0.30..0.80 label "Ancho"
    depth  length = 0.40 range 0.30..0.60 label "Fondo"
    height length = 0.50 range 0.35..0.75 label "Altura"
  section "Materiales"
    mat material = "Madera de pino" label "Madera"
  section "Modelo 3D"
    model3d choice("Cajonera", "Con patas") = "Cajonera" label "Modelo 3D"
    frame material = "Metal lacado" label "Tiradores y patas"
    shade material = "Tela clara" label "Pantalla de la lámpara"

body
  box (-width / 2, 0, 0) to (width / 2, depth, height) material mat

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view
  let r = 0.11
  let xc = width * 0.1
  let yc = depth * 0.45
  repeat i in 0..16
    let t0 = 6.283185307 * i / 16
    let t1 = 6.283185307 * (i + 1) / 16
    line (xc + r * cos(t0), yc + r * sin(t0)) to (xc + r * cos(t1), yc + r * sin(t1)) pen thin

plan 1:100
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view

outputs
  generator = "props:nightstand"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
