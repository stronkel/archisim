family "Aparcabicis"
  category street
  host none
  version 2
  description "Aparcabicis de arcos en fila; el punto de inserción es el centro del primer arco"
  folder "Mobiliario urbano"

type_params
  section "Dimensiones"
    count  integer = 5 range 1..20 label "Arcos"
    step   length = 0.80 range 0.50..1.50 label "Separación"
    width  length = 0.70 range 0.40..1.20 label "Ancho del arco"
    height length = 0.80 range 0.50..1.20 label "Altura"
  section "Materiales"
    mat material = "Metal lacado" label "Arcos"
  section "Modelo 3D"
    model3d choice("U invertida", "Onda", "Soporte de rueda") = "U invertida" label "Modelo 3D"

body
  repeat i in 0..count
    let x = i * step
    box (x - 0.025, -width / 2, 0) to (x + 0.025, -width / 2 + 0.05, height) material mat
    box (x - 0.025, width / 2 - 0.05, 0) to (x + 0.025, width / 2, height) material mat
    box (x - 0.025, -width / 2, height - 0.05) to (x + 0.025, width / 2, height) material mat

plan 1:50
  repeat i in 0..count
    let x = i * step
    polygon (x - 0.025, -width / 2) (x + 0.025, -width / 2) (x + 0.025, width / 2) (x - 0.025, width / 2) pen view

plan presentation
  repeat i in 0..count
    let x = i * step
    polygon (x - 0.025, -width / 2) (x + 0.025, -width / 2) (x + 0.025, width / 2) (x - 0.025, width / 2) pen thin tint mat

outputs
  generator = "props:bike_rack"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
