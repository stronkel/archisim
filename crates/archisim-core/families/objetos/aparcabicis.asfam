family "Aparcabicis"
  category street
  host none
  version 3
  description "Aparcabicis como lo hace cada colección; el punto de inserción es el centro del primer arco"
  folder "Mobiliario urbano"

type_params
  section "Dimensiones"
    count  integer = 3 range 1..20 label "Arcos"
    step   length = 0.80 range 0.50..1.50 label "Separación"
    width  length = 0.70 range 0.40..1.20 label "Ancho del arco"
    height length = 0.80 range 0.50..1.20 label "Altura"
  section "Materiales"
    frame material = "Roble claro" label "Madera"
    metal material = "Metal negro" label "Metal"
    mat material = "Hormigón pulido" label "Cuerpo (hormigón, piedra, acero)"
    masonry material = "Cal blanca" label "Obra"
    top material = "Piedra caliza" label "Piedra de remate"
    accent material = "Cerámica esmaltada" label "Azulejo o color"
    pot_mat material = "Hormigón pulido" label "Jardinera"
    soil material = "Tierra" label "Tierra"
    stem material = "Espiga" label "Tronco y tallos"
    leaves material = "Gramínea" label "Hojas"
    leaves2 material = "Hoja verde tierna" label "Hojas claras"
    flowers material = "Espiga" label "Flores y espigas"
    light material = "Luz de farola" label "Luz"
    water material = "Agua de fuente" label "Agua"
    dark material = "Metal negro" label "Huecos y rejillas"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

body
  repeat i in 0..count
    let x = i * step
    box (x - 0.025, -width / 2, 0) to (x + 0.025, width / 2, height) material metal

plan 1:50
  repeat i in 0..count
    let x = i * step
    polygon (x - 0.025, -width / 2) (x + 0.025, -width / 2) (x + 0.025, width / 2) (x - 0.025, width / 2) pen view

plan presentation
  repeat i in 0..count
    let x = i * step
    polygon (x - 0.025, -width / 2) (x + 0.025, -width / 2) (x + 0.025, width / 2) (x - 0.025, width / 2) pen thin tint mat

outputs
  generator = "props:bike_rack"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
