family "Pista de baloncesto"
  category street
  host none
  version 1
  description "Pista de baloncesto de 28 × 15 m con sus líneas, zonas pintadas y una canasta en cada fondo, sobre su zona de seguridad (32 × 19 m)"
  folder "Pistas deportivas"

type_params
  section "Materiales"
    court   material = "Pista verde" label "Pista"
    ground  material = "Pista terracota" label "Zona de seguridad"
    line    material = "Línea blanca" label "Líneas"
    key     material = "Pista azul" label "Zonas"
    accent  material = "Naranja" label "Aros y protectores"
    frame   material = "Metal negro" label "Mástiles"
    dark    material = "Goma negra" label "Bases"
    board   material = "Lacado blanco" label "Tableros"
    net     material = "Red blanca" label "Redes"

body
  box (-16, 0, 0) to (16, 19, 3.7) material court

plan 1:50
  polygon (-16, 0) (16, 0) (16, 19) (-16, 19) pen thin
  polygon (-14, 2) (14, 2) (14, 17) (-14, 17) pen view
  line (0, 2) to (0, 17) pen view

outputs
  generator = "props:fine_basketball_court"
  ifc_class = "IfcBuildingElementProxy"
  ifc_type = "USERDEFINED"
