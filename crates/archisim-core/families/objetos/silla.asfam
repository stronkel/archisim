family "Silla"
  category furniture
  host none
  version 2
  description "Silla de cuatro patas con respaldo"
  folder "Sillas"

type_params
  section "Dimensiones"
    width  length = 0.45 range 0.30..1.00 label "Ancho"
    depth  length = 0.50 range 0.30..1.00 label "Fondo"
    seat   length = 0.45 range 0.30..0.80 label "Altura del asiento"
    height length = 0.90 range 0.50..1.40 label "Altura del respaldo"
  section "Materiales"
    frame    material = "Roble claro" label "Madera"
    mat      material = "Lino arena" label "Tapicería"
    weave    material = "Enea" label "Asiento de enea o cordel"
    metal    material = "Metal negro" label "Metal"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

require seat + 0.1 < height else "El respaldo tiene que subir por encima del asiento"

body
  let l = 0.04
  box (-width / 2, 0, seat - 0.04) to (width / 2, depth, seat) material mat
  box (-width / 2, 0, seat) to (width / 2, 0.04, height) material mat
  box (-width / 2, 0, 0) to (-width / 2 + l, l, seat - 0.04) material mat
  box (width / 2 - l, 0, 0) to (width / 2, l, seat - 0.04) material mat
  box (-width / 2, depth - l, 0) to (-width / 2 + l, depth, seat - 0.04) material mat
  box (width / 2 - l, depth - l, 0) to (width / 2, depth, seat - 0.04) material mat

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view
  line (-width / 2, 0.04) to (width / 2, 0.04) pen thin

outputs
  generator = "props:fine_chair"
  ifc_class = "IfcFurniture"
  ifc_type = "CHAIR"
