family "Chimenea"
  category furniture
  host none
  version 2
  description "Chimenea de obra con repisa y hogar, estufa de leña con su tubo o chimenea moderna lineal; el fuego se enciende de noche"
  folder "Salón"

type_params
  section "Dimensiones"
    width  length = 1.40 range 0.60..4.00 label "Ancho"
    depth  length = 0.50 range 0.30..1.20 label "Fondo"
    height length = 2.50 range 1.00..4.00 label "Altura (hasta el techo)"
  section "Materiales"
    mat      material = "Enlucido de yeso" label "Revestimiento"
    stone    material = "Piedra gris" label "Piedra"
    frame    material = "Roble claro" label "Madera"
    metal    material = "Metal negro" label "Metal"
    dark     material = "Negro mate" label "Hogar"
    glass    material = "Vidrio claro" label "Vidrio"
    wood     material = "Corteza" label "Leña"
    flame    material = "Luz" label "Llamas"
    flame2   material = "Luz" label "Corazón de las llamas"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica", "Colgante") = "Nórdico cálido" label "Modelo 3D"
    fire   bool = yes label "Con llamas"
    logs   bool = yes label "Con leña"

body
  box (-width / 2, 0, 0) to (width / 2, depth, height) material mat

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view
  polygon (-width * 0.28, depth * 0.5) (width * 0.28, depth * 0.5) (width * 0.28, depth) (-width * 0.28, depth) pen thin

outputs
  generator = "props:fine_fireplace"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
