family "Butaca"
  category furniture
  host none
  version 3
  description "Butaca de orejas, redonda, de ratán o baja de patas"
  folder "Sofás y sillones"

include "muebles"

type_params
  section "Dimensiones"
    width  length = 0.80 range 0.55..1.30 label "Ancho"
    depth  length = 0.80 range 0.55..1.20 label "Fondo"
    seat   length = 0.42 range 0.30..0.55 label "Altura del asiento"
    height length = 0.95 range 0.60..1.30 label "Altura del respaldo"
  section "Materiales"
    mat      material = "Terciopelo salvia" label "Tapicería"
    cushion  material = "Lino arena" label "Cojín"
    frame    material = "Roble claro" label "Madera y patas"
    weave    material = "Ratán" label "Ratán"
    metal    material = "Metal negro" label "Metal"
    pillow   material = "Terciopelo mostaza" label "Cojín suelto"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

require seat + 0.15 < height else "El respaldo tiene que subir por encima del asiento"

body
  box (-width / 2, 0, 0) to (width / 2, depth, seat) material mat
  box (-width / 2, 0, seat) to (width / 2, 0.15, height) material mat

plan 1:50
  let arm = min(0.14, width / 5)
  use soft_box(-width / 2, 0, width / 2, depth, 0.1)
  use soft_pad(-width / 2 + 0.02, 0.02, -width / 2 + arm - 0.01, depth - 0.03, 0.06)
  use soft_pad(width / 2 - arm + 0.01, 0.02, width / 2 - 0.02, depth - 0.03, 0.06)
  use soft_pad(-width / 2 + arm + 0.01, 0.03, width / 2 - arm - 0.01, 0.19, 0.05)
  use soft_pad(-width / 2 + arm + 0.01, 0.2, width / 2 - arm - 0.01, depth - 0.04, 0.07)

outputs
  generator = "props:fine_armchair"
  ifc_class = "IfcFurniture"
  ifc_type = "CHAIR"
