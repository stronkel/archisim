family "Escritorio"
  category furniture
  host none
  version 2
  description "Escritorio como lo hace cada colección, con o sin cajonera"
  folder "Despacho"

type_params
  section "Dimensiones"
    width  length = 1.40 range 0.80..3.00 label "Ancho"
    depth  length = 0.70 range 0.50..1.00 label "Fondo"
    height length = 0.75 range 0.65..1.10 label "Altura"
  section "Frentes"
    pedestal choice("Sin cajonera", "A la izquierda", "A la derecha") = "A la derecha" label "Cajonera"
    drawers integer = 3 range 1..6 label "Cajones"
  section "Materiales"
    top    material = "Roble claro" label "Tablero"
    frame  material = "Roble claro" label "Patas y estructura"
    front  material = "Roble claro" label "Cajones"
    metal  material = "Latón" label "Tiradores y herrajes"
    accent material = "Terciopelo verde botella" label "Tapete de escribir"
    dark   material = "Metal negro" label "Acero negro"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

body
  box (-width / 2, 0, height - 0.03) to (width / 2, depth, height) material top

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view

plan 1:100
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view

outputs
  generator = "props:desk"
  ifc_class = "IfcFurniture"
  ifc_type = "DESK"
