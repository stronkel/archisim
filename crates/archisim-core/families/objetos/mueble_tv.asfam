family "Mueble TV"
  category furniture
  host none
  version 3
  description "Mueble bajo de salón con televisor"
  folder "Salón"

type_params
  section "Dimensiones"
    width  length = 1.80 range 0.80..4.00 label "Largo"
    depth  length = 0.42 range 0.30..0.60 label "Fondo"
    height length = 0.45 range 0.30..0.80 label "Altura"
  section "Frentes"
  section "Materiales"
    frame    material = "Roble claro" label "Mueble"
    front    material = "Roble claro" label "Puertas y cajones"
    top      material = "Roble claro" label "Encimera"
    stone    material = "Mármol" label "Piedra"
    metal    material = "Latón" label "Metal y tiradores"
    glass    material = "Vidrio claro" label "Vidrio"
    weave    material = "Ratán" label "Rejilla y cestas"
    dark     material = "Negro mate" label "Detalles oscuros"
    books    material = "Lomo granate" label "Libros"
    books2   material = "Lomo azul" label "Libros (2)"
    books3   material = "Lomo ocre" label "Libros (3)"
    ceramic  material = "Cerámica blanca" label "Cerámica"
    screen   material = "Pantalla de televisor" label "Pantalla"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"
    television bool = yes label "Con televisor"

body
  box (-width / 2, 0, 0) to (width / 2, depth, height) material frame

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view
  let sw = min(width * 0.75, 1.6)
  line (-sw / 2, depth * 0.4) to (sw / 2, depth * 0.4) pen view
  line (-sw / 2, depth * 0.4 + 0.03) to (sw / 2, depth * 0.4 + 0.03) pen thin

plan 1:100
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view

outputs
  generator = "props:fine_tv_unit"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
