family "Cama infantil"
  category furniture
  host none
  version 5
  description "Cama infantil como la hace cada colección: la cama de la colección más baja, con barrera, ropa de cama y un muñeco"
  folder "Camas"

include "muebles"

type_params
  section "Dimensiones"
    width length = 0.90 range 0.70..1.40 label "Ancho del colchón"
    depth length = 1.90 range 1.40..2.10 label "Largo del colchón"
  section "Ropa de cama"
    spread   bool = yes label "Manta a los pies"
    cushions integer = 1 range 0..4 label "Cojines"
    toy      bool = yes label "Muñeco"
  section "Materiales"
    frame material = "Roble claro" label "Madera o estructura"
    metal material = "Latón" label "Metal"
    weave material = "Enea" label "Rejilla o enea"
    dark material = "Fresno oscuro" label "Sombras y cuero"
    cushion material = "Bouclé crudo" label "Tapizado"
    linen material = "Lino blanco" label "Sábanas y almohadas"
    duvet material = "Lino arena" label "Edredón"
    spread_mat material = "Lana teja" label "Manta"
    pillow material = "Terciopelo salvia" label "Cojines"
    toy_mat material = "Lana cruda" label "Muñeco"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

body
  box (-width / 2, 0, 0) to (width / 2, depth + 0.12, 0.45) material linen

plan 1:50
  use soft_box(-width / 2 - 0.05, 0, width / 2 + 0.12, 0.08, 0.02)
  use soft_box(-width / 2 - 0.05, 0.08, width / 2 + 0.12, depth + 0.12, 0.05)
  use pillow(0, 0.3, width / 2 - 0.1, 0.15)
  polygon (-width / 2 - 0.03 + 0.0 * (width / 2 + 0.03 - (-width / 2 - 0.03)), 0.6 + 0.0 * (depth + 0.07 - (0.6)) + 0) (-width / 2 - 0.03 + 0.1667 * (width / 2 + 0.03 - (-width / 2 - 0.03)), 0.6 + 0.0 * (depth + 0.07 - (0.6)) + 0.0025) (-width / 2 - 0.03 + 0.3333 * (width / 2 + 0.03 - (-width / 2 - 0.03)), 0.6 + 0.0 * (depth + 0.07 - (0.6)) + 0.0048) (-width / 2 - 0.03 + 0.5 * (width / 2 + 0.03 - (-width / 2 - 0.03)), 0.6 + 0.0 * (depth + 0.07 - (0.6)) + 0.0059) (-width / 2 - 0.03 + 0.6667 * (width / 2 + 0.03 - (-width / 2 - 0.03)), 0.6 + 0.0 * (depth + 0.07 - (0.6)) + 0.0088) (-width / 2 - 0.03 + 0.8333 * (width / 2 + 0.03 - (-width / 2 - 0.03)), 0.6 + 0.0 * (depth + 0.07 - (0.6)) + 0.0048) (-width / 2 - 0.03 + 1.0 * (width / 2 + 0.03 - (-width / 2 - 0.03)) + 0, 0.6 + 0.0 * (depth + 0.07 - (0.6))) (-width / 2 - 0.03 + 1.0 * (width / 2 + 0.03 - (-width / 2 - 0.03)) + 0.0084, 0.6 + 0.1667 * (depth + 0.07 - (0.6))) (-width / 2 - 0.03 + 1.0 * (width / 2 + 0.03 - (-width / 2 - 0.03)) + -0.0094, 0.6 + 0.3333 * (depth + 0.07 - (0.6))) (-width / 2 - 0.03 + 1.0 * (width / 2 + 0.03 - (-width / 2 - 0.03)) + -0.0007, 0.6 + 0.5 * (depth + 0.07 - (0.6))) (-width / 2 - 0.03 + 1.0 * (width / 2 + 0.03 - (-width / 2 - 0.03)) + 0.0089, 0.6 + 0.6667 * (depth + 0.07 - (0.6))) (-width / 2 - 0.03 + 1.0 * (width / 2 + 0.03 - (-width / 2 - 0.03)) + 0.003, 0.6 + 0.8333 * (depth + 0.07 - (0.6))) (-width / 2 - 0.03 + 1.0 * (width / 2 + 0.03 - (-width / 2 - 0.03)), 0.6 + 1.0 * (depth + 0.07 - (0.6)) + 0) (-width / 2 - 0.03 + 0.8333 * (width / 2 + 0.03 - (-width / 2 - 0.03)), 0.6 + 1.0 * (depth + 0.07 - (0.6)) + 0.008) (-width / 2 - 0.03 + 0.6667 * (width / 2 + 0.03 - (-width / 2 - 0.03)), 0.6 + 1.0 * (depth + 0.07 - (0.6)) + -0.0077) (-width / 2 - 0.03 + 0.5 * (width / 2 + 0.03 - (-width / 2 - 0.03)), 0.6 + 1.0 * (depth + 0.07 - (0.6)) + -0.0006) (-width / 2 - 0.03 + 0.3333 * (width / 2 + 0.03 - (-width / 2 - 0.03)), 0.6 + 1.0 * (depth + 0.07 - (0.6)) + -0.0051) (-width / 2 - 0.03 + 0.1667 * (