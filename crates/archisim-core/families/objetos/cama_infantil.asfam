  polygon (-width / 2 - 0.03 + 0.0 * (width / 2 + 0.03 - (-width / 2 - 0.03)), 0.6 + 0.0 * (0.77 - (0.6)) + 0) (-width / 2 - 0.03 + 0.2 * (width / 2 + 0.03 - (-width / 2 - 0.03)), 0.6 + 0.0 * (0.77 - (0.6)) + -0.0034) (-width / 2 - 0.03 + 0.4 * (width / 2 + 0.03 - (-width / 2 - 0.03)), 0.6 + 0.0 * (0.77 - (0.6)) + 0.0026) (-width / 2 - 0.03 + 0.6 * (width / 2 + 0.03 - (-width / 2 - 0.03)), 0.6 + 0.0 * (0.77 - (0.6)) + 0.0026) (-width / 2 - 0.03 + 0.8 * (width / 2 + 0.03 - (-width / 2 - 0.03)), 0.6 + 0.0 * (0.77 - (0.6)) + 0.0049) (-width / 2 - 0.03 + 1.0 * (width / 2 + 0.03 - (-width / 2 - 0.03)) + 0, 0.6 + 0.0 * (0.77 - (0.6))) (-width / 2 - 0.03 + 1.0 * (width / 2 + 0.03 - (-width / 2 - 0.03)) + -0.0044, 0.6 + 0.2 * (0.77 - (0.6))) (-width / 2 - 0.03 + 1.0 * (width / 2 + 0.03 - (-width / 2 - 0.03)) + -0.0038, 0.6 + 0.4 * (0.77 - (0.6))) (-width / 2 - 0.03 + 1.0 * (width / 2 + 0.03 - (-width / 2 - 0.03)) + -0.0049, 0.6 + 0.6 * (0.77 - (0.6))) (-width / 2 - 0.03 + 1.0 * (width / 2 + 0.03 - (-width / 2 - 0.03)) + -0.0038, 0.6 + 0.8 * (0.77 - (0.6))) (-width / 2 - 0.03 + 1.0 * (width / 2 + 0.03 - (-width / 2 - 0.03)), 0.6 + 1.0 * (0.77 - (0.6)) + 0) (-width / 2 - 0.03 + 0.8 * (width / 2 + 0.03 - (-width / 2 - 0.03)), 0.6 + 1.0 * (0.77 - (0.6)) + 0.0033) (-width / 2 - 0.03 + 0.6 * (width / 2 + 0.03 - (-width / 2 - 0.03)), 0.6 + 1.0 * (0.77 - (0.6)) + -0.0052) (-width / 2 - 0.03 + 0.4 * (width / 2 + 0.03 - (-width / 2 - 0.03)), 0.6 + 1.0 * (0.77 - (0.6)) + 0.0004) (-width / 2 - 0.03 + 0.2 * (width / 2 + 0.03 - (-width / 2 - 0.03)), 0.6 + 1.0 * (0.77 - (0.6)) + -0.004) (-width / 2 - 0.03 + 0.0 * (width / 2 + 0.03 - (-width / 2 - 0.03)) + 0, 0.6 + 1.0 * (0.77 - (0.6))) (-width / 2 - 0.03 + 0.0 * (width / 2 + 0.03 - (-width / 2 - 0.03)) + -0.0029, 0.6 + 0.8 * (0.77 - (0.6))) (-width / 2 - 0.03 + 0.0 * (width / 2 + 0.03 - (-width / 2 - 0.03)) + -0.001, 0.6 + 0.6 * (0.77 - (0.6))) (-width / 2 - 0.03 + 0.0 * (width / 2 + 0.03 - (-width / 2 - 0.03)) + 0.0047, 0.6 + 0.4 * (0.77 - (0.6))) (-width / 2 - 0.03 + 0.0 * (width / 2 + 0.03 - (-width / 2 - 0.03)) + 0.0015, 0.6 + 0.2 * (0.77 - (0.6))) pen thin filled
  polygon (width / 2 - 0.3, 0.77) (width / 2 + 0.03, 0.77) (width / 2 + 0.03, 1.02) pen thin filled
  arc center (-width / 2 + 0.1, 1.25) from (-width / 2 + 0.1, 0.92) to (-width / 2 + 0.36, 1.08) pen thin
  arc center (width * 0.1, 1.5) from (-width * 0.05, 1.08) to (width * 0.2, 1.12) pen thin

outputs
  generator = "props:kids_bed"
  ifc_class = "IfcFurniture"
  ifc_type = "BED"
