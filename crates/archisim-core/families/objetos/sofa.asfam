family "Sofá"
  category furniture
  host none
  version 6
  description "Sofá recto con brazos y respaldo"
  folder "Sofás y sillones"

include "muebles"

type_params
  section "Dimensiones"
    width  length = 2.00 range 0.80..4.00 label "Largo"
    depth  length = 0.90 range 0.60..1.20 label "Fondo"
    seat   length = 0.42 range 0.30..0.60 label "Altura del asiento"
    height length = 0.80 range 0.60..1.20 label "Altura del respaldo"
    places integer = 3 range 1..5 label "Plazas"
  section "Materiales"
    mat      material = "Lino arena" label "Tapicería"
    cushion  material = "Lino arena" label "Cojines"
    frame    material = "Roble claro" label "Madera y patas"
    metal    material = "Metal negro" label "Metal"
    weave    material = "Ratán" label "Rejilla"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"
  section "Decoración"
    pillows integer = 0 range 0..4 label "Cojines sueltos"
    pillow  material = "Terciopelo mostaza" label "Cojines sueltos"
    throw   bool = no label "Manta doblada en el asiento"
    throw_mat material = "Lana teja" label "Manta"

require 0.5 < width - 0.4 else "No caben los brazos"
require seat + 0.1 < height else "El respaldo tiene que subir por encima del asiento"

body
  box (-width / 2, 0, 0) to (width / 2, 0.2, height) material mat
  box (-width / 2, 0.2, 0) to (-width / 2 + 0.2, depth, 0.6) material mat
  box (width / 2 - 0.2, 0.2, 0) to (width / 2, depth, 0.6) material mat
  box (-width / 2 + 0.2, 0.2, 0) to (width / 2 - 0.2, depth, seat) material mat

plan 1:50
  let arm = min(0.2, width / 6)
  use soft_box(-width / 2, 0, width / 2, depth, 0.08)
  use soft_pad(-width / 2 + 0.02, 0.02, -width / 2 + arm - 0.01, depth - 0.02, 0.06)
  use soft_pad(width / 2 - arm + 0.01, 0.02, width / 2 - 0.02, depth - 0.02, 0.06)
  let pw = (width - 2 * arm) / places
  repeat i in 0..places
    let a = -width / 2 + arm + i * pw
    use soft_pad(a + 0.01, 0.03, a + pw - 0.01, 0.21, 0.05)
    use soft_pad(a + 0.01, 0.22, a + pw - 0.01, depth - 0.04, 0.06)

outputs
  # Placed against another of its kind, in line: one, as wide as both.
  joins = "width"
  generator = "props:fine_sofa"
  ifc_class = "IfcFurniture"
  ifc_type = "SOFA"

# Stretched by its handles, a seat more (or less) when the seats would be
# too wide (or narrow): as in Paralives, the sofa grows by pieces.
stretch
  places = if (width - 0.4) / places >= 0.5 and (width - 0.4) / places <= 0.8 then places else (width - 0.4) / 0.62
