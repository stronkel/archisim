family "Aparador"
  category furniture
  host none
  version 3
  description "Aparador bajo de patas con puertas y cajones, o con puertas de lamas"
  folder "Salón"

type_params
  section "Dimensiones"
    width  length = 1.60 range 0.60..3.00 label "Largo"
    depth  length = 0.45 range 0.30..0.60 label "Fondo"
    height length = 0.75 range 0.40..1.20 label "Altura"
  section "Materiales"
    frame    material = "Roble claro" label "Mueble"
    front    material = "Roble claro" label "Puertas y cajones"
    top      material = "Roble claro" label "Encimera"
    stone    material = "Mármol" label "Piedra"
    metal    material = "Latón" label "Metal y tiradores"
    glass    material = "Vidrio claro" label "Vidrio"
    weave    material = "Ratán" label "Rejilla"
    dark     material = "Negro mate" label "Detalles oscuros"
    ceramic  material = "Cerámica blanca" label "Cerámica"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

body
  box (-width / 2, 0, 0.18) to (width / 2, depth, height) material frame

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view
  line (-width / 2, depth - 0.02) to (width / 2, depth - 0.02) pen thin

outputs
  # Placed against another of its kind, in line: one, as wide as both.
  joins = "width"
  generator = "props:fine_sideboard"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
