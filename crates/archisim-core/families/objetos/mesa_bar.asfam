family "Mesa de bar"
  category furniture
  host none
  version 2
  description "Mesa de cafetería como la hace cada colección, baja o alta"
  folder "Hostelería"

include "muebles"

type_params
  section "Dimensiones"
    width  length = 0.60 range 0.45..1.20 label "Tablero"
    height length = 0.75 range 0.70..1.15 label "Altura"
  section "Materiales"
    top     material = "Roble claro" label "Tablero"
    frame   material = "Roble claro" label "Madera"
    metal   material = "Hierro forjado" label "Metal"
    dark    material = "Metal negro" label "Hierro o acero"
    accent  material = "Cerámica esmaltada" label "Azulejo o laminado"
    masonry material = "Cal blanca" label "Llagas"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

body
  box (-width / 2, 0, 0) to (width / 2, width, height) material top

plan 1:50
  use soft_oval(0, width / 2, width / 2, width / 2)
  use soft_oval_thin(0, width / 2, width / 2 - 0.03, width / 2 - 0.03)

outputs
  generator = "props:fine_bar_table"
  ifc_class = "IfcFurniture"
  ifc_type = "TABLE"
