family "Cama"
  category furniture
  host none
  version 6
  description "Cama como la hace cada colección: cabecero, estructura, colchón, edredón con la sábana vuelta, almohadas, manta a los pies y cojines"
  folder "Camas"

include "muebles"

type_params
  section "Dimensiones"
    width  length = 1.50 range 0.80..2.20 label "Ancho del colchón"
    depth  length = 2.05 range 1.80..2.40 label "Largo"
    height length = 0.52 range 0.25..0.80 label "Altura del colchón"
    head   length = 1.10 range 0.50..1.60 label "Altura del cabecero"
  section "Ropa de cama"
    spread   bool = yes label "Manta a los pies"
    cushions integer = 2 range 0..4 label "Cojines"
  section "Materiales"
    frame material = "Roble claro" label "Madera o estructura"
    front material = "Lacado blanco" label "Frentes"
    top material = "Roble claro" label "Encimera"
    stone material = "Mármol" label "Piedra"
    plinth material = "Roble claro" label "Zócalo"
    metal material = "Latón" label "Tiradores y metal"
    glass material = "Vidrio claro" label "Vidrio"
    weave material = "Enea" label "Rejilla o enea"
    dark material = "Fresno oscuro" label "Sombras y cuero"
    cushion material = "Bouclé crudo" label "Tapizado"
    linen material = "Lino blanco" label "Sábanas y almohadas"
    duvet material = "Lino arena" label "Edredón"
    spread_mat material = "Terciopelo salvia" label "Manta"
    pillow material = "Terciopelo salvia" label "Cojines"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

require height + 0.1 < head else "El cabecero tiene que subir por encima del colchón"

body
  box (-width / 2, 0, 0) to (width / 2, 0.08, head) material frame
  box (-width / 2, 0.08, 0) to (width / 2, depth, height) material linen

plan 1:50
  use soft_box(-width / 2 - 0.06, 0, width / 2 + 0.06, 0.08, 0.02)
  use soft_box(-width / 2 - 0.03, 0.08, width / 2 + 0.03, depth, 0.05)
  # Pillows, a little apart and askew.
  let pillows = if width >= 1.2 then 2 else 1
  let pw = (width - 0.12 - 0.06 * (pillows - 1)) / pillows
  repeat i in 0..pillows
    let a = -width / 2 + 0.06 + i * (pw + 0.06)
    use pillow(a + pw / 2, 0.3 + 0.015 * i, pw / 2, 0.16)
  # The duvet, rumpled, hanging a little over the sides.
  polygon (-width / 2 - 0.05 + 0.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 0.0 * (depth - 0.02 - (0.6)) + 0) (-width / 2 - 0.05 + 0.1429 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 0.0 * (depth - 0.02 - (0.6)) + -0.0063) (-width / 2 - 0.05 + 0.2857 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 0.0 * (depth - 0.02 - (0.6)) + 0.0011) (-width / 2 - 0.05 + 0.4286 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 0.0 * (depth - 0.02 - (0.6)) + -0.0031) (-width / 2 - 0.05 + 0.5714 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 0.0 * (depth - 0.02 - (0.6)) + 0.0025) (-width / 2 - 0.05 + 0.7143 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 0.0 * (depth - 0.02 - (0.6)) + 0.003) (-width / 2 - 0.05 + 0.8571 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 0.0 * (depth - 0.02 - (0.6)) + -0.0104) (-width / 2 - 0.05 + 1.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + 0, 0.6 + 0.0 * (depth - 0.02 - (0.6))) (-width / 2 - 0.05 + 1.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + -0.0117, 0.6 + 0.1429 * (depth - 0.02 - (0.6))) (-width / 2 - 0.05 + 1.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + 0.0081, 0.6 + 0.2857 * (depth - 0.02 - (0.6))) (-width / 2 - 0.05 + 1.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + -0.0058, 0.6 + 0.4286 * (depth - 0.02 - (0.6))) (-width / 2 - 0.05 + 1.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + -0.0064, 0.6 + 0.5714 * (depth - 0.02 - (0.6))) (-width / 2 - 0.05 + 1.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + 0.0119, 0.6 + 0.7143 * (depth - 0.02 - (0.6))) (-width / 2 - 0.05 + 1.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + -0.0007, 0.6 + 0.8571 * (depth - 0.02 - (0.6))) (-width / 2 - 0.05 + 1.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 1.0 * (depth - 0.02 - (0.6)) + 0) (-width / 2 - 0.05 + 0.8571 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 1.0 * (depth - 0.02 - (0.6)) + 0.0081) (-width / 2 - 0.05 + 0.7143 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 1.0 * (depth - 0.02 - (0.6)) + -0.0006) (-width / 2 - 0.05 + 0.5714 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 1.0 * (depth - 0.02 - (0.6)) + 0.0033) (-width / 2 - 0.05 + 0.4286 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 1.0 * (depth - 0.02 - (0.6)) + -0.0084) (-width / 2 - 0.05 + 0.2857 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 1.0 * (depth - 0.02 - (0.6)) + 0.0032) (-width / 2 - 0.05 + 0.1429 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 1.0 * (depth - 0.02 - (0.6)) + 0.0088) (-width / 2 - 0.05 + 0.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + 0, 0.6 + 1.0 * (depth - 0.02 - (0.6))) (-width / 2 - 0.05 + 0.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + 0.0006, 0.6 + 0.8571 * (depth - 0.02 - (0.6))) (-width / 2 - 0.05 + 0.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + 0.0058, 0.6 + 0.7143 * (depth - 0.02 - (0.6))) (-width / 2 - 0.05 + 0.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + 0.0041, 0.6 + 0.5714 * (depth - 0.02 - (0.6))) (-width / 2 - 0.05 + 0.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + -0.0105, 0.6 + 0.4286 * (depth - 0.02 - (0.6))) (-width / 2 - 0.05 + 0.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + 0.0062, 0.6 + 0.2857 * (depth - 0.02 - (0.6))) (-width / 2 - 0.05 + 0.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + 0.0022, 0.6 + 0.1429 * (depth - 0.02 - (0.6))) pen view filled
  # Its top folded back.
  polygon (-width / 2 - 0.05 + 0.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 0.0 * (0.79 - (0.6)) + 0) (-width / 2 - 0.05 + 0.1667 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 0.0 * (0.79 - (0.6)) + -0.0008) (-width / 2 - 0.05 + 0.3333 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 0.0 * (0.79 - (0.6)) + 0.001) (-width / 2 - 0.05 + 0.5 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 0.0 * (0.79 - (0.6)) + 0.0068) (-width / 2 - 0.05 + 0.6667 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 0.0 * (0.79 - (0.6)) + -0.0005) (-width / 2 - 0.05 + 0.8333 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 0.0 * (0.79 - (0.6)) + 0.0001) (-width / 2 - 0.05 + 1.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + 0, 0.6 + 0.0 * (0.79 - (0.6))) (-width / 2 - 0.05 + 1.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + 0.0014, 0.6 + 0.1667 * (0.79 - (0.6))) (-width / 2 - 0.05 + 1.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + -0.005, 0.6 + 0.3333 * (0.79 - (0.6))) (-width / 2 - 0.05 + 1.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + 0.0002, 0.6 + 0.5 * (0.79 - (0.6))) (-width / 2 - 0.05 + 1.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + 0.0021, 0.6 + 0.6667 * (0.79 - (0.6))) (-width / 2 - 0.05 + 1.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + 0.0047, 0.6 + 0.8333 * (0.79 - (0.6))) (-width / 2 - 0.05 + 1.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 1.0 * (0.79 - (0.6)) + 0) (-width / 2 - 0.05 + 0.8333 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 1.0 * (0.79 - (0.6)) + -0.0065) (-width / 2 - 0.05 + 0.6667 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 1.0 * (0.79 - (0.6)) + -0.0031) (-width / 2 - 0.05 + 0.5 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 1.0 * (0.79 - (0.6)) + -0.0065) (-width / 2 - 0.05 + 0.3333 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 1.0 * (0.79 - (0.6)) + 0.005) (-width / 2 - 0.05 + 0.1667 * (width / 2 + 0.05 - (-width / 2 - 0.05)), 0.6 + 1.0 * (0.79 - (0.6)) + 0.0031) (-width / 2 - 0.05 + 0.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + 0, 0.6 + 1.0 * (0.79 - (0.6))) (-width / 2 - 0.05 + 0.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + -0.0073, 0.6 + 0.8333 * (0.79 - (0.6))) (-width / 2 - 0.05 + 0.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + 0.0077, 0.6 + 0.6667 * (0.79 - (0.6))) (-width / 2 - 0.05 + 0.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + 0.0074, 0.6 + 0.5 * (0.79 - (0.6))) (-width / 2 - 0.05 + 0.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + 0.0025, 0.6 + 0.3333 * (0.79 - (0.6))) (-width / 2 - 0.05 + 0.0 * (width / 2 + 0.05 - (-width / 2 - 0.05)) + 0.0018, 0.6 + 0.1667 * (0.79 - (0.6))) pen thin filled
  # A corner turned down.
  polygon (width / 2 - 0.4, 0.79) (width / 2 + 0.05, 0.79) (width / 2 + 0.05, 1.15) pen thin filled
  arc center (width / 2 - 0.4, 1.3) from (width / 2 - 0.4, 0.79) to (width / 2 + 0.05, 1.15) pen thin
  # Soft creases of the duvet.
  arc center (-width / 2 + 0.1, 1.3) from (-width / 2 + 0.1, 0.95) to (-width / 2 + 0.38, 1.12) pen thin
  arc center (width * 0.05, 1.5) from (-width * 0.08, 1.02) to (width * 0.18, 1.06) pen thin
  arc center (width * 0.3, 1.6) from (width * 0.18, 1.3) to (width * 0.4, 1.36) pen thin
  # A throw at the foot, with its folds.
  polygon (-width / 2 - 0.07 + 0.0 * (width / 2 + 0.07 - (-width / 2 - 0.07)), depth - 0.5 + 0.0 * (depth - 0.15 - (depth - 0.5)) + 0) (-width / 2 - 0.07 + 0.1667 * (width / 2 + 0.07 - (-width / 2 - 0.07)), depth - 0.5 + 0.0 * (depth - 0.15 - (depth - 0.5)) + -0.0063) (-width / 2 - 0.07 + 0.3333 * (width / 2 + 0.07 - (-width / 2 - 0.07)), depth - 0.5 + 0.0 * (depth - 0.15 - (depth - 0.5)) + -0.0126) (-width / 2 - 0.07 + 0.5 * (width / 2 + 0.07 - (-width / 2 - 0.07)), depth - 0.5 + 0.0 * (depth - 0.15 - (depth - 0.5)) + 0.0054) (-width / 2 - 0.07 + 0.6667 * (width / 2 + 0.07 - (-width / 2 - 0.07)), depth - 0.5 + 0.0 * (depth - 0.15 - (depth - 0.5)) + -0.0154) (-width / 2 - 0.07 + 0.8333 * (width / 2 + 0.07 - (-width / 2 - 0.07)), depth - 0.5 + 0.0 * (depth - 0.15 - (depth - 0.5)) + 0.0013) (-width / 2 - 0.07 + 1.0 * (width / 2 + 0.07 - (-width / 2 - 0.07)) + 0, depth - 0.5 + 0.0 * (depth - 0.15 - (depth - 0.5))) (-width / 2 - 0.07 + 1.0 * (width / 2 + 0.07 - (-width / 2 - 0.07)) + -0.0048, depth - 0.5 + 0.1667 * (depth - 0.15 - (depth - 0.5))) (-width / 2 - 0.07 + 1.0 * (width / 2 + 0.07 - (-width / 2 - 0.07)) + -0.0159, depth - 0.5 + 0.3333 * (depth - 0.15 - (depth - 0.5))) (-width / 2 - 0.07 + 1.0 * (width / 2 + 0.07 - (-width / 2 - 0.07)) + 0.0003, depth - 0.5 + 0.5 * (depth - 0.15 - (depth - 0.5))) (-width / 2 - 0.07 + 1.0 * (width / 2 + 0.07 - (-width / 2 - 0.07)) + -0.0167, depth - 0.5 + 0.6667 * (depth - 0.15 - (depth - 0.5))) (-width / 2 - 0.07 + 1.0 * (width / 2 + 0.07 - (-width / 2 - 0.07)) + -0.0024, depth - 0.5 + 0.8333 * (depth - 0.15 - (depth - 0.5))) (-width / 2 - 0.07 + 1.0 * (width / 2 + 0.07 - (-width / 2 - 0.07)), depth - 0.5 + 1.0 * (depth - 0.15 - (depth - 0.5)) + 0) (-width / 2 - 0.07 + 0.8333 * (width / 2 + 0.07 - (-width / 2 - 0.07)), depth - 0.5 + 1.0 * (depth - 0.15 - (depth - 0.5)) + -0.0155) (-width / 2 - 0.07 + 0.6667 * (width / 2 + 0.07 - (-width / 2 - 0.07)), depth - 0.5 + 1.0 * (depth - 0.15 - (depth - 0.5)) + -0.0147) (-width / 2 - 0.07 + 0.5 * (width / 2 + 0.07 - (-width / 2 - 0.07)), depth - 0.5 + 1.0 * (depth - 0.15 - (depth - 0.5)) + -0.0027) (-width / 2 - 0.07 + 0.3333 * (width / 2 + 0.07 - (-width / 2 - 0.07)), depth - 0.5 + 1.0 * (depth - 0.15 - (depth - 0.5)) + 0.0118) (-width / 2 - 0.07 + 0.1667 * (width / 2 + 0.07 - (-width / 2 - 0.07)), depth - 0.5 + 1.0 * (depth - 0.15 - (depth - 0.5)) + -0.0135) (-width / 2 - 0.07 + 0.0 * (width / 2 + 0.07 - (-width / 2 - 0.07)) + 0, depth - 0.5 + 1.0 * (depth - 0.15 - (depth - 0.5))) (-width / 2 - 0.07 + 0.0 * (width / 2 + 0.07 - (-width / 2 - 0.07)) + -0.01, depth - 0.5 + 0.8333 * (depth - 0.15 - (depth - 0.5))) (-width / 2 - 0.07 + 0.0 * (width / 2 + 0.07 - (-width / 2 - 0.07)) + 0.0046, depth - 0.5 + 0.6667 * (depth - 0.15 - (depth - 0.5))) (-width / 2 - 0.07 + 0.0 * (width / 2 + 0.07 - (-width / 2 - 0.07)) + 0.0161, depth - 0.5 + 0.5 * (depth - 0.15 - (depth - 0.5))) (-width / 2 - 0.07 + 0.0 * (width / 2 + 0.07 - (-width / 2 - 0.07)) + 0.0028, depth - 0.5 + 0.3333 * (depth - 0.15 - (depth - 0.5))) (-width / 2 - 0.07 + 0.0 * (width / 2 + 0.07 - (-width / 2 - 0.07)) + -0.0037, depth - 0.5 + 0.1667 * (depth - 0.15 - (depth - 0.5))) pen thin filled
  arc center (-width / 2 + 0.1, depth - 0.1) from (-width / 2 + 0.1, depth - 0.42) to (-width / 2 + 0.38, depth - 0.25) pen thin
  arc center (width / 2 - 0.1, depth - 0.1) from (width / 2 - 0.36, depth - 0.24) to (width / 2 - 0.1, depth - 0.44) pen thin

outputs
  generator = "props:bed"
  ifc_class = "IfcFurniture"
  ifc_type = "BED"
