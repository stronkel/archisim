family "Piano"
  category furniture
  host none
  version 2
  description "Piano de pared con su banqueta, o piano de cola"
  folder "Salón"

include "muebles"

type_params
  section "Dimensiones"
    width length = 1.48 range 1.20..1.60 label "Ancho"
  section "Materiales"
    mat material = "Negro mate" label "Caja"
  section "Modelo 3D"
    model3d choice("De pared", "De cola") = "De pared" label "Modelo 3D"
    light material = "Cerámica blanca" label "Teclas"
    dark  material = "Negro mate" label "Teclas negras"
    frame material = "Lino gris" label "Banqueta"

body
  box (-width / 2, 0, 0) to (width / 2, 0.6, 1.22) material mat

plan 1:50
  if model3d == "De cola"
    # Keyboard at the front (y = 0), the curved case behind it.
    polygon (-0.75, 0.1) (0.75, 0.1) (0.75, 0.9) (0.68, 1.15) (0.55, 1.45) (0.35, 1.7) (0.1, 1.88) (-0.15, 1.95) (-0.75, 1.95) pen view filled
    line (-0.68, 0.3) to (0.62, 0.95) pen thin
    line (-0.68, 0.3) to (-0.68, 1.85) pen thin
    use soft_pad(-0.67, 0, 0.67, 0.15, 0.01)
    repeat i in 1..30
      line (-0.67 + i * 1.34 / 30, 0.02) to (-0.67 + i * 1.34 / 30, 0.13) pen thin
  else
    use soft_box(-width / 2, 0, width / 2, 0.6, 0.03)
    use soft_pad(-width / 2 + 0.06, 0.38, width / 2 - 0.06, 0.56, 0.01)
    repeat i in 1..26
      line (-width / 2 + 0.06 + i * (width - 0.12) / 26, 0.42) to (-width / 2 + 0.06 + i * (width - 0.12) / 26, 0.56) pen thin
    use soft_box(-0.28, 0.85, 0.28, 1.2, 0.04)

outputs
  generator = "props:piano"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
