family "Cojín de suelo"
  category furniture
  host none
  version 1
  description "Cojín de suelo cuadrado y capitoné, redondo (zafu) o una pila de cojines"
  folder "Cojines y mantas"

type_params
  section "Dimensiones"
    width  length = 0.65 range 0.30..1.20 label "Lado o diámetro"
    height length = 0.16 range 0.06..0.40 label "Grueso"
  section "Materiales"
    mat material = "Lino arena" label "Tela"
  section "Modelo 3D"
    model3d choice("Cuadrado", "Zafu", "Pila") = "Cuadrado" label "Modelo 3D"
    mat2   material = "Lana cruda" label "Botones y otra tela"
    accent material = "Terciopelo mostaza" label "Cojín pequeño"

body
  box (-width / 2, 0, 0) to (width / 2, width, height) material mat

plan 1:50
  if model3d == "Zafu"
    let r = width / 2
    repeat i in 0..16
      let t0 = 6.283185307 * i / 16
      let t1 = 6.283185307 * (i + 1) / 16
      line (r * cos(t0), r + r * sin(t0)) to (r * cos(t1), r + r * sin(t1)) pen view
  else
    polygon (-width / 2, 0) (width / 2, 0) (width / 2, width) (-width / 2, width) pen view

outputs
  generator = "props:floor_cushion"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
