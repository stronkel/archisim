family "Planta de interior"
  category furniture
  host none
  version 3
  description "Planta de interior en la maceta de cada colección, hoja a hoja: ficus lira, limonero, costilla de Adán, sansevieria, ave del paraíso, helecho, potos o kentia"
  folder "Plantas de interior"

include "muebles"

type_params
  section "Dimensiones"
    height length = 1.20 range 0.15..3.00 label "Altura con la maceta"
    pot    length = 0.36 range 0.08..1.00 label "Diámetro de la maceta"
  section "Materiales"
    pot_mat material = "Cerámica blanca" label "Maceta"
    frame   material = "Roble claro" label "Soporte de madera"
    metal   material = "Metal negro" label "Soporte de metal"
    weave   material = "Ratán" label "Cesta"
    soil    material = "Tierra" label "Tierra"
    stem    material = "Tallo verde" label "Tronco y tallos"
    leaves  material = "Hoja verde" label "Hojas"
    leaves2 material = "Hoja verde tierna" label "Hojas nuevas"
    flowers material = "Pétalo blanco" label "Flores"
    fruit   material = "Limón" label "Fruta"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

body
  box (-pot / 2, 0, 0) to (pot / 2, pot, height) material leaves

plan 1:50
  use soft_oval(0, pot / 2, pot / 2, pot / 2)
  let r = max(height * 0.35, pot / 2)
  let n = 9
  let turn = 6.283185307 * rand(seed * 7)
  repeat i in 0..n
    let a = turn + 6.283185307 * (i + 0.3 * rand(seed * 13 + i)) / n
    let l = r * (0.7 + 0.3 * rand(seed * 17 + i))
    use leaf(0, pot / 2, l, l * 0.2, a)
  repeat i in 0..5
    let a = turn + 0.35 + 6.283185307 * i / 5
    use leaf(0, pot / 2, r * 0.55, r * 0.13, a)

plan presentation
  use soft_oval(0, pot / 2, pot / 2, pot / 2)
  let r = max(height * 0.35, pot / 2)
  let n = 9
  let turn = 6.283185307 * rand(seed * 7)
  repeat i in 0..n
    let a = turn + 6.283185307 * (i + 0.3 * rand(seed * 13 + i)) / n
    let l = r * (0.7 + 0.3 * rand(seed * 17 + i))
    use leaf(0, pot / 2, l, l * 0.2, a)
  repeat i in 0..5
    let a = turn + 0.35 + 6.283185307 * i / 5
    use leaf(0, pot / 2, r * 0.55, r * 0.13, a)

outputs
  generator = "props:potted_plant"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
