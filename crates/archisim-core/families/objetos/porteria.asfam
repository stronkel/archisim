family "Portería"
  category furniture
  host none
  version 1
  description "Portería de fútbol con su red, de jardín a reglamentaria; la boca mira hacia delante"
  folder "Deporte en casa"

type_params
  section "Dimensiones"
    width  length = 3.00 range 1.20..7.32 label "Ancho"
    height length = 2.00 range 0.80..2.44 label "Altura"
    depth  length = 1.20 range 0.60..2.00 label "Fondo"
  section "Materiales"
    frame   material = "Lacado blanco" label "Postes y bastidor"
    net     material = "Red blanca" label "Red"

body
  box (-width / 2 - 0.05, 0, 0) to (width / 2 + 0.05, depth, height + 0.05) material frame

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view dashed
  line (-width / 2 - 0.05, depth) to (width / 2 + 0.05, depth) pen cut

outputs
  generator = "props:fine_goal"
  ifc_class = "IfcBuildingElementProxy"
  ifc_type = "USERDEFINED"
