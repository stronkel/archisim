family "Alfombra"
  category furniture
  host none
  version 1
  description "Alfombra lisa, redonda, de rayas o bereber; se pisa, así que va en el suelo de la planta"
  folder "Alfombras"

type_params
  section "Dimensiones"
    width     length = 2.00 range 0.40..6.00 label "Largo"
    depth     length = 1.40 range 0.40..6.00 label "Ancho"
    thickness length = 0.012 range 0.004..0.040 label "Grueso"
  section "Materiales"
    mat    material = "Lana cruda" label "Tejido"
    border material = "Lana teja" label "Ribete y rayas"
  section "Modelo 3D"
    model3d choice("Lisa con ribete", "Redonda", "De rayas", "Bereber con flecos") = "Lisa con ribete" label "Modelo 3D"

body
  box (-width / 2, 0, 0) to (width / 2, depth, thickness) material mat

plan 1:50
  if model3d == "Redonda"
    let r = min(width, depth) / 2
    repeat i in 0..24
      let t0 = 6.283185307 * i / 24
      let t1 = 6.283185307 * (i + 1) / 24
      line (r * cos(t0), depth / 2 + r * sin(t0)) to (r * cos(t1), depth / 2 + r * sin(t1)) pen thin
  else
    polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen thin dashed
    polygon (-width / 2 + 0.07, 0.07) (width / 2 - 0.07, 0.07) (width / 2 - 0.07, depth - 0.07) (-width / 2 + 0.07, depth - 0.07) pen thin dotted

plan presentation
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen thin tint mat opacity 0.8

outputs
  generator = "props:rug"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"

# Stretched, a round rug stays round.
stretch
  depth = if model3d == "Redonda" then width else depth
