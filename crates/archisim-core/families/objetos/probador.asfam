family "Probador"
  category furniture
  host none
  version 1
  description "Probador con espejo, perchas, taburete y cortina, como lo hace cada colección"
  folder "Comercio"

type_params
  section "Dimensiones"
    width  length = 1.00 range 0.80..2.00 label "Ancho"
    depth  length = 1.00 range 0.80..2.00 label "Fondo"
    height length = 2.10 range 1.90..2.60 label "Altura"
  section "Materiales"
    frame   material = "Roble claro" label "Madera"
    top     material = "Roble claro" label "Tablero"
    front   material = "Lacado blanco" label "Paneles"
    masonry material = "Cal blanca" label "Fábrica o piedra"
    accent  material = "Cerámica esmaltada" label "Azulejo o color"
    metal   material = "Latón" label "Metal"
    dark    material = "Metal negro" label "Acero negro"
    mirror  material = "Espejo" label "Espejo"
    light   material = "Luz cálida" label "Luz del espejo"
    curtain material = "Lino arena" label "Cortina"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

body
  box (-width / 2, 0, 0) to (width / 2, depth, height) material frame

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view
  line (-width / 2, depth - 0.05) to (width / 2, depth - 0.05) pen thin dashed

outputs
  generator = "props:fine_fitting_room"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
