family "Puerta plegable"
  category door
  host wall
  version 6
  description "Puerta plegable (de librillo) de 2 a 8 hojas que se recogen a un lado, con cerco"

include "piezas"

type_params
  section "Dimensiones"
    width  length = 1.60 range 0.30..20.00 label "Hueco de obra: ancho"
    height length = 2.05 range 0.10..20.00 label "Hueco de obra: alto"
  section "Hojas"
    leaves integer = 4 range 2..8 label "Nº de hojas"
  section "Cerco"
    frame_width length = 0.05 range 0.001..2.00 label "Cerco: anchura vista"
    frame_depth length = 0.07 range 0.001..2.00 label "Cerco: fondo"
  section "Materiales"
    frame_material material = "Madera de pino" label "Cerco"
    panel_material material = "Madera de pino" label "Hoja"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Contemporáneo" label "Modelo 3D"
    hardware_material material = "Acero inoxidable" label "Herrajes"
  section "A tu gusto"
    leaf_design choice("Como la colección", "Lisa", "Ranurada", "Ranurada vertical", "Dos cuarterones", "Cuatro cuarterones", "Seis cuarterones", "Plafonada", "Moldura aplicada", "Vidriera", "Media vidriera", "Vidriera con junquillos", "Lamas", "Tablas", "Chapa lisa", "Chapa embutida", "Chapa con ventanilla cuadrada", "Chapa con ojo de buey", "Chapa con mirilla alargada", "Lisa con ventanilla cuadrada", "Lisa con ojo de buey", "Acorazada", "Retícula a medida") = "Como la colección" label "Hoja"
    grid_cols integer = 2 range 1..8 visible_if leaf_design == "Retícula a medida" label "Retícula: vidrios a lo ancho"
    grid_rows integer = 4 range 1..12 visible_if leaf_design == "Retícula a medida" label "Retícula: vidrios a lo alto"
    casing choice("Como la colección", "Sin tapajuntas", "Plano", "Redondeado", "Moldurado", "Con junquillo") = "Como la colección" label "Tapajuntas"
    handle_style choice("Como la colección", "Palanca con roseta", "Palanca con placa", "Palanca recta", "Pomo", "Tirador de barra", "Sin manilla", "Barra antipánico", "Placa de empuje y tirador", "Escudo de seguridad", "Tirador largo") = "Como la colección" label "Manilla"
    handle_height length = 1.02 range 0.60..1.80 visible_if handle_style != "Sin manilla" label "Manilla: altura"
    handle_sides choice("A las dos caras", "Solo del lado al que abre", "Solo del otro lado") = "A las dos caras" visible_if handle_style != "Sin manilla" label "Manilla: caras"
  section "Representación"
    opening_lines linestyle = "dashed" label "Líneas de apertura (alzado y sección)"
  section "Representación"
    plan_frame_fill choice("Blanco", "Color del material") = "Blanco" label "Marco cortado en planta"
  section "Clasificación"
    classification_system choice("GuBIMClass", "Uniclass 2015", "OmniClass") = "GuBIMClass" label "Sistema de clasificación"
    classification text = "" label "Código de clasificación"

instance_params
  section "Posición"
    fold_open integer = 0 range 0..100 label "Abierta en 3D (%)"

require 2 * frame_width < width and 2 * frame_width < height else "El cerco no deja hueco para las hojas"
require (width - 2 * frame_width) / leaves >= 0.10 else "Las hojas quedan de menos de 10 cm"

# Hojas cerradas, una junto a otra, de 3 cm de grueso como mucho.
body
  use door_lining(width, height, frame_width, frame_depth, frame_material)
  let c0 = -width / 2 + frame_width
  let lw = (width - 2 * frame_width) / leaves
  # En 3D con detalle, las hojas, la guía y las bisagras las hace el
  # generador (salidas «leaf_*»).
  if not detailed
    repeat i in 0..leaves
      use block(c0 + i * lw, c0 + (i + 1) * lw, min(0.03, frame_depth), 0, height - frame_width, panel_material)

# Cerco cortado y las hojas a medio plegar, en zigzag hacia el lado al que
# abre, recogiéndose hacia el lado de la mano (UNE-EN 12519), con una
# flecha.
plan 1:50
  let c0 = -width / 2 + frame_width
  let c1 = width / 2 - frame_width
  use frame_cut_plan_t(-width / 2, c0, frame_depth, plan_frame_fill == "Color del material", frame_material)
  use frame_cut_plan_t(c1, width / 2, frame_depth, plan_frame_fill == "Color del material", frame_material)
  let s = if hand == "left" then 1 else -1
  let start = if hand == "left" then c0 else c1
  let lw = (c1 - c0) / leaves
  let a = 1.0
  let y0 = frame_depth / 2
  repeat i in 0..leaves
    let xa = start + s * i * lw * cos(a)
    let xb = start + s * (i + 1) * lw * cos(a)
    let ya = y0 + (if i - 2 * floor(i / 2) == 0 then 0 else lw * sin(a))
    let yb = y0 + (if i - 2 * floor(i / 2) == 0 then lw * sin(a) else 0)
    line (xa, ya) to (xb, yb) pen frame
  let tip = start + s * leaves * lw * cos(a)
  let ya = y0 + 0.05
  line (tip + s * 0.05, ya) to (tip + s * 0.25, ya) pen thin
  line (tip + s * 0.05, ya) to (tip + s * 0.11, ya + 0.03) pen thin
  line (tip + s * 0.05, ya) to (tip + s * 0.11, ya - 0.03) pen thin

# En alzado, el zigzag de las hojas a medio plegar visto de frente: en
# cada par, las líneas de apertura hacia la arista que se recoge.
elevation
  let c0 = -width / 2 + frame_width
  let c1 = width / 2 - frame_width
  let lw = (c1 - c0) / leaves
  let h = height - frame_width
  repeat i in 0..leaves
    let a = c0 + i * lw
    let odd = i - 2 * floor(i / 2)
    if odd == 0
      use side_hung_lines(a, a + lw, 0, h, opening_lines)
    else
      use side_hung_lines(a + lw, a, 0, h, opening_lines)

plan 1:100
  let c0 = -width / 2 + frame_width
  let c1 = width / 2 - frame_width
  let s = if hand == "left" then 1 else -1
  let start = if hand == "left" then c0 else c1
  let lw = (c1 - c0) / leaves
  let a = 1.0
  let y0 = frame_depth / 2
  repeat i in 0..leaves
    let xa = start + s * i * lw * cos(a)
    let xb = start + s * (i + 1) * lw * cos(a)
    let ya = y0 + (if i - 2 * floor(i / 2) == 0 then 0 else lw * sin(a))
    let yb = y0 + (if i - 2 * floor(i / 2) == 0 then lw * sin(a) else 0)
    line (xa, ya) to (xb, yb) pen frame

outputs
  opening_width = width
  opening_height = height
  frame_width = frame_width
  frame_depth = frame_depth
  frame_material = frame_material
  panel_material = panel_material
  operation = "folding"
  generator = "props:folding_door"
  leaf_x0 = -width / 2 + frame_width
  leaf_x1 = width / 2 - frame_width
  leaf_top = height - frame_width
  leaf_t = min(0.03, frame_depth)
  lining_w = width
  lining_h = height
  hinge_left = if hand == "left" then 1 else 0
