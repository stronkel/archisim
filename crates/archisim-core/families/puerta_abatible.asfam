family "Puerta abatible"
  category door
  host wall
  version 13
  description "Puerta abatible de una o dos hojas (iguales o con hoja activa), con cerco, tarja acristalada, fijos laterales y premarco si se quieren"

include "piezas"

type_params
  section "Dimensiones"
    width  length = 0.80 range 0.10..20.00 label "Hueco de obra: ancho"
    height length = 2.05 range 0.10..20.00 label "Hueco de obra: alto"
  section "Hojas"
    leaves integer = 1 range 1..2 label "Nº de hojas"
    unequal bool = no visible_if leaves == 2 label "Hojas desiguales"
    active_width length = 0.70 range 0.30..3.00 visible_if leaves == 2 and unequal label "Hoja activa: ancho"
  section "Cerco"
    frame_width length = 0.05 range 0.001..2.00 label "Cerco: anchura vista"
    frame_depth length = 0.07 range 0.001..2.00 label "Cerco: fondo"
  section "Tarja"
    transom bool = no label "Tarja acristalada sobre la puerta"
    transom_height length = 0.40 range 0.10..2.00 visible_if transom label "Tarja: alto"
  section "Fijos laterales"
    side_left bool = no label "Fijo lateral izquierdo"
    side_right bool = no label "Fijo lateral derecho"
    side_width length = 0.40 range 0.10..2.00 visible_if side_left or side_right label "Fijo lateral: ancho"
    side_base length = 0.00 range 0.00..1.20 visible_if side_left or side_right label "Fijo lateral: zócalo ciego"
  section "Premarco"
    subframe bool = no label "Premarco"
    subframe_width length = 0.03 range 0.005..0.20 visible_if subframe label "Premarco: anchura"
  section "Materiales"
    frame_material material = "Madera de pino" label "Cerco"
    panel_material material = "Madera de pino" label "Hoja"
    glass_material material = "Vidrio doble" visible_if transom or side_left or side_right label "Vidrio de la tarja y los fijos"
    subframe_material material = "Madera de pino" visible_if subframe label "Premarco"
  section "Hueco de muro"
    frame_position choice("Centrado en el muro", "Por fuera", "Por dentro") = "Centrado en el muro" label "Posición del marco"
    frame_inset length = 0.00 range 0.00..0.60 visible_if frame_position != "Centrado en el muro" label "Marco: retranqueo desde la cara"
    nib length = 0.00 range 0.00..0.20 label "Mocheta: ancho (0, sin mocheta)"
    nib_material material = "Ladrillo visto" visible_if nib > 0 label "Mocheta"
    lintel choice("Sin dintel visto", "De hormigón", "De piedra", "De madera", "De acero", "Sardinel de ladrillo", "Arco rebajado de ladrillo") = "Sin dintel visto" label "Dintel visto"
    lintel_height length = 0.20 range 0.03..0.60 visible_if lintel != "Sin dintel visto" label "Dintel: alto"
    lintel_bearing length = 0.15 range 0.00..0.50 visible_if lintel != "Sin dintel visto" and lintel != "Arco rebajado de ladrillo" label "Dintel: entrega a cada lado"
    lintel_material material = "Hormigón armado" visible_if lintel != "Sin dintel visto" label "Dintel"
  section "Recercado"
    surround choice("Sin recercado", "Plano", "Moldurado", "Con clave") = "Sin recercado" label "Recercado por fuera"
    surround_width length = 0.15 range 0.04..0.60 visible_if surround != "Sin recercado" label "Recercado: ancho"
    surround_projection length = 0.03 range 0.005..0.20 visible_if surround != "Sin recercado" label "Recercado: vuelo"
    surround_material material = "Piedra caliza" visible_if surround != "Sin recercado" label "Recercado"
  section "Accesorios"
    head_drip bool = no label "Albardilla sobre el hueco"
    head_drip_material material = "Piedra caliza" visible_if head_drip label "Albardilla"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Contemporáneo" label "Modelo 3D"
    hardware_material material = "Acero inoxidable" label "Herrajes"
  section "A tu gusto"
    leaf_design choice("Como la colección", "Lisa", "Ranurada", "Ranurada vertical", "Dos cuarterones", "Cuatro cuarterones", "Seis cuarterones", "Plafonada", "Moldura aplicada", "Vidriera", "Media vidriera", "Vidriera con junquillos", "Lamas", "Tablas", "Chapa lisa", "Chapa embutida", "Chapa con ventanilla cuadrada", "Chapa con ojo de buey", "Chapa con mirilla alargada", "Lisa con ventanilla cuadrada", "Lisa con ojo de buey", "Acorazada", "Retícula a medida") = "Como la colección" label "Hoja"
    grid_cols integer = 2 range 1..8 visible_if leaf_design == "Retícula a medida" label "Retícula: vidrios a lo ancho"
    grid_rows integer = 4 range 1..12 visible_if leaf_design == "Retícula a medida" label "Retícula: vidrios a lo alto"
    casing choice("Como la colección", "Sin tapajuntas", "Plano", "Redondeado", "Moldurado", "Con junquillo") = "Como la colección" label "Tapajuntas"
    handle_style choice("Como la colección", "Palanca con roseta", "Palanca con placa", "Palanca recta", "Pomo", "Tirador de barra", "Sin manilla", "Barra antipánico", "Placa de empuje y tirador", "Escudo de seguridad", "Tirador largo") = "Como la colección" label "Manilla"
    handle_height length = 1.02 range 0.60..1.80 visible_if handle_style != "Sin manilla" label "Manilla: altura"
    handle_sides choice("A las dos caras", "Solo del lado al que abre", "Solo del otro lado") = "A las dos caras" visible_if handle_style != "Sin manilla" label "Manilla: caras"
    hinges choice("Como la colección", "Ocultas", "De pala", "De pernio") = "Como la colección" label "Bisagras"
    peephole bool = no label "Mirilla"
    closer bool = no label "Cierrapuertas"
    kick_plate bool = no label "Zócalo de acero"
  section "Datos"
    fire_rating choice("—", "EI2 30-C5", "EI2 60-C5", "EI2 90-C5") = "—" label "Resistencia al fuego" ifc "Pset_DoorCommon.FireRating"
  section "Representación"
    swing_line linestyle = "continuous" label "Línea del giro (planta)"
    opening_lines linestyle = "dashed" label "Líneas de apertura (alzado y sección)"
  section "Representación"
    plan_frame_fill choice("Blanco", "Color del material") = "Blanco" label "Marco cortado en planta"
  section "Clasificación"
    classification_system choice("GuBIMClass", "Uniclass 2015", "OmniClass") = "GuBIMClass" label "Sistema de clasificación"
    classification text = "" label "Código de clasificación"

# Con premarco, el cerco va dentro de él; con tarja, la hoja llega hasta
# su travesaño.
let s = if subframe then subframe_width else 0
let w = width - 2 * s
let h = height - s
let door_height = if transom then h - transom_height else h
# Los fijos laterales, con un montante entre el fijo y la hoja.
let sl = if side_left then side_width + frame_width else 0
let sr = if side_right then side_width + frame_width else 0
let c0 = -w / 2 + frame_width + sl
let c1 = w / 2 - frame_width - sr
let active = if leaves == 2 and unequal then active_width else (c1 - c0) / 2

require c1 - c0 > 0.30 and 2 * frame_width < h else "El cerco y los fijos no dejan hueco para la hoja"
require not transom or door_height > 2 * frame_width + 0.30 else "La tarja no deja sitio a la puerta"
require not (leaves == 2 and unequal) or active < c1 - c0 - 0.20 else "La hoja activa no deja sitio a la otra (al menos 20 cm)"

# Fijo lateral de «xa» a «xb», hasta «zt», con zócalo ciego de «base» (del
# material de la hoja) y vidrio encima.
component sidelight(xa, xb, zt, base, f, d, frame_mat, glass_mat, panel_mat)
  if base > 0
    use block(xa, xb, min(0.04, d), 0, base, panel_mat)
    use block(xa, xb, d, base, base + f, frame_mat)
  let zg = if base > 0 then base + f else 0
  use block(xa, xb, min(0.024, d), zg, zt, glass_mat)

body
  if subframe
    use subframe(width, height, s, frame_depth, subframe_material, 0)
  use door_lining(w, h, frame_width, frame_depth, frame_material)
  if side_left
    use sidelight(-w / 2 + frame_width, c0 - frame_width, h - frame_width, side_base, frame_width, frame_depth, frame_material, glass_material, panel_material)
    use block(c0 - frame_width, c0, frame_depth, 0, h - frame_width, frame_material)
  if side_right
    use sidelight(c1 + frame_width, w / 2 - frame_width, h - frame_width, side_base, frame_width, frame_depth, frame_material, glass_material, panel_material)
    use block(c1, c1 + frame_width, frame_depth, 0, h - frame_width, frame_material)
  if transom
    use transom(c0, c1, door_height, h - frame_width, frame_width, frame_depth, frame_material, glass_material)
  # La hoja activa va del lado de la mano. En el 3D con detalle
  # («detailed»), las hojas, los tapajuntas y los herrajes los hace el
  # generador de la familia (salidas «leaf_*»).
  let split = if hand == "left" then c0 + active else c1 - active
  if not detailed
    if leaves == 2
      use door_leaf(c0, split, door_height, frame_width, frame_depth, panel_material)
      use door_leaf(split, c1, door_height, frame_width, frame_depth, panel_material)
    else
      use door_leaf(c0, c1, door_height, frame_width, frame_depth, panel_material)
  # Hueco de muro y accesorios (E6).
  use nib_pieces(width, height, frame_depth, wall_ext, nib, nib_material)
  if surround != "Sin recercado"
    use surround_pieces(width, height, wall_ext, surround, surround_width, surround_projection, surround_material, 0)
  let lk = if lintel == "Sin dintel visto" then 0 else if lintel == "De acero" then 2 else if lintel == "Sardinel de ladrillo" then 3 else if lintel == "Arco rebajado de ladrillo" then 4 else 1
  if lk > 0
    use lintel_pieces(width, height, wall_ext, wall_int, lk, lintel_height, if lk == 4 then 0 else lintel_bearing, lintel_material)
  if head_drip
    let zlt = if lk == 4 then width / 8 + lintel_height else if lk > 0 then lintel_height else 0
    let zs = if surround != "Sin recercado" then surround_width else 0
    use head_drip(width, height + max(zlt, zs), wall_ext, head_drip_material)

# Cerco cortado y hoja abierta a 90° con su giro; con una hoja, las
# bisagras van donde dice la mano (UNE-EN 12519); con dos desiguales, la
# activa también.
plan 1:50
  use wall_hole_plan(width, frame_depth, wall_ext, nib, if surround != "Sin recercado" then surround_width else 0, surround_projection, 0, 0, 0)
  if subframe
    use frame_cut_plan_t(-width / 2, -w / 2, frame_depth, plan_frame_fill == "Color del material", frame_material)
    use frame_cut_plan_t(w / 2, width / 2, frame_depth, plan_frame_fill == "Color del material", frame_material)
  if side_left
    use frame_cut_plan_t(-w / 2, -w / 2 + frame_width, frame_depth, plan_frame_fill == "Color del material", frame_material)
    use frame_cut_plan_t(c0 - frame_width, c0, frame_depth, plan_frame_fill == "Color del material", frame_material)
    line (-w / 2 + frame_width, 0) to (c0 - frame_width, 0) pen thin
  else
    use frame_cut_plan_t(-w / 2, c0, frame_depth, plan_frame_fill == "Color del material", frame_material)
  if side_right
    use frame_cut_plan_t(w / 2 - frame_width, w / 2, frame_depth, plan_frame_fill == "Color del material", frame_material)
    use frame_cut_plan_t(c1, c1 + frame_width, frame_depth, plan_frame_fill == "Color del material", frame_material)
    line (c1 + frame_width, 0) to (w / 2 - frame_width, 0) pen thin
  else
    use frame_cut_plan_t(c1, w / 2, frame_depth, plan_frame_fill == "Color del material", frame_material)
  if leaves == 2
    let left = if hand == "left" then active else c1 - c0 - active
    use door_leaf_plan(c0, 1, left, frame_depth, swing_line)
    use door_leaf_plan(c1, -1, c1 - c0 - left, frame_depth, swing_line)
  else if hand == "left"
    use door_leaf_plan(c0, 1, c1 - c0, frame_depth, swing_line)
  else
    use door_leaf_plan(c1, -1, c1 - c0, frame_depth, swing_line)

# A 1:20, el cerco con el galce donde cierra la hoja.
plan 1:20
  use wall_hole_plan(width, frame_depth, wall_ext, nib, if surround != "Sin recercado" then surround_width else 0, surround_projection, 0, 0, 0)
  if subframe
    use frame_cut_plan_t(-width / 2, -w / 2, frame_depth, plan_frame_fill == "Color del material", frame_material)
    use frame_cut_plan_t(w / 2, width / 2, frame_depth, plan_frame_fill == "Color del material", frame_material)
  let lt = min(0.04, frame_depth)
  use door_jamb_detail(c0 - frame_width, c0, frame_depth, 1, lt)
  use door_jamb_detail(c1, c1 + frame_width, frame_depth, -1, lt)
  if side_left
    use frame_cut_plan_t(-w / 2, -w / 2 + frame_width, frame_depth, plan_frame_fill == "Color del material", frame_material)
    use glass_detail(-w / 2 + frame_width, c0 - frame_width)
  if side_right
    use frame_cut_plan_t(w / 2 - frame_width, w / 2, frame_depth, plan_frame_fill == "Color del material", frame_material)
    use glass_detail(c1 + frame_width, w / 2 - frame_width)
  if leaves == 2
    let left = if hand == "left" then active else c1 - c0 - active
    use door_leaf_plan(c0, 1, left, frame_depth, swing_line)
    use door_leaf_plan(c1, -1, c1 - c0 - left, frame_depth, swing_line)
  else if hand == "left"
    use door_leaf_plan(c0, 1, c1 - c0, frame_depth, swing_line)
  else
    use door_leaf_plan(c1, -1, c1 - c0, frame_depth, swing_line)

# En alzado, las líneas de apertura de cada hoja (el vértice, en las
# bisagras).
elevation
  let split = if hand == "left" then c0 + active else c1 - active
  if leaves == 2
    use side_hung_lines(c0, split, 0, door_height - frame_width, opening_lines)
    use side_hung_lines(c1, split, 0, door_height - frame_width, opening_lines)
  else if hand == "left"
    use side_hung_lines(c0, c1, 0, door_height - frame_width, opening_lines)
  else
    use side_hung_lines(c1, c0, 0, door_height - frame_width, opening_lines)

# A 1:100, sin cerco y con la hoja como una línea.
plan 1:100
  if leaves == 2
    let left = if hand == "left" then active else c1 - c0 - active
    use door_leaf_plan_simple(c0, 1, left, frame_depth, swing_line)
    use door_leaf_plan_simple(c1, -1, c1 - c0 - left, frame_depth, swing_line)
  else if hand == "left"
    use door_leaf_plan_simple(c0, 1, c1 - c0, frame_depth, swing_line)
  else
    use door_leaf_plan_simple(c1, -1, c1 - c0, frame_depth, swing_line)

outputs
  frame_align = if frame_position == "Por fuera" then "exterior" else if frame_position == "Por dentro" then "interior" else "centre"
  frame_inset = frame_inset
  opening_width = width
  opening_height = height
  frame_width = frame_width + s
  frame_depth = frame_depth
  frame_material = frame_material
  panel_material = panel_material
  clear_width = c1 - c0
  operation = if leaves == 2 then "double_swing" else "single_swing"
  generator = "props:door"
  leaf_x0 = c0
  leaf_x1 = c1
  leaf_split = if hand == "left" then c0 + active else c1 - active
  leaf_top = door_height - frame_width
  leaf_t = min(0.04, frame_depth)
  lining_w = w
  lining_h = h
  hinge_left = if hand == "left" then 1 else 0
