family "Mercado de abastos (taller)"
  category street
  host none
  version 1
  description "Mercado de abastos regionalista: nave de ladrillo visto con bandas blancas, ventanas en arco de medio punto con abanicos de hierro, nave central elevada con linterna de lamas y cubierta de teja, naves laterales a un agua, frontón escalonado con el nombre en azulejos, reloj, portada en arco y dos puestos de fruta en la puerta (modelo del taller, en revisión)"
  folder "Taller · Edificios"

type_params
  section "Dimensiones"
    width length = 24.00 range 16.00..40.00 label "Frente"
    depth length = 36.00 range 20.00..70.00 label "Fondo"
    variant integer = 1 range 0..99 label "Variante"
  section "Materiales"
    brick material = "Ladrillo visto" label "Ladrillo"
    trim material = "Cal blanca" label "Bandas, dovelas y pilastras"
    plinth material = "Piedra caliza" label "Zócalo"
    tile_panel material = "Azulejo andaluz" label "Azulejos y pináculos"
    clock material = "Cerámica blanca" label "Esfera del reloj"
    wood material = "Lacado verde carruaje" label "Puertas"
    frame material = "Lacado verde carruaje" label "Carpintería"
    louvre material = "Lacado verde carruaje" label "Lamas de la linterna"
    iron material = "Hierro forjado" label "Abanicos, rejas y agujas"
    tiles material = "Teja curva" label "Tejas"
    roof material = "Terracota" label "Faldones"
    paving material = "Losa de acera" label "Acera"
    metal material = "Metal negro" label "Puestos"
    awning material = "Lona verde" label "Toldos"
    awning_b material = "Lona crema" label "Toldos (franjas)"
    fruit material = "Naranja" label "Fruta 1"
    fruit_b material = "Limón" label "Fruta 2"
    glass material = "Vidrio claro" label "Vidrio"
    interior material = "Interior en sombra" label "Interior visto por los huecos"
    brass material = "Latón" label "Herrajes"
    leaves material = "Hoja verde" label "Verdura"

body
  box (-(width) / 2, 0, 0) to ((width) / 2, depth + 5, 13.5) material brick

plan 1:50
  polygon (-(width) / 2, 0) ((width) / 2, 0) ((width) / 2, depth + 5) (-(width) / 2, depth + 5) pen view

outputs
  generator = "props:fine_market"
  ifc_class = "IfcBuildingElementProxy"
  ifc_type = "USERDEFINED"
