family "Contrabarra (taller)"
  category furniture
  host none
  version 1
  description "Mueble de contrabarra como lo hace cada colección: armarios bajos con encimera y, encima, baldas con botellas (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Dimensiones"
    width  length = 2.40 range 1.00..6.00 label "Largo"
    depth  length = 0.50 range 0.35..0.70 label "Fondo"
    height length = 2.40 range 1.60..3.00 label "Altura"
  section "Materiales"
    frame   material = "Roble claro" label "Madera"
    front   material = "Roble claro" label "Puertas"
    top     material = "Roble claro" label "Encimera"
    masonry material = "Cal blanca" label "Fábrica"
    accent  material = "Cerámica esmaltada" label "Azulejo"
    metal   material = "Latón" label "Metal"
    dark    material = "Metal negro" label "Acero negro"
    glass   material = "Vidrio claro" label "Baldas de vidrio"
    mirror  material = "Espejo" label "Espejo"
    light   material = "Luz cálida" label "Panel iluminado"
    bottle  material = "Vidrio verde botella" label "Botellas verdes"
    bottle2 material = "Vidrio ámbar" label "Botellas ámbar"
    bottle3 material = "Vidrio claro" label "Botellas claras"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Colección"

body
  box (-width / 2, 0, 0) to (width / 2, depth, height) material frame

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view
  line (-width / 2, 0.26) to (width / 2, 0.26) pen thin dashed

outputs
  generator = "props:fine_back_bar"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
