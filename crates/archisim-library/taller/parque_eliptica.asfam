family "Elíptica de parque (taller)"
  category furniture
  host none
  version 1
  description "Aparato biosaludable: elíptica con asideros y pedales sobre brazos (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Materiales"
    frame   material = "Pintura verde" label "Poste y brazos"
    accent  material = "Pintura amarilla" label "Asideros y remate"
    dark    material = "Goma negra" label "Base y pedales"

body
  box (-0.38, 0, 0) to (0.38, 1.0, 1.55) material frame

plan 1:50
  polygon (-0.25, 0.1) (0.25, 0.1) (0.25, 0.6) (-0.25, 0.6) pen view
  polygon (-0.36, 0.6) (0.36, 0.6) (0.36, 1.0) (-0.36, 1.0) pen thin

outputs
  generator = "props:fine_park_elliptical"
  ifc_class = "IfcBuildingElementProxy"
  ifc_type = "USERDEFINED"
