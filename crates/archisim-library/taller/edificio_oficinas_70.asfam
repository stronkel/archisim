family "Oficinas de los 70 (taller)"
  category street
  host none
  version 1
  description "Edificio de oficinas de los años 70: bandas de antepechos prefabricados de hormigón entre ventanas corridas de aluminio anodizado, planta baja sobre pilotis con la entrada acristalada, parasoles verticales, núcleo de escalera de ladrillo y máquinas en cubierta (modelo del taller, en revisión)"
  folder "Taller · Edificios"

type_params
  section "Dimensiones"
    width length = 30.00 range 14.00..60.00 label "Fachada"
    depth length = 14.00 range 10.00..24.00 label "Fondo"
    floors integer = 6 range 3..14 label "Plantas"
    variant integer = 1 range 0..99 label "Variante"
  section "Materiales"
    precast material = "Hormigón suave" label "Antepechos prefabricados"
    frame material = "Aluminio bronce" label "Carpintería"
    glass material = "Vidrio claro" label "Vidrio"
    brise material = "Hormigón suave" label "Parasoles"
    brick material = "Enfoscado gris" label "Núcleo de escalera"
    panel material = "Granito negro" label "Planta baja"
    structure material = "Hormigón suave" label "Pilotis"
    curtain_glass material = "Vidrio claro" label "Vestíbulo"
    mullion material = "Aluminio bronce" label "Montantes del vestíbulo"
    spandrel material = "Vidrio opaco gris" label "Antepechos del vestíbulo"
    door_frame material = "Acero inoxidable" label "Entrada"
    curtain material = "Lino arena" label "Cortinas"
    sign material = "Metal negro" label "Nombre"
    appliance material = "Lacado blanco" label "Máquinas"
    roof_floor material = "Grava" label "Cubierta"
    paving material = "Losa de acera" label "Acera"
    stone material = "Piedra caliza" label "Bancos"
    interior material = "Interior en sombra" label "Interior visto por los huecos"

body
  box (-(width + 8) / 2, 0, 0) to ((width + 8) / 2, depth + 6, 4 + 3.3 * (floors - 1) + 3) material precast

plan 1:50
  polygon (-(width + 8) / 2, 0) ((width + 8) / 2, 0) ((width + 8) / 2, depth + 6) (-(width + 8) / 2, depth + 6) pen view

outputs
  generator = "props:fine_office_1970s"
  ifc_class = "IfcBuildingElementProxy"
  ifc_type = "USERDEFINED"
