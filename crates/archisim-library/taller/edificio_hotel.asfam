family "Hotel urbano (taller)"
  category street
  host none
  version 1
  description "Hotel urbano: planta baja de piedra con puerta giratoria, marquesina y banderas, plantas de habitaciones con balconeras y balcones, el nombre en la cubierta y terraza con pérgola, mesas y sillas (modelo del taller, en revisión)"
  folder "Taller · Edificios"

type_params
  section "Dimensiones"
    width length = 22.00 range 12.00..50.00 label "Fachada"
    depth length = 16.00 range 10.00..30.00 label "Fondo"
    floors integer = 8 range 3..20 label "Plantas (con la baja)"
    variant integer = 1 range 0..99 label "Variante"
  section "Materiales"
    stone material = "Piedra caliza" label "Planta baja e impostas"
    wall material = "Cal blanca" label "Fachada"
    trim material = "Piedra caliza" label "Cornisa y balcones"
    canopy material = "Metal negro" label "Marquesina"
    flag material = "Plástico rojo" label "Bandera 1"
    flag_b material = "Lacado azul añil" label "Bandera 2"
    flag_c material = "Lacado blanco" label "Bandera 3"
    sign material = "Oro viejo" label "Nombre"
    pergola material = "Roble claro" label "Pérgola"
    furniture material = "Metal negro" label "Mesas y sillas"
    table_top material = "Mármol" label "Tableros"
    seat material = "Ratán" label "Asientos"
    roof_floor material = "Hormigón pulido" label "Terraza"
    paving material = "Losa de acera" label "Acera"
    glass material = "Vidrio claro" label "Vidrio"
    interior material = "Interior en sombra" label "Interior visto por los huecos"
    frame material = "Metal negro" label "Carpintería"
    blind material = "Persiana crema" label "Persianas"
    curtain material = "Visillo" label "Visillos"
    iron material = "Hierro forjado" label "Barandillas"
    metal material = "Acero galvanizado" label "Soportes"
    appliance material = "Lacado blanco" label "Aires acondicionados"
    pot material = "Terracota" label "Macetas"
    flowers material = "Buganvilla" label "Flores"
    leaves material = "Hoja verde" label "Plantas"

body
  box (-(width) / 2, 0, 0) to ((width) / 2, depth + 5, 4.5 + 3.1 * (floors - 1) + 3) material stone

plan 1:50
  polygon (-(width) / 2, 0) ((width) / 2, 0) ((width) / 2, depth + 5) (-(width) / 2, depth + 5) pen view

outputs
  generator = "props:fine_urban_hotel"
  ifc_class = "IfcBuildingElementProxy"
  ifc_type = "USERDEFINED"
