family "Farola (taller)"
  category street
  host none
  version 1
  description "Farola como la hace cada colección; el punto de inserción es el pie del poste y el brazo sale hacia delante (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Dimensiones"
    height length = 4.50 range 2.20..12.00 label "Altura"
    arm    length = 0.80 range 0.30..3.00 label "Vuelo del brazo"
    pole   length = 0.12 range 0.05..0.40 label "Diámetro del poste"
    lamp   length = 0.50 range 0.20..1.20 label "Tamaño del farol"
  section "Materiales"
    frame material = "Roble claro" label "Madera"
    metal material = "Metal negro" label "Metal"
    mat material = "Hormigón pulido" label "Cuerpo (hormigón, piedra, acero)"
    masonry material = "Cal blanca" label "Obra"
    top material = "Piedra caliza" label "Piedra de remate"
    accent material = "Cerámica esmaltada" label "Azulejo o color"
    pot_mat material = "Hormigón pulido" label "Jardinera"
    soil material = "Tierra" label "Tierra"
    stem material = "Espiga" label "Tronco y tallos"
    leaves material = "Gramínea" label "Hojas"
    leaves2 material = "Hoja verde tierna" label "Hojas claras"
    flowers material = "Espiga" label "Flores y espigas"
    light material = "Luz de farola" label "Luz"
    water material = "Agua de fuente" label "Agua"
    dark material = "Metal negro" label "Huecos y rejillas"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Colección"

body
  box (-pole / 2, -pole / 2, 0) to (pole / 2, pole / 2, height) material metal

plan 1:50
  let p = pole / 2
  repeat i in 0..12
    let t0 = 6.283185307 * i / 12
    let t1 = 6.283185307 * (i + 1) / 12
    line (p * 1.6 * cos(t0), p * 1.6 * sin(t0)) to (p * 1.6 * cos(t1), p * 1.6 * sin(t1)) pen view
  line (0, p * 1.6) to (0, arm) pen thin

outputs
  generator = "props:streetlight"
  ifc_class = "IfcLightFixture"
  ifc_type = "SECURITYLIGHTING"
