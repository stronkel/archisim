family "Mesa auxiliar (taller)"
  category furniture
  host none
  version 1
  description "Mesa auxiliar por colecciones (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Dimensiones"
    width  length = 0.45 range 0.25..0.80 label "Ancho"
    depth  length = 0.45 range 0.25..0.80 label "Fondo"
    height length = 0.55 range 0.30..0.80 label "Altura"
  section "Materiales"
    top     material = "Roble claro" label "Tablero"
    frame   material = "Roble claro" label "Madera y patas"
    metal   material = "Metal negro" label "Metal"
    stone   material = "Mármol" label "Piedra"
    ceramic material = "Cerámica esmaltada" label "Cerámica"
    dark    material = "Negro mate" label "Detalles oscuros"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

body
  box (-width / 2, 0, height - 0.04) to (width / 2, depth, height) material top

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view

outputs
  generator = "props:fine_side_table"
  ifc_class = "IfcFurniture"
  ifc_type = "TABLE"
