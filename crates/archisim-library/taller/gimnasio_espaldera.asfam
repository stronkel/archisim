family "Espaldera (taller)"
  category furniture
  host none
  version 1
  description "Espaldera de madera por cuerpos de 90 cm, separada de la pared, con el peldaño superior saliente (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Dimensiones"
    sections integer = 1 range 1..4 label "Cuerpos"
    height length = 2.40 range 2.00..2.80 label "Altura"
  section "Materiales"
    frame   material = "Roble claro" label "Madera"
    dark    material = "Metal negro" label "Anclajes"

body
  box (-0.45 * sections, 0, 0) to (0.45 * sections, 0.19, height) material frame

plan 1:50
  polygon (-0.45 * sections, 0) (0.45 * sections, 0) (0.45 * sections, 0.19) (-0.45 * sections, 0.19) pen view

outputs
  generator = "props:fine_wall_bars"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
