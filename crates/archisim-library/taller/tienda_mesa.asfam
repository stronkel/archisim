family "Mesa expositora (taller)"
  category furniture
  host none
  version 1
  description "Mesa para el centro de la tienda con ropa doblada y cajas, como la hace cada colección (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Dimensiones"
    width  length = 1.40 range 0.80..3.00 label "Ancho"
    depth  length = 0.80 range 0.50..1.20 label "Fondo"
    height length = 0.80 range 0.60..1.00 label "Altura"
  section "Materiales"
    frame   material = "Roble claro" label "Madera"
    top     material = "Roble claro" label "Tablero"
    front   material = "Lacado blanco" label "Paneles"
    masonry material = "Cal blanca" label "Fábrica o piedra"
    accent  material = "Cerámica esmaltada" label "Azulejo o color"
    metal   material = "Latón" label "Metal"
    dark    material = "Metal negro" label "Acero negro"
    goods   material = "Caja kraft" label "Género"
    goods2  material = "Caja salvia" label "Más género"
    goods3  material = "Archivador blanco" label "Etiquetas y otro género"
    cloth   material = "Lino crudo" label "Ropa"
    cloth2  material = "Lana teja" label "Más ropa"
    cloth3  material = "Lino añil" label "Otra ropa"
    glass   material = "Vidrio claro" label "Tarros"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Colección"

body
  box (-width / 2, 0, 0) to (width / 2, depth, height) material top

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view

outputs
  generator = "props:fine_display_table"
  ifc_class = "IfcFurniture"
  ifc_type = "TABLE"
