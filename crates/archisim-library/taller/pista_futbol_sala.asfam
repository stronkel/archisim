family "Pista de fútbol sala (taller)"
  category furniture
  host none
  version 1
  description "Pista de fútbol sala de 40 × 20 m con sus líneas, áreas de 6 m, puntos de penalti, porterías de 3 × 2 m y zona de seguridad (44 × 24 m) (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Materiales"
    court   material = "Pista azul" label "Pista"
    ground  material = "Pista verde" label "Zona de seguridad"
    line    material = "Línea blanca" label "Líneas"
    frame   material = "Lacado blanco" label "Porterías"
    net     material = "Red blanca" label "Redes"

body
  box (-22, 0, 0) to (22, 24, 2.05) material court

plan 1:50
  polygon (-22, 0) (22, 0) (22, 24) (-22, 24) pen thin
  polygon (-20, 2) (20, 2) (20, 22) (-20, 22) pen view
  line (0, 2) to (0, 22) pen view
  polygon (-20.8, 10.5) (-20, 10.5) (-20, 13.5) (-20.8, 13.5) pen view
  polygon (20, 10.5) (20.8, 10.5) (20.8, 13.5) (20, 13.5) pen view

outputs
  generator = "props:fine_futsal_court"
  ifc_class = "IfcBuildingElementProxy"
  ifc_type = "USERDEFINED"
