family "Bicicleta estática (taller)"
  category furniture
  host none
  version 1
  description "Bicicleta estática con volante de inercia, sillín regulable y consola (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Materiales"
    frame   material = "Plástico gris oscuro" label "Cuadro y tapas"
    metal   material = "Acero inoxidable" label "Volante, tija y bielas"
    mat     material = "Polipiel negra" label "Sillín"
    dark    material = "Goma negra" label "Patas, manillar y pedales"
    display material = "Pantalla de televisor" label "Pantalla"

body
  box (-0.28, 0, 0) to (0.28, 1.07, 1.2) material frame

plan 1:50
  polygon (-0.28, 0) (0.28, 0) (0.28, 1.07) (-0.28, 1.07) pen view

outputs
  generator = "props:fine_exercise_bike"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
