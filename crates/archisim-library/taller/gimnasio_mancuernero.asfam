family "Mancuernero (taller)"
  category furniture
  host none
  version 1
  description "Soporte de dos baldas con mancuernas de peso creciente (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Dimensiones"
    width  length = 1.20 range 0.60..2.40 label "Ancho"
  section "Materiales"
    frame   material = "Metal negro" label "Soporte"
    dark    material = "Goma negra" label "Pies"
    plate   material = "Goma negra" label "Mancuernas"
    metal   material = "Acero inoxidable" label "Agarres"

body
  box (-width / 2, 0, 0) to (width / 2, 0.6, 0.9) material frame

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, 0.6) (-width / 2, 0.6) pen view

outputs
  generator = "props:fine_dumbbell_rack"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
