family "Cortijo andaluz (taller)"
  category street
  host none
  version 1
  description "Cortijo: casa del señorío de dos plantas al fondo de un patio de albero, naves a los lados con portones, torre de contrapeso con su chapitel de teja, tapia con portada en arco y espadaña con campana, pozo, abrevadero, olivos y palmera (modelo del taller, en revisión)"
  folder "Taller · Edificios"

type_params
  section "Dimensiones"
    width length = 32.00 range 22.00..50.00 label "Frente"
    depth length = 28.00 range 20.00..50.00 label "Fondo"
    variant integer = 1 range 0..99 label "Variante"
    tower bool = yes label "Torre de contrapeso"
  section "Materiales"
    wall material = "Encalado" label "Muros"
    plinth material = "Estuco almagra" label "Zócalos"
    trim material = "Estuco amarillo" label "Recercados y cornisas"
    stone material = "Piedra caliza" label "Portada, balcón y pozo"
    step material = "Mármol" label "Escalones"
    tile_panel material = "Azulejo andaluz" label "Panel de azulejos"
    tiles material = "Teja curva" label "Tejas"
    roof material = "Terracota" label "Faldones"
    wood material = "Nogal" label "Portones y puertas"
    frame material = "Lacado verde carruaje" label "Carpintería"
    iron material = "Hierro forjado" label "Rejas y herrajes"
    lamp material = "Luz de farola" label "Farol"
    yard material = "Albero" label "Patio"
    water material = "Agua de fuente" label "Abrevadero"
    palm material = "Hoja verde" label "Palmera"
    glass material = "Vidrio claro" label "Vidrio"
    curtain material = "Visillo" label "Visillos"
    blind material = "Persiana crema" label "Persianas"
    pot material = "Terracota" label "Macetas"
    leaves material = "Hoja verde" label "Plantas"
    flowers material = "Buganvilla" label "Flores"
    interior material = "Interior en sombra" label "Interior visto por los huecos"
    brass material = "Latón" label "Herrajes"
    trunk material = "Corteza de olivo" label "Troncos"
    fruit material = "Naranja" label "Frutos"

body
  box (-(width) / 2, 0, 0) to ((width) / 2, depth, 12.5 + 3.5) material wall

plan 1:50
  polygon (-(width) / 2, 0) ((width) / 2, 0) ((width) / 2, depth) (-(width) / 2, depth) pen view

outputs
  generator = "props:fine_cortijo"
  ifc_class = "IfcBuildingElementProxy"
  ifc_type = "USERDEFINED"
