family "Sofá (taller)"
  category furniture
  host none
  version 1
  description "Sofá de cojines de caja con vivos, sobre patas torneadas (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Dimensiones"
    width  length = 2.20 range 1.00..4.00 label "Largo"
    depth  length = 0.92 range 0.70..1.20 label "Fondo"
    seat   length = 0.43 range 0.35..0.55 label "Altura del asiento"
    height length = 0.82 range 0.65..1.10 label "Altura del respaldo"
    places integer = 3 range 1..6 label "Plazas"
  section "Materiales"
    mat material = "Lino arena" label "Tapicería"
    cushion material = "Lino arena" label "Cojines"
    frame material = "Roble claro" label "Patas"
  section "Modelo 3D"
    model3d choice("Contemporáneo de patas") = "Contemporáneo de patas" label "Modelo 3D"
  section "Decoración"
    pillows integer = 2 range 0..4 label "Cojines sueltos"
    pillow  material = "Terciopelo mostaza" label "Cojines sueltos"

require 0.5 < width - 0.44 else "No caben los brazos"
require seat + 0.15 < height else "El respaldo tiene que subir por encima del asiento"

body
  box (-width / 2, 0, 0) to (width / 2, 0.2, height) material mat
  box (-width / 2, 0.2, 0) to (width / 2, depth, seat) material mat

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view
  let arm = min(max(width * 0.085, 0.15), 0.22)
  line (-width / 2 + arm, 0.2) to (width / 2 - arm, 0.2) pen thin
  line (-width / 2 + arm, 0.2) to (-width / 2 + arm, depth) pen thin
  line (width / 2 - arm, 0.2) to (width / 2 - arm, depth) pen thin
  let pw = (width - 2 * arm) / places
  repeat i in 1..places
    line (-width / 2 + arm + i * pw, 0.2) to (-width / 2 + arm + i * pw, depth) pen thin

outputs
  joins = "width"
  generator = "props:fine_sofa"
  ifc_class = "IfcFurniture"
  ifc_type = "SOFA"

stretch
  places = if (width - 0.44) / places >= 0.5 and (width - 0.44) / places <= 0.8 then places else (width - 0.44) / 0.62
