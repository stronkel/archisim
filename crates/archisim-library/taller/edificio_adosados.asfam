family "Adosados de promotora (taller)"
  category street
  host none
  version 1
  description "Hilera de adosados: dos plantas y cubierta de teja a la calle y al jardín con los muros cortafuegos asomando, jardín delantero con murete, barandilla y cancela, puerta seccional del garaje, porche con tejadillo sobre la entrada, carpintería de aluminio con persianas, balcón con barandilla de vidrio y una chimenea por casa (modelo del taller, en revisión)"
  folder "Taller · Edificios"

type_params
  section "Dimensiones"
    houses integer = 4 range 1..10 label "Viviendas"
    house_width length = 6.00 range 4.50..9.00 label "Fachada de cada vivienda"
    depth length = 10.00 range 7.00..16.00 label "Fondo"
    garden length = 3.00 range 0.00..8.00 label "Jardín delantero"
    variant integer = 1 range 0..99 label "Variante"
  section "Materiales"
    wall material = "Monocapa crema" label "Fachada"
    plinth material = "Mampostería" label "Zócalo y murete"
    trim material = "Cal blanca" label "Impostas y vierteaguas"
    tiles material = "Teja curva" label "Tejas"
    roof material = "Terracota" label "Faldones y porche"
    frame material = "Aluminio blanco" label "Carpintería"
    door material = "Nogal" label "Puerta de entrada"
    wood material = "Nogal" label "Ménsulas del porche"
    garage material = "Lacado blanco" label "Puerta del garaje"
    metal material = "Aluminio plata" label "Barandillas de vidrio y bajantes"
    iron material = "Metal negro" label "Barandilla y cancela"
    awning material = "Lona verde" label "Toldos"
    awning_b material = "Lona crema" label "Toldos (franjas)"
    appliance material = "Lacado blanco" label "Aires acondicionados"
    lamp material = "Luz de farola" label "Farol"
    paving material = "Losa de acera" label "Caminos"
    lawn material = "Césped natural" label "Césped"
    glass material = "Vidrio claro" label "Vidrio"
    curtain material = "Visillo" label "Visillos"
    blind material = "Persiana crema" label "Persianas"
    pot material = "Terracota" label "Macetas"
    leaves material = "Hoja verde" label "Plantas"
    flowers material = "Buganvilla" label "Flores"
    interior material = "Interior en sombra" label "Interior visto por los huecos"
    brass material = "Latón" label "Herrajes"

body
  box (-(houses * house_width) / 2, 0, 0) to ((houses * house_width) / 2, depth + garden, 3.0 + 2.85 + depth / 2 * 0.5 + 1.0) material wall

plan 1:50
  polygon (-(houses * house_width) / 2, 0) ((houses * house_width) / 2, 0) ((houses * house_width) / 2, depth + garden) (-(houses * house_width) / 2, depth + garden) pen view

outputs
  generator = "props:fine_terraced_row"
  ifc_class = "IfcBuildingElementProxy"
  ifc_type = "USERDEFINED"
