family "Mesa de exterior (taller)"
  category street
  host none
  version 1
  description "Mesa de jardín o terraza como la hace cada colección, con sus sillas alrededor (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Dimensiones"
    width  length = 1.60 range 0.60..3.00 label "Largo (las redondas, el menor es el diámetro)"
    depth  length = 0.90 range 0.60..1.40 label "Fondo"
    height length = 0.75 range 0.60..0.80 label "Altura"
    chairs integer = 4 range 0..12 label "Sillas alrededor"
  section "Materiales"
    frame material = "Teca" label "Madera o estructura"
    metal material = "Metal negro" label "Metal"
    weave material = "Ratán" label "Cuerda o fibra"
    cushion material = "Tela de exterior" label "Cojines"
    pillow material = "Lino añil" label "Cojines sueltos"
    mat material = "Tela de exterior" label "Lona"
    accent material = "Lino añil" label "Rayas"
    top material = "Mármol" label "Tablero"
    masonry material = "Cal blanca" label "Obra"
    pot_mat material = "Terracota" label "Maceta"
    soil material = "Tierra" label "Tierra"
    stem material = "Corteza de pino" label "Tronco y tallos"
    leaves material = "Hoja verde" label "Hojas"
    flowers material = "Lavanda" label "Flores"
    dark material = "Metal negro" label "Base y sombras"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Colección"

body
  box (-width / 2, 0, 0) to (width / 2, depth, height) material frame

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view
  polygon (-width / 2 - 0.5, -0.55) (width / 2 + 0.5, -0.55) (width / 2 + 0.5, depth + 0.55) (-width / 2 - 0.5, depth + 0.55) pen thin dashed

outputs
  generator = "props:garden_table"
  ifc_class = "IfcFurniture"
  ifc_type = "TABLE"
