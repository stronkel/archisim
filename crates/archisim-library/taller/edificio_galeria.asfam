family "Casa con galería gallega (taller)"
  category street
  host none
  version 1
  description "Casa de galerías gallega: estrecha entre medianeras, planta baja y pilastras de granito, y el frente de cada planta cerrado por una galería de madera blanca y cristales pequeños con sus antepechos de cuarterones, cornisa sobre alero y cubierta de teja (modelo del taller, en revisión)"
  folder "Taller · Edificios"

type_params
  section "Dimensiones"
    width length = 7.00 range 4.50..14.00 label "Fachada"
    depth length = 12.00 range 8.00..20.00 label "Fondo"
    floors integer = 5 range 3..7 label "Plantas (con la baja)"
    variant integer = 1 range 0..99 label "Variante"
  section "Materiales"
    stone material = "Piedra gris" label "Granito"
    wall material = "Enfoscado gris" label "Revoco"
    party material = "Enfoscado gris" label "Medianeras"
    gallery material = "Lacado blanco" label "Galerías"
    frame material = "Lacado blanco" label "Carpintería"
    wood material = "Nogal" label "Portal y escaparate"
    sign material = "Rótulo granate" label "Rótulo"
    shutter material = "Acero gris" label "Cierre"
    step material = "Piedra gris" label "Escalón"
    trim material = "Cal blanca" label "Chimenea"
    metal material = "Acero galvanizado" label "Bajante"
    iron material = "Hierro forjado" label "Herrajes"
    blind material = "Persiana crema" label "Persianas"
    tiles material = "Teja curva" label "Tejas"
    roof material = "Terracota" label "Faldones"
    glass material = "Vidrio claro" label "Vidrio"
    interior material = "Interior en sombra" label "Interior visto por los huecos"
    brass material = "Latón" label "Herrajes"
    curtain material = "Visillo" label "Visillos"
    pot material = "Terracota" label "Macetas"
    leaves material = "Hoja verde" label "Plantas"
    flowers material = "Buganvilla" label "Flores"

body
  box (-(width) / 2, 0, 0) to ((width) / 2, depth, 3.8 + 3.0 * (floors - 1) + 3) material stone

plan 1:50
  polygon (-(width) / 2, 0) ((width) / 2, 0) ((width) / 2, depth) (-(width) / 2, depth) pen view

outputs
  generator = "props:fine_galician_galleries"
  ifc_class = "IfcBuildingElementProxy"
  ifc_type = "USERDEFINED"
