family "Banco (taller)"
  category street
  host none
  version 1
  description "Banco de calle como lo hace cada colección; el punto de inserción es el centro de la trasera (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Dimensiones"
    width  length = 1.80 range 0.60..6.00 label "Largo"
    depth  length = 0.50 range 0.30..0.80 label "Fondo"
    seat   length = 0.45 range 0.30..0.60 label "Altura del asiento"
    back   bool = yes label "Respaldo"
    height length = 0.85 visible_if back range 0.60..1.20 label "Altura del respaldo"
  section "Materiales"
    frame material = "Roble claro" label "Madera"
    metal material = "Metal negro" label "Metal"
    mat material = "Hormigón pulido" label "Cuerpo (hormigón, piedra, acero)"
    masonry material = "Cal blanca" label "Obra"
    top material = "Piedra caliza" label "Piedra de remate"
    accent material = "Cerámica esmaltada" label "Azulejo o color"
    pot_mat material = "Hormigón pulido" label "Jardinera"
    soil material = "Tierra" label "Tierra"
    stem material = "Espiga" label "Tronco y tallos"
    leaves material = "Gramínea" label "Hojas"
    leaves2 material = "Hoja verde tierna" label "Hojas claras"
    flowers material = "Espiga" label "Flores y espigas"
    light material = "Luz de farola" label "Luz"
    water material = "Agua de fuente" label "Agua"
    dark material = "Metal negro" label "Huecos y rejillas"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Colección"

body
  box (-width / 2, 0, 0) to (width / 2, depth, seat) material frame

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view
  if back
    line (-width / 2, 0.12) to (width / 2, 0.12) pen thin

outputs
  generator = "props:bench"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
