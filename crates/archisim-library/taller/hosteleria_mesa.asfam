family "Mesa de bar (taller)"
  category furniture
  host none
  version 1
  description "Mesa de cafetería como la hace cada colección, baja o alta (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Dimensiones"
    width  length = 0.60 range 0.45..1.20 label "Tablero"
    height length = 0.75 range 0.70..1.15 label "Altura"
  section "Materiales"
    top     material = "Roble claro" label "Tablero"
    frame   material = "Roble claro" label "Madera"
    metal   material = "Hierro forjado" label "Metal"
    dark    material = "Metal negro" label "Hierro o acero"
    accent  material = "Cerámica esmaltada" label "Azulejo o laminado"
    masonry material = "Cal blanca" label "Llagas"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Colección"

body
  box (-width / 2, 0, 0) to (width / 2, width, height) material top

plan 1:50
  let r = width / 2
  repeat i in 0..20
    let t0 = 6.283185307 * i / 20
    let t1 = 6.283185307 * (i + 1) / 20
    line (r * cos(t0), r + r * sin(t0)) to (r * cos(t1), r + r * sin(t1)) pen view

outputs
  generator = "props:fine_bar_table"
  ifc_class = "IfcFurniture"
  ifc_type = "TABLE"
