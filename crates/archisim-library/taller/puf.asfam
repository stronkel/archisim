family "Puf (taller)"
  category furniture
  host none
  version 1
  description "Puf y reposapiés por colecciones: redondo de bouclé, de esparto, tambor años 50, cojín japandi, cubo, banqueta de enea, de cuero y capitoné (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Dimensiones"
    width  length = 0.50 range 0.30..1.40 label "Ancho"
    depth  length = 0.50 range 0.30..1.00 label "Fondo"
    height length = 0.42 range 0.15..0.60 label "Altura"
  section "Materiales"
    mat     material = "Bouclé crudo" label "Tapicería"
    cushion material = "Lino piedra" label "Cojín"
    frame   material = "Roble claro" label "Madera y patas"
    weave   material = "Enea" label "Fibra"
    metal   material = "Metal negro" label "Metal"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

body
  box (-width / 2, 0, 0) to (width / 2, depth, height) material mat

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view

outputs
  generator = "props:fine_pouf"
  ifc_class = "IfcFurniture"
  ifc_type = "CHAIR"
