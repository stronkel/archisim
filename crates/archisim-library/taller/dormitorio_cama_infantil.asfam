family "Cama infantil (taller)"
  category furniture
  host none
  version 1
  description "Cama infantil como la hace cada colección: la cama de la colección más baja, con barrera, ropa de cama y un muñeco (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Dimensiones"
    width length = 0.90 range 0.70..1.40 label "Ancho del colchón"
    depth length = 1.90 range 1.40..2.10 label "Largo del colchón"
  section "Ropa de cama"
    spread   bool = yes label "Manta a los pies"
    cushions integer = 1 range 0..4 label "Cojines"
    toy      bool = yes label "Muñeco"
  section "Materiales"
    frame material = "Roble claro" label "Madera o estructura"
    metal material = "Latón" label "Metal"
    weave material = "Enea" label "Rejilla o enea"
    dark material = "Fresno oscuro" label "Sombras y cuero"
    cushion material = "Bouclé crudo" label "Tapizado"
    linen material = "Lino blanco" label "Sábanas y almohadas"
    duvet material = "Lino arena" label "Edredón"
    spread_mat material = "Lana teja" label "Manta"
    pillow material = "Terciopelo salvia" label "Cojines"
    toy_mat material = "Lana cruda" label "Muñeco"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Colección"

body
  box (-width / 2, 0, 0) to (width / 2, depth + 0.12, 0.45) material linen

plan 1:50
  polygon (-width / 2 - 0.05, 0) (width / 2 + 0.12, 0) (width / 2 + 0.12, depth + 0.12) (-width / 2 - 0.05, depth + 0.12) pen view
  polygon (-width / 2 + 0.1, 0.15) (width / 2 - 0.1, 0.15) (width / 2 - 0.1, 0.45) (-width / 2 + 0.1, 0.45) pen thin
  line (-width / 2, 0.65) to (width / 2, 0.65) pen thin

outputs
  generator = "props:kids_bed"
  ifc_class = "IfcFurniture"
  ifc_type = "BED"
