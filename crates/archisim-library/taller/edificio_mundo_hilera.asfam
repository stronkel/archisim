body
  box (-(width) / 2, 0, 0) to ((width) / 2, depth, 3.4 + 3.0 * (floors - 1) + 3) material w_white

plan 1:50
  polygon (-(width) / 2, 0) ((width) / 2, 0) ((width) / 2, depth) (-(width) / 2, depth) pen view

outputs
  generator = "props:fine_world_row"
  ifc_class = "IfcBuildingElementProxy"
  ifc_type = "USERDEFINED"
