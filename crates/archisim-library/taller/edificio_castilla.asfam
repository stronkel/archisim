family "Casa castellana con soportales (taller)"
  category street
  host none
  version 1
  description "Casa de plaza mayor castellana: soportal de columnas de piedra con zapatas y carrera de madera, comercios y portales detrás, balcón corrido de madera en la primera planta y balcones de hierro encima, revoco almagra, alero sobre canecillos y cubierta de teja (modelo del taller, en revisión)"
  folder "Taller · Edificios"

type_params
  section "Dimensiones"
    width length = 12.00 range 6.00..24.00 label "Fachada"
    depth length = 12.00 range 8.00..20.00 label "Fondo"
    floors integer = 3 range 2..4 label "Plantas (con la baja)"
    variant integer = 1 range 0..99 label "Variante"
  section "Materiales"
    wall material = "Estuco almagra" label "Fachada"
    party material = "Estuco almagra" label "Medianeras"
    trim material = "Cal blanca" label "Recercados"
    stone material = "Piedra caliza" label "Columnas y balcones"
    plinth material = "Piedra caliza" label "Imposta"
    wood material = "Nogal" label "Zapatas, carreras, balcón y puertas"
    frame material = "Nogal" label "Carpintería"
    iron material = "Hierro forjado" label "Barandillas"
    sign material = "Rótulo granate" label "Rótulos"
    shutter material = "Acero gris" label "Cierres"
    paving material = "Empedrado" label "Suelo del soportal"
    tiles material = "Teja curva" label "Tejas"
    roof material = "Terracota" label "Faldones"
    glass material = "Vidrio claro" label "Vidrio"
    interior material = "Interior en sombra" label "Interior visto por los huecos"
    brass material = "Latón" label "Herrajes"
    curtain material = "Visillo" label "Visillos"
    pot material = "Terracota" label "Macetas"
    leaves material = "Hoja verde" label "Plantas"
    flowers material = "Buganvilla" label "Flores"

body
  box (-(width) / 2, 0, 0) to ((width) / 2, depth, 3.6 + 3.0 * (floors - 1) + 3) material wall

plan 1:50
  polygon (-(width) / 2, 0) ((width) / 2, 0) ((width) / 2, depth) (-(width) / 2, depth) pen view

outputs
  generator = "props:fine_castilian_arcade"
  ifc_class = "IfcBuildingElementProxy"
  ifc_type = "USERDEFINED"
