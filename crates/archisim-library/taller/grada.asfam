family "Grada (taller)"
  category furniture
  host none
  version 1
  description "Grada de hormigón por filas con un asiento cada medio metro y barandilla atrás; la primera fila delante (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Dimensiones"
    length length = 6.00 range 2.00..30.00 label "Largo"
    rows   integer = 4 range 1..10 label "Filas"
  section "Materiales"
    mass    material = "Hormigón pulido" label "Gradas"
    seat    material = "Plástico azul" label "Asientos"
    metal   material = "Acero galvanizado" label "Barandilla"

body
  box (-length / 2, 0, 0) to (length / 2, rows * 0.8, rows * 0.42 + 1.1) material mass

plan 1:50
  polygon (-length / 2, 0) (length / 2, 0) (length / 2, rows * 0.8) (-length / 2, rows * 0.8) pen view

outputs
  generator = "props:fine_grandstand"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
