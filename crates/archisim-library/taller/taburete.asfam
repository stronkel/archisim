family "Taburete (taller)"
  category furniture
  host none
  version 1
  description "Taburete por colecciones, bajo o alto de barra (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Dimensiones"
    width  length = 0.36 range 0.25..1.00 label "Ancho del asiento"
    height length = 0.65 range 0.25..0.85 label "Altura del asiento"
  section "Materiales"
    frame   material = "Roble claro" label "Madera"
    mat     material = "Lino arena" label "Tapicería"
    weave   material = "Enea" label "Enea"
    metal   material = "Metal negro" label "Metal"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

body
  box (-width / 2, 0, 0) to (width / 2, width, height) material frame

plan 1:50
  let r = width / 2
  repeat i in 0..16
    let t0 = 6.283185307 * i / 16
    let t1 = 6.283185307 * (i + 1) / 16
    line (r * cos(t0), r + r * sin(t0)) to (r * cos(t1), r + r * sin(t1)) pen view

outputs
  generator = "props:fine_stool"
  ifc_class = "IfcFurniture"
  ifc_type = "CHAIR"
