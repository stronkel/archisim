family "Lavabo (taller)"
  category sanitary
  host none
  version 1
  description "Lavabo como lo hace cada colección: mueble suspendido, de obra, balda, tablón, pedestal, bastidor o tocador, con su grifo (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Dimensiones"
    width  length = 0.60 range 0.40..2.00 label "Ancho"
    depth  length = 0.45 range 0.35..0.60 label "Fondo"
    height length = 0.85 range 0.70..1.00 label "Altura"
  section "Materiales"
    mat material = "Cerámica blanca" label "Porcelana"
    unit material = "Roble claro" label "Mueble u obra"
    top material = "Piedra caliza" label "Encimera o piedra"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Colección"
    metal material = "Acero inoxidable" label "Grifería y metal"
    seat material = "Lacado blanco" label "Asiento"
    glass material = "Vidrio claro" label "Vidrio y espejo"
    frame material = "Roble claro" label "Marco"
    wood material = "Roble claro" label "Madera"
    towel material = "Toalla blanca" label "Toallas y cortina"
    dark material = "Cuero coñac" label "Sombras y cuero"
    light material = "Cristal esmerilado" label "Luz"

body
  box (-width / 2, 0, height - 0.15) to (width / 2, depth, height) material mat

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view
  let a = min(width / 2 - 0.06, 0.24)
  let b = depth / 2 - 0.06
  let c = depth / 2 + 0.02
  repeat i in 0..24
    let t0 = 6.283185307 * i / 24
    let t1 = 6.283185307 * (i + 1) / 24
    line (a * cos(t0), c + b * sin(t0)) to (a * cos(t1), c + b * sin(t1)) pen thin

outputs
  generator = "props:washbasin"
  ifc_class = "IfcSanitaryTerminal"
  ifc_type = "WASHHANDBASIN"
