family "Chimenea (taller)"
  category furniture
  host none
  version 1
  description "Chimeneas y estufas por colecciones (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Dimensiones"
    width  length = 1.40 range 0.50..4.00 label "Ancho"
    depth  length = 0.40 range 0.20..1.00 label "Fondo"
    height length = 2.50 range 0.60..3.50 label "Altura (hasta el techo o el tiro)"
    fire   bool = yes label "Con fuego"
  section "Materiales"
    mat    material = "Enlucido de yeso" label "Revestimiento"
    stone  material = "Piedra gris" label "Piedra"
    frame  material = "Roble claro" label "Madera"
    metal  material = "Metal negro" label "Metal"
    dark   material = "Negro mate" label "Hogar"
    glass  material = "Vidrio claro" label "Vidrio"
    logs   material = "Corteza de pino" label "Leña"
    flame  material = "Luz" label "Fuego"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

body
  box (-width / 2, 0, 0) to (width / 2, depth, height) material mat

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view

outputs
  generator = "props:fine_fireplace"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
