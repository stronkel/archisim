family "Estación de calistenia (taller)"
  category furniture
  host none
  version 1
  description "Barras de dominadas a tres alturas, escalera horizontal, paralelas y barras de flexiones sobre pavimento de caucho (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Materiales"
    frame   material = "Pintura verde" label "Postes"
    metal   material = "Acero inoxidable" label "Barras"
    accent  material = "Pintura amarilla" label "Remates"
    ground  material = "Caucho de seguridad" label "Pavimento"

body
  box (-3.4, 0, 0) to (3.8, 2.4, 2.75) material frame

plan 1:50
  polygon (-3.4, 0) (3.8, 0) (3.8, 2.4) (-3.4, 2.4) pen view
  line (-3.1, 0.5) to (-0.1, 0.5) pen view
  polygon (0.5, 0.2) (3.5, 0.2) (3.5, 0.8) (0.5, 0.8) pen thin
  polygon (-3.0, 1.55) (-1.0, 1.55) (-1.0, 2.05) (-3.0, 2.05) pen thin

outputs
  generator = "props:fine_calisthenics"
  ifc_class = "IfcBuildingElementProxy"
  ifc_type = "USERDEFINED"
