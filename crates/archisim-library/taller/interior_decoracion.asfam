family "Decoración (taller)"
  category furniture
  host none
  version 1
  description "Cosas para mesas y baldas como las pone cada colección; súbelas con el desfase de la base (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Dimensiones"
    width  length = 0.40 range 0.20..1.00 label "Ancho"
    height length = 0.45 range 0.15..1.20 label "Altura de la pieza más alta"
  section "Materiales"
    mat     material = "Cerámica blanca" label "Pieza principal"
    glaze2  material = "Cerámica esmaltada" label "Piezas pequeñas"
    frame   material = "Roble claro" label "Madera"
    metal   material = "Latón" label "Metal"
    glass   material = "Vidrio claro" label "Vidrio"
    books   material = "Libro crema" label "Páginas y libros"
    books2  material = "Libro azul" label "Libro"
    books3  material = "Libro teja" label "Otro libro"
    candle  material = "Cera" label "Vela"
    flame   material = "Llama" label "Llama"
    fruit   material = "Limón" label "Fruta"
    fruit2  material = "Manzana verde" label "Otra fruta"
    leaves  material = "Hoja verde" label "Hojas"
    stem    material = "Corteza de pino" label "Ramas"
    flowers material = "Pétalo blanco" label "Flores"
    dark    material = "Metal negro" label "Mecha y detalles"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Colección"

body
  box (-width / 2, 0, 0) to (width / 2, width * 0.55, height * 0.6) material mat

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, width * 0.55) (-width / 2, width * 0.55) pen thin

outputs
  generator = "props:decor"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
