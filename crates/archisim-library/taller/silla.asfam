family "Silla (taller)"
  category furniture
  host none
  version 1
  description "Silla por colecciones: nórdica de roble, andaluza de enea, carcasa años 50, japandi de cuerda, contemporánea de tubo, rústica de tablillas, industrial de chapa y Luis XVI de medallón (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Dimensiones"
    width  length = 0.46 range 0.38..0.65 label "Ancho"
    depth  length = 0.52 range 0.40..0.65 label "Fondo"
    seat   length = 0.45 range 0.38..0.50 label "Altura del asiento"
    height length = 0.82 range 0.65..1.10 label "Altura del respaldo"
  section "Materiales"
    frame   material = "Roble claro" label "Madera"
    mat     material = "Lino arena" label "Tapicería"
    weave   material = "Enea" label "Enea o cuerda"
    metal   material = "Metal negro" label "Metal"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Modelo 3D"

require seat + 0.2 < height else "El respaldo tiene que subir por encima del asiento"

body
  box (-width / 2, 0, seat - 0.04) to (width / 2, depth, seat) material frame
  box (-width / 2, 0, seat) to (width / 2, 0.04, height) material frame

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view
  line (-width / 2, 0.04) to (width / 2, 0.04) pen thin

outputs
  generator = "props:fine_chair"
  ifc_class = "IfcFurniture"
  ifc_type = "CHAIR"
