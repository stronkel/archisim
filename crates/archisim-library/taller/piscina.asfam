family "Piscina (taller)"
  category furniture
  host none
  version 1
  description "Piscina como objeto, como la hace cada colección: vaso revestido bajo el suelo, agua, coronación, playa alrededor, escalerilla y focos; la de los años 50 en forma de riñón y la clásica con un extremo en medio punto (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Dimensiones"
    length length = 8.00 range 2.00..25.00 label "Largo de la lámina de agua"
    width  length = 4.00 range 1.50..12.00 label "Ancho de la lámina de agua"
    water_depth length = 1.40 range 0.40..2.50 label "Profundidad del agua"
    deck_width length = 1.00 range 0.00..4.00 label "Ancho de la playa"
  section "Forma"
    form choice("Rectangular", "Con escalera romana", "Desbordante") = "Rectangular" label "Forma"
  section "Materiales"
    lining  material = "Gresite blanco" label "Revestimiento del vaso"
    shell   material = "Hormigón pulido" label "Vaso de hormigón"
    water   material = "Agua de fuente" label "Agua"
    coping  material = "Piedra caliza" label "Coronación"
    deck    material = "Teca" label "Playa"
    accent  material = "Gresite azul" label "Cenefa en la línea de agua"
    metal   material = "Acero inoxidable" label "Escalerilla"
    dark    material = "Metal negro" label "Rejilla de rebosadero"
    light   material = "Luz de piscina" label "Focos"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Colección"

body
  box (-length / 2 - 0.32 - deck_width, 0, 0) to (length / 2 + 0.32 + deck_width, width + 0.64 + 2 * deck_width, 0.05) material coping

plan 1:50
  let m = 0.32 + deck_width
  polygon (-length / 2, m) (length / 2, m) (length / 2, m + width) (-length / 2, m + width) pen view
  polygon (-length / 2 - 0.32, m - 0.32) (length / 2 + 0.32, m - 0.32) (length / 2 + 0.32, m + width + 0.32) (-length / 2 - 0.32, m + width + 0.32) pen thin
  polygon (-length / 2 - m, 0) (length / 2 + m, 0) (length / 2 + m, width + 2 * m) (-length / 2 - m, width + 2 * m) pen thin

outputs
  generator = "props:fine_pool"
  ifc_class = "IfcBuildingElementProxy"
  ifc_type = "USERDEFINED"
