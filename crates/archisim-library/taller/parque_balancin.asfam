family "Balancín (taller)"
  category furniture
  host none
  version 1
  description "Balancín de dos plazas con asideros y topes de goma (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Materiales"
    frame   material = "Roble claro" label "Viga y pie"
    seat    material = "Plástico rojo" label "Asientos"
    metal   material = "Acero inoxidable" label "Asideros y eje"
    dark    material = "Goma negra" label "Base y topes"

body
  box (-1.65, 0, 0) to (1.65, 0.6, 1.1) material frame

plan 1:50
  polygon (-1.6, 0.19) (1.6, 0.19) (1.6, 0.41) (-1.6, 0.41) pen view
  polygon (-0.3, 0.05) (0.3, 0.05) (0.3, 0.55) (-0.3, 0.55) pen thin

outputs
  generator = "props:fine_seesaw"
  ifc_class = "IfcBuildingElementProxy"
  ifc_type = "USERDEFINED"
