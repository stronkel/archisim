family "Silla de trabajo (taller)"
  category furniture
  host none
  version 1
  description "Silla para el escritorio como la hace cada colección (modelo del taller, en revisión)"
  folder "Taller"

type_params
  section "Dimensiones"
    width length = 0.62 range 0.45..0.80 label "Ancho"
    seat  length = 0.47 range 0.38..0.56 label "Altura del asiento"
  section "Materiales"
    frame   material = "Roble claro" label "Madera o estructura"
    cushion material = "Lino arena" label "Tapizado"
    metal   material = "Metal negro" label "Metal"
    dark    material = "Metal negro" label "Base y patas"
    accent  material = "Terciopelo mostaza" label "Carcasa de color"
    weave   material = "Enea" label "Asiento de enea o cuerda"
    mesh    material = "Lana carbón" label "Malla"
  section "Modelo 3D"
    model3d choice("Nórdico cálido", "Mediterráneo", "Años 50", "Japandi", "Contemporáneo", "Rústica", "Industrial", "Clásica") = "Nórdico cálido" label "Colección"

body
  box (-width / 2, 0, 0) to (width / 2, width, seat + 0.4) material cushion

plan 1:50
  let r = width / 2
  repeat i in 0..16
    let t0 = 6.283185307 * i / 16
    let t1 = 6.283185307 * (i + 1) / 16
    line (r * cos(t0), width / 2 + r * sin(t0)) to (r * cos(t1), width / 2 + r * sin(t1)) pen view

outputs
  generator = "props:office_chair"
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
