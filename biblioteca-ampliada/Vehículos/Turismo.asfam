family "Turismo"
  category vehicle
  host none
  version 3
  description "Coche de turismo; el punto de inserción es el centro de la trasera y mira hacia delante"
  folder "Turismos"

type_params
  section "Dimensiones"
    length length = 4.40 range 2.50..6.00 label "Largo"
    width  length = 1.80 range 1.40..2.40 label "Ancho"
    height length = 1.45 range 1.10..2.20 label "Altura"
  section "Materiales"
    body_mat material = "Carrocería" label "Carrocería"
    tyre     material = "Neumático" label "Ruedas"

body
  let w = width / 2
  let wheel = 0.64
  box (-w, 0, 0.18) to (w, length, 0.80) material body_mat
  box (-w + 0.1, 0.24 * length, 0.80) to (w - 0.1, 0.80 * length, height) material body_mat
  repeat i in 0..2
    let y0 = if i == 0 then 0.14 * length else 0.74 * length
    box (-w + 0.02, y0, 0) to (-w + 0.24, y0 + wheel, wheel) material tyre
    box (w - 0.24, y0, 0) to (w - 0.02, y0 + wheel, wheel) material tyre

plan 1:50
  let w = width / 2
  let c = 0.25
  polygon (-w + c, 0) (w - c, 0) (w, c) (w, length - c * 1.6) (w - c * 1.3, length) (-w + c * 1.3, length) (-w, length - c * 1.6) (-w, c) pen view
  polygon (-w + 0.12, 0.24 * length) (w - 0.12, 0.24 * length) (w - 0.12, 0.80 * length) (-w + 0.12, 0.80 * length) pen thin
  line (-w + 0.12, 0.66 * length) to (w - 0.12, 0.66 * length) pen thin
  line (-w + 0.12, 0.32 * length) to (w - 0.12, 0.32 * length) pen thin

plan presentation
  # The body filled in its colour, the glass lighter, as a presentation
  # plan shows cars: for scale, without detail.
  let w = width / 2
  let c = 0.25
  polygon (-w + c, 0) (w - c, 0) (w, c) (w, length - c * 1.6) (w - c * 1.3, length) (-w + c * 1.3, length) (-w, length - c * 1.6) (-w, c) pen thin tint body_mat
  polygon (-w + 0.12, 0.24 * length) (w - 0.12, 0.24 * length) (w - 0.12, 0.80 * length) (-w + 0.12, 0.80 * length) pen thin filled
  polygon (-w + 0.2, 0.36 * length) (w - 0.2, 0.36 * length) (w - 0.2, 0.62 * length) (-w + 0.2, 0.62 * length) pen thin tint body_mat opacity 0.6

outputs
  ifc_class = "IfcVehicle"
  ifc_type = "VEHICLEWHEELED"
catalog
  material "Carrocería azul" category "other" color 70 96 140
  material "Neumático" category "rubber" color 52 52 56
  material "Carrocería roja" category "other" color 170 64 58
  material "Carrocería blanca" category "other" color 232 232 228
  type "Monovolumen" guid "2FuR2nY_Z1BLUGY5aN51rI"
    length = 4.7
    width = 1.9
    height = 1.75
    body_mat = "Carrocería azul"
    tyre = "Neumático"
  type "Utilitario" guid "0eBKqU$R8o8XbMfYZzTD2B"
    length = 3.8
    width = 1.7
    height = 1.5
    body_mat = "Carrocería roja"
    tyre = "Neumático"
  type "Coche blanco" guid "2A8qfr3X8QQyxZJNlb6132"
    length = 4.4
    width = 1.8
    height = 1.45
    body_mat = "Carrocería blanca"
    tyre = "Neumático"
  type "Camión pequeño" guid "3yJ1E$ZA3QLCdjkdZSyhCA"
    length = 6
    width = 2.2
    height = 2.2
    body_mat = "Carrocería blanca"
    tyre = "Neumático"
