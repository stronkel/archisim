family "Buzón"
  category street
  host none
  version 1
  description "Buzón de calle sobre su pie; el punto de inserción es el centro de la trasera y la boca mira hacia delante"
  folder "Mobiliario urbano"

type_params
  section "Dimensiones"
    width  length = 0.45 range 0.25..1.20 label "Ancho"
    depth  length = 0.35 range 0.20..0.80 label "Fondo"
    height length = 1.10 range 0.50..1.80 label "Altura"
  section "Materiales"
    mat material = "Metal lacado" label "Buzón"

body
  box (-0.04, depth / 2 - 0.04, 0) to (0.04, depth / 2 + 0.04, height * 0.45) material mat
  box (-width / 2, 0, height * 0.45) to (width / 2, depth, height) material mat

plan 1:50
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen view
  line (-width * 0.3, depth - 0.04) to (width * 0.3, depth - 0.04) pen thin

plan presentation
  polygon (-width / 2, 0) (width / 2, 0) (width / 2, depth) (-width / 2, depth) pen thin tint mat
  line (-width * 0.3, depth - 0.04) to (width * 0.3, depth - 0.04) pen thin

outputs
  ifc_class = "IfcFurniture"
  ifc_type = "USERDEFINED"
catalog
  material "Metal lacado" category "metal" color 86 92 100
  type "Buzón grande" guid "27gQsevNXM4epeQZtlvPYJ"
    width = 0.6
    depth = 0.45
    height = 1.3
    mat = "Metal lacado"
