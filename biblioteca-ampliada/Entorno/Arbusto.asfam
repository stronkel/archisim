family "Arbusto"
  category site
  host none
  version 3
  description "Arbusto o mata redondeada; el punto de inserción es su centro"
  folder "Vegetación"

type_params
  section "Dimensiones"
    width  length = 1.20 range 0.20..6.00 label "Diámetro"
    height length = 1.00 range 0.20..4.00 label "Altura"
  section "Materiales"
    leaves material = "Vegetación" label "Follaje"
  section "Presentación"
    look choice("transparente", "rellena", "contorno") = "rellena" label "Follaje en presentación"

body
  let r = width / 2
  repeat i in 0..4
    let m = (i + 0.5) / 4
    let a = r * sqrt(1 - m * m * 0.85)
    let b = a * 0.6
    let z0 = height * i / 4
    let z1 = height * (i + 1) / 4
    box (-a, -b, z0) to (a, b, z1) material leaves
    box (-b, -a, z0) to (b, -b, z1) material leaves
    box (-b, b, z0) to (b, a, z1) material leaves

plan 1:50
  let r = width / 2
  repeat i in 0..24
    let t0 = 6.283185307 * i / 24
    let t1 = 6.283185307 * (i + 1) / 24
    let k0 = if floor(i / 2) * 2 == i then 1 else 0.88
    let k1 = if floor(i / 2) * 2 == i then 0.88 else 1
    line (r * k0 * cos(t0), r * k0 * sin(t0)) to (r * k1 * cos(t1), r * k1 * sin(t1)) pen view
  line (-r * 0.2, 0) to (r * 0.2, 0) pen thin
  line (0, -r * 0.2) to (0, r * 0.2) pen thin

plan presentation
  let r = width / 2
  let op = if look == "rellena" then 1 else 0.6
  if look == "contorno"
    cloud center (0, 0) radius r lobes 7 jitter 0.2 pen view
  else
    cloud center (0, 0) radius r lobes 7 jitter 0.2 pen thin tint leaves opacity op
    cloud center (-r * 0.15, r * 0.15) radius r * 0.45 lobes 5 jitter 0.15 pen thin tint leaves opacity 0.35

outputs
  ifc_class = "IfcGeographicElement"
  ifc_type = "VEGETATION"
catalog
  material "Follaje de adelfa" category "vegetation" color 96 140 88
  material "Follaje de lentisco" category "vegetation" color 80 116 72
  material "Follaje de romero" category "vegetation" color 120 146 120
  material "Follaje de lavanda" category "vegetation" color 158 140 196
  material "Follaje de pitosporo" category "vegetation" color 88 132 84
  material "Follaje de boj" category "vegetation" color 70 112 66
  material "Follaje de hibisco" category "vegetation" color 208 96 110
  material "Follaje de buganvilla" category "vegetation" color 200 80 150
  material "Follaje de agapanto" category "vegetation" color 120 150 200
  material "Follaje de gramínea ornamental" category "vegetation" color 196 186 128
  material "Follaje de aloe" category "vegetation" color 128 160 136
  material "Follaje de pita" category "vegetation" color 140 170 150
  material "Follaje de jazmín" category "vegetation" color 150 186 124
  material "Follaje de arbusto grande" category "vegetation" color 100 140 90
